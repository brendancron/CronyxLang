/**
 * TOML.
 *
 * ```
 * import { Encode, Decode } from "std/encoding/Codec";
 * import { to_toml, from_toml } from "std/encoding/Toml";
 *
 * type Package { name: string, version: string }
 * type Manifest { package: Package, features: List<string> }
 * derive Encode, Decode for Package;
 * derive Encode, Decode for Manifest;
 *
 * var m: Manifest = from_toml("features = [\"a\"]\n[package]\nname = \"demo\"\nversion = \"0.1.0\"\n");
 * print(to_toml(m));
 * ```
 *
 * Tables, arrays of tables, inline tables, dotted and quoted keys, arrays,
 * basic and literal strings (multi-line too), integers, floats and booleans.
 * Dates and times are not read. TOML has no null, so a null is left out when
 * written, which is how a missing `Option` reads back.
 */

import { Throw } from "../core/Error";
import { join } from "../collections/List";
import { Data, Entry, Encode, Decode, DecodeError, Format, Decoder } from "Codec";

/** TOML as a `Format`. */
type Toml;

impl Format for Toml {
    fn write(self, data: Data): string { return write_toml(data); }
    fn read(self, text: string): <Throw<DecodeError>> Data { return parse_toml(text); }
}

/** The value as a TOML document. Panics unless it encodes as a map, since a document is a table. */
fn to_toml<T: Encode>(value: T): string { return write_toml(value.encode()); }

/** A value read from a TOML document. */
fn from_toml<T: Decode>(text: string): <Throw<DecodeError>> T {
    return T.decode(Decoder.of(parse_toml(text)));
}

/** The data as a TOML document. Panics unless it is a map. */
fn write_toml(data: Data): string {
    match data {
        Data.Map(entries) => {
            var out: List<string> = [];
            __write_table(out, "", entries);
            return join(out, "");
        }
        _ => {}
    }
    panic("A TOML document is a table, so only a map can be written as one, not " + data.kind() + ".");
    return "";
}

/** The data a TOML document holds, as a map. Throws where the text is not TOML. */
fn parse_toml(text: string): <Throw<DecodeError>> Data {
    var reader = __Reader { chars: text.chars(), at: 0 };
    var root: List<Entry> = [];
    var current = root;
    while (true) {
        reader.blank_lines();
        if (reader.done()) { return Data.Map(root); }
        if (reader.peek() == '[') {
            reader.at += 1;
            var many = false;
            if (reader.peek() == '[') {
                reader.at += 1;
                many = true;
            }
            reader.inline_space();
            var path = reader.key();
            reader.inline_space();
            reader.expect(']');
            if (many) { reader.expect(']'); }
            reader.line_end();
            if (many) {
                var parent = __table_at(reader, root, path[0:path.len() - 1]);
                var last = path[path.len() - 1];
                var made: List<Entry> = [];
                match __find(parent, last) {
                    Option.Some(e) => {
                        match e.value {
                            Data.Seq(items) => { items.push(Data.Map(made)); }
                            _ => { return throw(reader.unexpected()); }
                        }
                    }
                    Option.None => { parent.push(Entry { key: last, value: Data.Seq([Data.Map(made)]) }); }
                }
                current = made;
            } else {
                current = __table_at(reader, root, path);
            }
        } else {
            var path = reader.key();
            reader.inline_space();
            reader.expect('=');
            reader.inline_space();
            var value = reader.value();
            reader.line_end();
            var into = __table_at(reader, current, path[0:path.len() - 1]);
            var last = path[path.len() - 1];
            match __find(into, last) {
                Option.Some(_) => { return throw(DecodeError.Duplicate(__dotted(path))); }
                Option.None => { into.push(Entry { key: last, value: value }); }
            }
        }
    }
    return Data.Map(root);
}

fn __dotted(path: Array<string>): string {
    var out = "";
    for (key in path) {
        if (out != "") { out = out + "."; }
        out = out + key;
    }
    return out;
}

fn __find(entries: List<Entry>, key: string): Option<Entry> {
    for (e in entries) {
        if (e.key == key) { return Option.Some(e); }
    }
    return Option.None;
}

// The table a dotted path names, made where it is missing. A path through an
// array of tables goes into its last table, as a `[a.b]` after `[[a]]` does.
fn __table_at(reader: __Reader, from: List<Entry>, path: Array<string>): <Throw<DecodeError>> List<Entry> {
    var here = from;
    for (key in path) {
        var next: List<Entry> = [];
        match __find(here, key) {
            Option.Some(e) => {
                match e.value {
                    Data.Map(entries) => { next = entries; }
                    Data.Seq(items) => {
                        if (items.len() == 0) { return throw(reader.unexpected()); }
                        match items[items.len() - 1] {
                            Data.Map(entries) => { next = entries; }
                            _ => { return throw(reader.unexpected()); }
                        }
                    }
                    _ => { return throw(reader.unexpected()); }
                }
            }
            Option.None => { here.push(Entry { key: key, value: Data.Map(next) }); }
        }
        here = next;
    }
    return here;
}

fn __write_table(out: List<string>, path: string, entries: List<Entry>) {
    for (e in entries) {
        if (!__is_table(e.value) && !__is_tables(e.value)) {
            match e.value {
                Data.Null => {}
                _ => { out.push(__key(e.key) + " = " + __inline(e.value) + "\n"); }
            }
        }
    }
    for (e in entries) {
        var inner = __joined(path, e.key);
        match e.value {
            Data.Map(sub) => {
                if (__has_values(sub) || sub.len() == 0) { out.push("\n[" + inner + "]\n"); }
                __write_table(out, inner, sub);
            }
            Data.Seq(items) => {
                if (__is_tables(e.value)) {
                    for (item in items) {
                        match item {
                            Data.Map(sub) => {
                                out.push("\n[[" + inner + "]]\n");
                                __write_table(out, inner, sub);
                            }
                            _ => {}
                        }
                    }
                }
            }
            _ => {}
        }
    }
}

// A table holding only tables is reached through their headers alone.
fn __has_values(entries: List<Entry>): bool {
    for (e in entries) {
        match e.value {
            Data.Null => {}
            Data.Map(_) => {}
            _ => { if (!__is_tables(e.value)) { return true; } }
        }
    }
    return false;
}

fn __is_table(data: Data): bool {
    match data {
        Data.Map(_) => { return true; }
        _ => {}
    }
    return false;
}

fn __is_tables(data: Data): bool {
    match data {
        Data.Seq(items) => {
            if (items.len() == 0) { return false; }
            for (item in items) { if (!__is_table(item)) { return false; } }
            return true;
        }
        _ => {}
    }
    return false;
}

fn __joined(path: string, key: string): string {
    if (path == "") { return __key(key); }
    return path + "." + __key(key);
}

fn __key(key: string): string {
    if (key == "") { return "\"\""; }
    for (c in key.chars()) {
        if (!__bare(c)) { return __quoted(key); }
    }
    return key;
}

fn __bare(c: char): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
}

fn __inline(data: Data): string {
    match data {
        Data.Null => { return "\"\""; }
        Data.Bool(b) => { return str(b); }
        Data.Int(n) => { return str(n); }
        Data.Float(f) => {
            var text = str(f);
            if (text.contains("e") || text.contains(".") || text.contains("n")) { return text; }
            return text + ".0";
        }
        Data.Str(s) => { return __quoted(s); }
        Data.Seq(items) => {
            var parts: List<string> = [];
            for (item in items) {
                match item {
                    Data.Null => {}
                    _ => { parts.push(__inline(item)); }
                }
            }
            return "[" + join(parts, ", ") + "]";
        }
        Data.Map(entries) => {
            var parts: List<string> = [];
            for (e in entries) {
                match e.value {
                    Data.Null => {}
                    _ => { parts.push(__key(e.key) + " = " + __inline(e.value)); }
                }
            }
            if (parts.len() == 0) { return "{}"; }
            return "{ " + join(parts, ", ") + " }";
        }
    }
    return "";
}

fn __quoted(text: string): string {
    var out = "\"";
    for (c in text.chars()) {
        if (c == '"') { out = out + "\\\""; }
        else if (c == '\\') { out = out + "\\\\"; }
        else if (c == '\n') { out = out + "\\n"; }
        else if (c == '\r') { out = out + "\\r"; }
        else if (c == '\t') { out = out + "\\t"; }
        else { out = out + str(c); }
    }
    return out + "\"";
}

type __Reader {
    chars: Array<char>,
    at: int
}

impl __Reader {
    fn done(self): bool { return self.at >= self.chars.len(); }

    fn unexpected(self): DecodeError {
        if (self.done()) { return DecodeError.Truncated(self.chars.len()); }
        return DecodeError.Unexpected(self.at, self.chars[self.at]);
    }

    fn peek(self): <Throw<DecodeError>> char {
        if (self.done()) { return throw(self.unexpected()); }
        return self.chars[self.at];
    }

    fn expect(self, c: char): <Throw<DecodeError>> unit {
        if (self.peek() != c) { throw(self.unexpected()); }
        self.at += 1;
    }

    fn starts(self, text: string): bool {
        var cs = text.chars();
        if (self.at + cs.len() > self.chars.len()) { return false; }
        for (var i = 0; i < cs.len(); i += 1) {
            if (self.chars[self.at + i] != cs[i]) { return false; }
        }
        return true;
    }

    fn inline_space(self) {
        while (!self.done() && (self.chars[self.at] == ' ' || self.chars[self.at] == '\t')) { self.at += 1; }
    }

    fn comment(self) {
        if (!self.done() && self.chars[self.at] == '#') {
            while (!self.done() && self.chars[self.at] != '\n') { self.at += 1; }
        }
    }

    // Spaces, comments and newlines, as between statements or array items.
    fn blank_lines(self) {
        while (true) {
            self.inline_space();
            self.comment();
            if (self.done()) { return; }
            var c = self.chars[self.at];
            if (c == '\n' || c == '\r') { self.at += 1; } else { return; }
        }
    }

    fn line_end(self): <Throw<DecodeError>> unit {
        self.inline_space();
        self.comment();
        if (self.done()) { return; }
        if (self.chars[self.at] == '\r') { self.at += 1; }
        self.expect('\n');
    }

    fn key(self): <Throw<DecodeError>> Array<string> {
        var parts: List<string> = [];
        while (true) {
            self.inline_space();
            var c = self.peek();
            if (c == '"') { parts.push(self.basic()); }
            else if (c == '\'') { parts.push(self.literal()); }
            else {
                var bare = "";
                while (!self.done() && __bare(self.chars[self.at])) {
                    bare = bare + str(self.chars[self.at]);
                    self.at += 1;
                }
                if (bare == "") { return throw(self.unexpected()); }
                parts.push(bare);
            }
            self.inline_space();
            if (!self.done() && self.chars[self.at] == '.') { self.at += 1; } else {
                return parts.items[0:parts.len()];
            }
        }
        return parts.items[0:parts.len()];
    }

    fn value(self): <Throw<DecodeError>> Data {
        var c = self.peek();
        if (c == '"') {
            if (self.starts("\"\"\"")) { return Data.Str(self.multiline_basic()); }
            return Data.Str(self.basic());
        }
        if (c == '\'') {
            if (self.starts("'''")) { return Data.Str(self.multiline_literal()); }
            return Data.Str(self.literal());
        }
        if (c == '[') { return self.array(); }
        if (c == '{') { return self.table(); }
        if (self.starts("true")) {
            self.at += 4;
            return Data.Bool(true);
        }
        if (self.starts("false")) {
            self.at += 5;
            return Data.Bool(false);
        }
        return self.number();
    }

    fn array(self): <Throw<DecodeError>> Data {
        self.expect('[');
        var items: List<Data> = [];
        while (true) {
            self.blank_lines();
            if (self.peek() == ']') {
                self.at += 1;
                return Data.Seq(items);
            }
            items.push(self.value());
            self.blank_lines();
            if (self.peek() == ',') { self.at += 1; } else {
                self.expect(']');
                return Data.Seq(items);
            }
        }
        return Data.Seq(items);
    }

    fn table(self): <Throw<DecodeError>> Data {
        self.expect('{');
        var entries: List<Entry> = [];
        self.inline_space();
        if (self.peek() == '}') {
            self.at += 1;
            return Data.Map(entries);
        }
        while (true) {
            self.inline_space();
            var path = self.key();
            self.inline_space();
            self.expect('=');
            self.inline_space();
            var value = self.value();
            var into = __table_at(self, entries, path[0:path.len() - 1]);
            match __find(into, path[path.len() - 1]) {
                Option.Some(_) => { return throw(DecodeError.Duplicate(__dotted(path))); }
                Option.None => { into.push(Entry { key: path[path.len() - 1], value: value }); }
            }
            self.inline_space();
            if (self.peek() == ',') { self.at += 1; } else {
                self.expect('}');
                return Data.Map(entries);
            }
        }
        return Data.Map(entries);
    }

    fn escape(self): <Throw<DecodeError>> string {
        var e = self.peek();
        self.at += 1;
        if (e == 'n') { return "\n"; }
        if (e == 't') { return "\t"; }
        if (e == 'r') { return "\r"; }
        if (e == 'b') { return str(chr(8)); }
        if (e == 'f') { return str(chr(12)); }
        if (e == '"' || e == '\\') { return str(e); }
        if (e == 'u') { return str(chr(self.hex(4))); }
        if (e == 'U') { return str(chr(self.hex(8))); }
        self.at -= 1;
        return throw(self.unexpected());
    }

    fn hex(self, count: int): <Throw<DecodeError>> int {
        var point = 0;
        for (var i = 0; i < count; i += 1) {
            var c = self.peek();
            var digit = -1;
            if (c >= '0' && c <= '9') { digit = ord(c) - ord('0'); }
            else if (c >= 'a' && c <= 'f') { digit = ord(c) - ord('a') + 10; }
            else if (c >= 'A' && c <= 'F') { digit = ord(c) - ord('A') + 10; }
            if (digit < 0) { return throw(self.unexpected()); }
            point = point * 16 + digit;
            self.at += 1;
        }
        return point;
    }

    fn basic(self): <Throw<DecodeError>> string {
        self.expect('"');
        var out = "";
        while (true) {
            var c = self.peek();
            if (c == '\n') { return throw(self.unexpected()); }
            self.at += 1;
            if (c == '"') { return out; }
            if (c == '\\') { out = out + self.escape(); } else { out = out + str(c); }
        }
        return out;
    }

    fn literal(self): <Throw<DecodeError>> string {
        self.expect('\'');
        var out = "";
        while (true) {
            var c = self.peek();
            if (c == '\n') { return throw(self.unexpected()); }
            self.at += 1;
            if (c == '\'') { return out; }
            out = out + str(c);
        }
        return out;
    }

    // A newline straight after the opening quotes is not part of the string.
    fn skip_first_newline(self) {
        if (self.starts("\r\n")) { self.at += 2; }
        else if (self.starts("\n")) { self.at += 1; }
    }

    fn multiline_basic(self): <Throw<DecodeError>> string {
        self.at += 3;
        self.skip_first_newline();
        var out = "";
        while (true) {
            if (self.starts("\"\"\"")) {
                self.at += 3;
                return out;
            }
            var c = self.peek();
            self.at += 1;
            if (c == '\\') {
                // A backslash ending a line joins it to the next, without the whitespace between.
                var n = self.peek();
                if (n == '\n' || n == '\r' || n == ' ' || n == '\t') {
                    while (!self.done() && (self.chars[self.at] == ' ' || self.chars[self.at] == '\t' || self.chars[self.at] == '\n' || self.chars[self.at] == '\r')) {
                        self.at += 1;
                    }
                } else {
                    out = out + self.escape();
                }
            } else {
                out = out + str(c);
            }
        }
        return out;
    }

    fn multiline_literal(self): <Throw<DecodeError>> string {
        self.at += 3;
        self.skip_first_newline();
        var out = "";
        while (true) {
            if (self.starts("'''")) {
                self.at += 3;
                return out;
            }
            out = out + str(self.peek());
            self.at += 1;
        }
        return out;
    }

    fn number(self): <Throw<DecodeError>> Data {
        var start = self.at;
        var text = "";
        while (!self.done()) {
            var c = self.chars[self.at];
            if ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '+' || c == '-' || c == '.' || c == '_') {
                if (c != '_') { text = text + str(c); }
                self.at += 1;
            } else {
                break;
            }
        }
        if (text == "") { return throw(self.unexpected()); }
        if (text == "inf" || text == "+inf") { return Data.Float(1.0 / 0.0); }
        if (text == "-inf") { return Data.Float(-1.0 / 0.0); }
        var sign = 1;
        var digits = text;
        if (digits.starts_with("+")) { digits = digits[1:digits.len()]; }
        else if (digits.starts_with("-")) {
            sign = -1;
            digits = digits[1:digits.len()];
        }
        var base = 10;
        if (digits.starts_with("0x")) { base = 16; }
        else if (digits.starts_with("0o")) { base = 8; }
        else if (digits.starts_with("0b")) { base = 2; }
        if (base != 10) {
            var n = 0;
            for (c in digits[2:digits.len()].chars()) {
                var d = -1;
                if (c >= '0' && c <= '9') { d = ord(c) - ord('0'); }
                else if (c >= 'a' && c <= 'f') { d = ord(c) - ord('a') + 10; }
                else if (c >= 'A' && c <= 'F') { d = ord(c) - ord('A') + 10; }
                if (d < 0 || d >= base) {
                    self.at = start;
                    return throw(self.unexpected());
                }
                n = n * base + d;
            }
            return Data.Int(sign * n);
        }
        var exponent = 0;
        var mantissa = digits;
        var floating = digits.contains(".");
        var e = digits.index_of("e");
        if (e < 0) { e = digits.index_of("E"); }
        if (e >= 0) {
            floating = true;
            mantissa = digits[0:e];
            var written = digits[e + 1:digits.len()];
            var negative = written.starts_with("-");
            if (written.starts_with("-") || written.starts_with("+")) { written = written[1:written.len()]; }
            match written.to_int() {
                Option.Some(n) => { exponent = n; }
                Option.None => {
                    self.at = start;
                    return throw(self.unexpected());
                }
            }
            if (negative) { exponent = -exponent; }
        }
        if (!floating) {
            match mantissa.to_int() {
                Option.Some(n) => { return Data.Int(sign * n); }
                Option.None => {
                    self.at = start;
                    return throw(self.unexpected());
                }
            }
        }
        var value = 0.0;
        match mantissa.to_float() {
            Option.Some(f) => { value = f; }
            Option.None => {
                self.at = start;
                return throw(self.unexpected());
            }
        }
        while (exponent > 0) {
            value = value * 10.0;
            exponent -= 1;
        }
        while (exponent < 0) {
            value = value / 10.0;
            exponent += 1;
        }
        if (sign < 0) { value = -value; }
        return Data.Float(value);
    }
}
