/**
 * Bytes as text in 64 characters, three bytes to four.
 *
 * ```
 * import { encode, decode, encode_with, Alphabet } from "std/encoding/Base64";
 *
 * print(encode("hi?".bytes()));                              // aGk/
 * print(encode_with("hi?".bytes(), Alphabet.UrlSafe, false)); // aGk_
 * print(decode("aGk="));                                     // [104, 105]
 * ```
 *
 * The standard alphabet ends in `+` and `/`; the URL-safe one swaps those for
 * `-` and `_`, which a path or a query string can hold as they are. Padding is
 * the `=` that makes the length a multiple of four; decoding reads input with
 * or without it.
 */

import { Throw } from "../core/Error";
import { DecodeError } from "Codec";
import { buffer } from "../io/Buffer";

/** Which two characters stand for 62 and 63. */
type Alphabet {
    /** `+` and `/`, as RFC 4648 section 4. */
    Standard,

    /** `-` and `_`, as RFC 4648 section 5. */
    UrlSafe
}

/** In the standard alphabet, padded. */
fn encode(bytes: Array<byte>): string {
    return encode_with(bytes, Alphabet.Standard, true);
}

/** In the given alphabet, padded with `=` or not. */
fn encode_with(bytes: Array<byte>, alphabet: Alphabet, padded: bool): string {
    var chars = __alphabet(alphabet);
    var parts: List<string> = [];
    var i = 0;
    while (i < bytes.len()) {
        var left = bytes.len() - i;
        var n = bytes[i].to_int() << 16;
        if (left > 1) { n = n | (bytes[i + 1].to_int() << 8); }
        if (left > 2) { n = n | bytes[i + 2].to_int(); }
        parts.push(str(chars[(n >> 18) & 63]));
        parts.push(str(chars[(n >> 12) & 63]));
        if (left > 1) { parts.push(str(chars[(n >> 6) & 63])); } else if (padded) { parts.push("="); }
        if (left > 2) { parts.push(str(chars[n & 63])); } else if (padded) { parts.push("="); }
        i = i + 3;
    }
    return __str_join(parts.items, parts.count);
}

/** The bytes standard Base64 spells, padded or not. */
fn decode(text: string): <Throw<DecodeError>> Array<byte> {
    return decode_with(text, Alphabet.Standard);
}

/** The bytes the text spells in the given alphabet, padded or not. */
fn decode_with(text: string, alphabet: Alphabet): <Throw<DecodeError>> Array<byte> {
    var stop = text.len();
    while (stop > 0 && text[stop - 1] == '=') { stop = stop - 1; }
    if (stop < text.len() && text.len() % 4 != 0) { throw(DecodeError.Truncated(text.len())); }
    if (stop % 4 == 1) { throw(DecodeError.Truncated(stop)); }
    var out = buffer();
    var held = 0;
    var bits = 0;
    var i = 0;
    while (i < stop) {
        held = (held << 6) | __value(text, i, alphabet);
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            out.write_bytes([(held >> bits).to_byte()]);
            held = held & ((1 << bits) - 1);
        }
        i = i + 1;
    }
    return out.bytes();
}

fn __alphabet(alphabet: Alphabet): string {
    var common = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    match alphabet {
        Alphabet.Standard => { return common + "+/"; }
        Alphabet.UrlSafe => { return common + "-_"; }
    }
}

fn __value(text: string, at: int, alphabet: Alphabet): <Throw<DecodeError>> int {
    var c = text[at];
    if (c >= 'A' && c <= 'Z') { return ord(c) - ord('A'); }
    if (c >= 'a' && c <= 'z') { return ord(c) - ord('a') + 26; }
    if (c >= '0' && c <= '9') { return ord(c) - ord('0') + 52; }
    var sixty_two = match alphabet { Alphabet.Standard => '+', Alphabet.UrlSafe => '-', };
    var sixty_three = match alphabet { Alphabet.Standard => '/', Alphabet.UrlSafe => '_', };
    if (c == sixty_two) { return 62; }
    if (c == sixty_three) { return 63; }
    return throw(DecodeError.Unexpected(at, c));
}
