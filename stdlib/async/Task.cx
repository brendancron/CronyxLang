/**
 * Tasks that wait, and the scopes that run them.
 *
 * ```
 * import { Async, all, pause } from "std/async/Task";
 *
 * fn count(name: String): <Async, Console> Int {
 *     for (var i = 0; i < 2; i += 1) { print(name + " " + str(i)); pause(); }
 *     return name.len();
 * }
 *
 * var sizes = all([ () => count("a"), () => count("bb") ]);
 * print(str(sizes[0]) + " " + str(sizes[1]));
 * ```
 *
 * The top level runs under `block_on`, the scheduler; `scope`, `all`, `race`,
 * `interleaved` and `both` are scopes, which return only once every task in
 * them has finished. A scope schedules its own tasks and waits on the one
 * around it when none of them can run, so a task runs where its scope is,
 * under the handlers around it, and nothing outlives the scope that started
 * it.
 */

import { Throw } from "../core/Error";
import { Duration, Instant, Time } from "../os/Time";

/** Waiting, and what a waiting task is woken by. */
trait Async {
    /** Parks the task and hands `register` the function that wakes it, which may be called once. */
    @ctl fn park(register: (() -> Unit) -> Unit): Unit;

    /** The scheduler's timers and sockets, which a scope hands on as they are. */
    fn reactor(): Reactor;
}

/**
 * What wakes a task besides another task: `after` and `when_ready` call `wake`
 * once their condition holds, and hand back what cancels that. Nothing here
 * performs anything, so a scope hands the scheduler's on to its tasks.
 */
type Reactor {
    /** Once `delay` has passed. */
    after: (Duration, () -> Unit) -> () -> Unit,

    /** Once the socket can be read from without waiting, or written to when the flag is set. */
    when_ready: (Int, Bool, () -> Unit) -> () -> Unit,

    /**
     * What the task's scope calls in place of unwinding it, while it is set: a
     * scope waiting on the one around it is woken to stop its own tasks.
     */
    on_cancel: (Option<() -> Unit>) -> Unit
}

/** Calls `wake` once `delay` has passed, and hands back what cancels that. */
fn after(delay: Duration, wake: () -> Unit): <Async> () -> Unit {
    return reactor().after(delay, wake);
}

/**
 * Calls `wake` once the socket can be read from without waiting, or written to
 * when `writing`, and hands back what cancels that.
 */
fn when_ready(socket: Int, writing: Bool, wake: () -> Unit): <Async> () -> Unit {
    return reactor().when_ready(socket, writing, wake);
}

/**
 * Parks the task and hands `register` the function that wakes it. Whatever
 * calls that function supplies what `suspend` returns. It may be called once.
 */
fn suspend<T>(register: ((T) -> Unit) -> Unit): <Async> T {
    var got: Option<T> = Option.None;
    park((wake) => {
        register((value) => {
            got = Option.Some(value);
            wake();
        });
    });
    match got {
        Option.Some(value) => { return value; }
        Option.None => { panic("a parked task was resumed without being woken"); }
    }
}

/** Lets every other task that is ready run before this one carries on. */
fn pause(): <Async> Unit {
    park((wake: () -> Unit) => { wake(); });
}

/**
 * Runs the body, which may start tasks into this scope with the function it is
 * handed, and returns what the body returned once the body and every task it
 * started have finished.
 *
 * ```
 * scope((start) => {
 *     while (true) {
 *         var conn = listener.accept();
 *         start(() => { answer(conn); });
 *     }
 * });
 * ```
 *
 * The body is a task of the scope like the rest, and a task started runs once
 * the one that started it waits or finishes. If any fails, the others, the body
 * among them, are cancelled where they are waiting, their `defer`s run, and
 * once every one has stopped the failure is thrown from here; a task started
 * after that never starts. A second failure is dropped with its task.
 */
fn scope<R, X, E>(body: ((() -> <Async, Throw<X>, E> Unit) -> Unit) -> <Async, Throw<X>, E> R)
    : <Async, Throw<X>, E> R {
    var result: List<R> = [];
    __scope((start, stop) => { result.push(body(start)); });
    if (result.len() == 0) { panic("a scope finished without its body's value"); }
    return result[0];
}

/**
 * Runs the tasks side by side and returns their results, in the order the
 * tasks were given.
 *
 * If one fails, the others are cancelled where they are waiting, and their
 * `defer`s run; one not yet started never starts. Once every one has stopped,
 * the failure is thrown from here. A second failure is dropped with its task.
 */
fn all<T, X, E>(tasks: List<() -> <Async, Throw<X>, E> T>): <Async, Throw<X>, E> List<T> {
    var slots: List<Option<T>> = [];
    __scope((start, stop) => {
        for (task in tasks) {
            var at = slots.len();
            slots.push(Option.None);
            start(() => { slots[at] = Option.Some(task()); });
        }
    });
    var results: List<T> = [];
    for (slot in slots) {
        match slot {
            Option.Some(value) => { results.push(value); }
            Option.None => { panic("a task of `all` finished without a value"); }
        }
    }
    return results;
}

/**
 * Runs the tasks side by side and returns the result of whichever finishes
 * first. The others are cancelled where they are waiting, as a failure in
 * `all` cancels them, and this returns once every one has stopped.
 *
 * A failure before any finishes is thrown from here. Panics if given no tasks.
 */
fn race<T, X, E>(tasks: List<() -> <Async, Throw<X>, E> T>): <Async, Throw<X>, E> T {
    if (tasks.len() == 0) { panic("race needs a task to wait for"); }
    var won: List<T> = [];
    __scope((start, stop) => {
        for (task in tasks) {
            start(() => {
                var value = task();
                if (won.len() == 0) {
                    won.push(value);
                    stop();
                }
            });
        }
    });
    if (won.len() == 0) { panic("a race finished without a winner"); }
    return won[0];
}

/** Runs the actions side by side, as `all` does, for their effects alone. */
fn interleaved<X, E>(actions: List<() -> <Async, Throw<X>, E> Unit>): <Async, Throw<X>, E> Unit {
    all(actions);
}

/** Runs two tasks side by side, as `all` does, when their results differ in type. */
fn both<A, B, X, E>(
    a: () -> <Async, Throw<X>, E> A,
    b: () -> <Async, Throw<X>, E> B
): <Async, Throw<X>, E> (A, B) {
    var left: Option<A> = Option.None;
    var right: Option<B> = Option.None;
    all([ () => { left = Option.Some(a()); }, () => { right = Option.Some(b()); } ]);
    match left {
        Option.Some(x) => {
            match right {
                Option.Some(y) => { return (x, y); }
                Option.None => {}
            }
        }
        Option.None => {}
    }
    panic("a task of `both` finished without a value");
}

/**
 * One task of a scope: what unwinds it while it waits, what is called in its
 * place when it is a scope waiting on this one, whether it is being unwound,
 * and whether it has finished.
 */
type __Parked<E> {
    stop: Option<() -> <E> Unit>,
    hook: Option<() -> Unit>,
    unwinding: Bool,
    finished: Bool
}

/** A scope's tasks, its queue, and what it waits on when none of them can run. */
type __Scope<E> {
    ready: List<() -> <E> Unit>,
    parked: List<__Parked<E>>,
    remaining: Int,
    cancelled: Bool,
    unwound: Bool,
    from_outside: Bool,
    over: Bool,
    outer: Option<() -> Unit>,
    reactor: Reactor
}

// The scope `scope`, `all` and `race` share. The body runs as its first task,
// handed `start`, and `stop`, which cancels every task still running as a
// failure does but throws nothing.
fn __scope<X, E>(body: ((() -> <Async, Throw<X>, E> Unit) -> Unit, () -> Unit) -> <Async, Throw<X>, E> Unit)
    : <Async, Throw<X>, E> Unit {
    var s: __Scope<E> = __Scope {
        ready: [],
        parked: [],
        remaining: 0,
        cancelled: false,
        unwound: false,
        from_outside: false,
        over: false,
        outer: Option.None,
        reactor: reactor()
    };
    var pending: List<() -> <Async, Throw<X>, E> Unit> = [];
    var failure: List<X> = [];
    var stop = () => { s.cancelled = true; };
    var start = (task: () -> <Async, Throw<X>, E> Unit) => {
        if (s.over) { panic("a task was started in a scope that had finished"); }
        if (!s.cancelled) {
            s.remaining += 1;
            pending.push(task);
        }
    };
    var cancelled_from_outside = () => {
        s.cancelled = true;
        s.from_outside = true;
        match s.outer {
            Option.Some(wake) => {
                s.outer = Option.None;
                wake();
            }
            Option.None => {}
        }
    };
    s.remaining = 1;
    pending.push(() => { body(start, stop); });
    while (s.remaining > 0) {
        if (s.cancelled && !s.unwound) {
            s.remaining -= pending.len();
            pending = [];
            __unwind(s);
        }
        while (pending.len() > 0 && !s.cancelled) {
            var next = pending[0];
            pending = pending[1:];
            __launch(s, failure, next);
        }
        while (s.ready.len() > 0 && (s.unwound || !s.cancelled)) {
            var next = s.ready[0];
            s.ready = s.ready[1:];
            next();
        }
        if (s.cancelled && !s.unwound) {
            s.remaining -= pending.len();
            pending = [];
            __unwind(s);
        }
        if (s.remaining > 0 && pending.len() == 0 && s.ready.len() == 0) {
            s.reactor.on_cancel(Option.Some(cancelled_from_outside));
            park((wake: () -> Unit) => { s.outer = Option.Some(wake); });
            s.reactor.on_cancel(Option.None);
        }
    }
    s.over = true;
    // Its own tasks have stopped, and now it is unwound: the scope that
    // cancelled it unwinds whatever waits once it is cancelled.
    if (s.from_outside) {
        park((wake: () -> Unit) => {});
        panic("a cancelled scope was resumed");
    }
    if (failure.len() > 0) { throw(failure[0]); }
}

// Every parked task, the latest started first, and nothing left queued: a task
// woken but not yet run is still parked, and is unwound like the rest. A scope
// among them is woken instead, to stop its own.
fn __unwind<E>(s: __Scope<E>): <E> Unit {
    s.unwound = true;
    s.ready = [];
    var i = s.parked.len() - 1;
    while (i >= 0) {
        var p = s.parked[i];
        match p.hook {
            Option.Some(hook) => {
                p.hook = Option.None;
                hook();
            }
            Option.None => {
                match p.stop {
                    Option.Some(unwind) => {
                        p.stop = Option.None;
                        unwind();
                    }
                    Option.None => {}
                }
            }
        }
        i -= 1;
    }
    s.parked = __running(s.parked);
}

fn __running<E>(parked: List<__Parked<E>>): List<__Parked<E>> {
    var kept: List<__Parked<E>> = [];
    for (p in parked) {
        if (!p.finished) { kept.push(p); }
    }
    return kept;
}

// Runs the task until it first waits or finishes. Its wake-up queues the rest
// in the scope, and wakes the scope if it is waiting on the one around it.
fn __launch<X, E>(s: __Scope<E>, failure: List<X>, task: () -> <Async, Throw<X>, E> Unit): <E> Unit {
    // A scope that runs for as long as a server does would otherwise keep a
    // record of every task it ever ran.
    if (s.parked.len() >= 64 && s.parked.len() >= 2 * s.remaining) { s.parked = __running(s.parked); }
    var here: __Parked<E> = __Parked { stop: Option.None, hook: Option.None, unwinding: false, finished: false };
    s.parked.push(here);
    run<Unit> {
        defer {
            here.finished = true;
            here.stop = Option.None;
            s.remaining -= 1;
        }
        run<Unit> {
            task();
        } handle<Throw<X>> {
            fn throw(e) {
                if (!s.cancelled) {
                    failure.push(e);
                    s.cancelled = true;
                }
            }
        }
    } handle<Async> {
        fn park(register, resume) {
            // A task that waits once its scope is cancelled is unwound there,
            // but one waiting in a `defer` as it is unwound carries on.
            if (s.cancelled && !here.unwinding) {
                here.unwinding = true;
                discontinue(resume);
            } else {
                // Per wait, so a wake-up left behind by a wait the task was
                // unwound from finds it gone.
                var live = true;
                var fired = false;
                here.stop = Option.Some(() => {
                    live = false;
                    here.unwinding = true;
                    discontinue(resume);
                });
                register(() => {
                    if (fired) { panic("a suspended task was woken twice"); }
                    fired = true;
                    if (live) {
                        live = false;
                        s.ready.push(() => {
                            here.stop = Option.None;
                            resume(());
                        });
                        match s.outer {
                            Option.Some(wake) => {
                                s.outer = Option.None;
                                wake();
                            }
                            Option.None => {}
                        }
                    }
                });
            }
        }
        fn reactor() {
            return Reactor {
                after: s.reactor.after,
                when_ready: s.reactor.when_ready,
                on_cancel: (hook: Option<() -> Unit>) => { here.hook = hook; }
            };
        }
    }
}

// Set without reading the clock, so `due` is filled in by the scheduler before
// it next looks at its timers.
type __Timer {
    delay: Duration,
    due: Option<Instant>,
    wake: () -> Unit,
    cancelled: Bool
}

type __Watch {
    socket: Int,
    writing: Bool,
    wake: () -> Unit,
    cancelled: Bool
}

/**
 * Runs `main` and every task it starts, and returns what `main` returned once
 * they have all finished. When every task is waiting, it waits for the first
 * timer through `Time`, or, while a task waits on a socket, for that socket or
 * the first timer, whichever comes first.
 *
 * The top level runs under one already. Panics if every task is waiting and
 * none is left to wake one.
 */
fn block_on<T, E>(main: () -> <Async, E> T): <Time, E> T {
    var result: Option<T> = Option.None;
    var ready: List<() -> <E> Unit> = [];
    var timers: List<__Timer> = [];
    var watches: List<__Watch> = [];
    var reactor = Reactor {
        after: (delay: Duration, wake: () -> Unit) => {
            var timer = __Timer { delay: delay, due: Option.None, wake: wake, cancelled: false };
            timers.push(timer);
            return () => { timer.cancelled = true; };
        },
        when_ready: (socket: Int, writing: Bool, wake: () -> Unit) => {
            var watch = __Watch { socket: socket, writing: writing, wake: wake, cancelled: false };
            watches.push(watch);
            return () => { watch.cancelled = true; };
        },
        on_cancel: (hook: Option<() -> Unit>) => {}
    };
    run<Unit> {
        result = Option.Some(main());
    } handle<Async> {
        fn park(register, resume) {
            // A second call would run the rest of the task twice, and finish it twice.
            var fired = false;
            register(() => {
                if (fired) { panic("a suspended task was woken twice"); }
                fired = true;
                ready.push(() => { resume(()); });
            });
        }
        fn reactor() { return reactor; }
    }
    // A slot that has run is overwritten, because what it held is a
    // continuation and with it every local of the function that suspended.
    // The placeholder is made out here: a closure made in the loop would
    // capture `next`.
    var at = 0;
    var idle: () -> <E> Unit = () => {};
    var waiting = true;
    while (waiting) {
        while (at < ready.len()) {
            var next = ready[at];
            ready[at] = idle;
            at += 1;
            next();
        }
        ready = [];
        at = 0;
        var now = instant();
        for (timer in timers) {
            match timer.due {
                Option.None => { timer.due = Option.Some(now + timer.delay); }
                _ => {}
            }
        }
        watches = __watching(watches);
        var first = __first_due(timers);
        if (watches.len() > 0) {
            var limit = -1;
            match first {
                Option.Some(timer) => { limit = __at_least_zero((__due(timer) - instant()).nanos); }
                Option.None => {}
            }
            __wake_ready(watches, limit);
            match first {
                Option.Some(timer) => {
                    if (!(instant() < __due(timer))) { __fire(timer); }
                }
                Option.None => {}
            }
            timers = __pending(timers);
        } else {
            match first {
                Option.None => { waiting = false; }
                Option.Some(timer) => {
                    if (instant() < __due(timer)) { wait_until(__due(timer)); }
                    __fire(timer);
                    timers = __pending(timers);
                }
            }
        }
    }
    match result {
        Option.Some(value) => { return value; }
        Option.None => { panic("deadlock: every task is waiting, and nothing is left to wake one"); }
    }
}

fn __due(timer: __Timer): Instant {
    match timer.due {
        Option.Some(at) => { return at; }
        Option.None => { panic("a timer was read before the scheduler set it"); }
    }
}

fn __fire(timer: __Timer) {
    timer.cancelled = true;
    timer.wake();
}

fn __at_least_zero(n: Int): Int {
    if (n < 0) { return 0; }
    return n;
}

fn __watching(watches: List<__Watch>): List<__Watch> {
    var live: List<__Watch> = [];
    for (watch in watches) {
        if (!watch.cancelled) { live.push(watch); }
    }
    return live;
}

// In the order they were set, so tasks waiting on sockets that became ready
// together carry on in the order they began waiting.
fn __wake_ready(watches: List<__Watch>, limit: Int) {
    var reads: List<Int> = [];
    var writes: List<Int> = [];
    for (watch in watches) {
        if (watch.writing) { writes.push(watch.socket); } else { reads.push(watch.socket); }
    }
    var (readable, writable) = __net_wait(reads.items[0:reads.len()], writes.items[0:writes.len()], limit);
    for (watch in watches) {
        var found = readable;
        if (watch.writing) { found = writable; }
        if (!watch.cancelled && __holds(found, watch.socket)) {
            watch.cancelled = true;
            watch.wake();
        }
    }
}

fn __holds(sockets: Array<Int>, wanted: Int): Bool {
    for (socket in sockets) {
        if (socket == wanted) { return true; }
    }
    return false;
}

// The earliest, and of two due together the one set first, so tasks asleep
// for the same time wake in the order they went to sleep.
fn __first_due(timers: List<__Timer>): Option<__Timer> {
    var first: Option<__Timer> = Option.None;
    for (timer in timers) {
        if (!timer.cancelled) {
            match first {
                Option.None => { first = Option.Some(timer); }
                Option.Some(best) => {
                    if (__due(timer) < __due(best)) { first = Option.Some(timer); }
                }
            }
        }
    }
    return first;
}

fn __pending(timers: List<__Timer>): List<__Timer> {
    var left: List<__Timer> = [];
    for (timer in timers) {
        if (!timer.cancelled) { left.push(timer); }
    }
    return left;
}
