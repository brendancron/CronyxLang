/**
 * Tasks that wait, and the scopes that run them.
 *
 * ```
 * import { async, block_on, all, pause } from "std/async/Task";
 *
 * fn count(name: string): int {
 *     for (var i = 0; i < 2; i += 1) { print(name + " " + str(i)); pause(); }
 *     return name.len();
 * }
 *
 * block_on {
 *     var sizes = all([ () => count("a"), () => count("bb") ]);
 *     print(str(sizes[0]) + " " + str(sizes[1]));
 * };
 * ```
 *
 * `block_on` is the one scheduler and sits at the root; `all`, `interleaved`
 * and `both` are scopes, which return only once every task in them has
 * finished. A task runs where its scope is, under the handlers around it, and
 * nothing outlives the scope that started it.
 */

import { Throw } from "../core/Error";
import { Promise, promise, resolve, await } from "Promise";

/** Waiting, and the one queue waiting tasks are woken through. */
effect async {
    /**
     * Parks the task and hands `register` the callback that wakes it. Whatever
     * calls that callback supplies what `suspend` returns. It may be called
     * once.
     */
    ctl suspend<T>(register: ((T) -> unit) -> unit): T;

    /** The function that puts a wake-up in the scheduler's queue. */
    fn waker(): (() -> unit) -> unit;
}

/** Lets every other task that is ready run before this one carries on. */
fn pause() {
    suspend { it(()) };
}

// A second call would run the rest of the task twice, and finish it twice.
fn __once<T>(wake: (() -> unit) -> unit, k: (T) -> unit): (T) -> unit {
    var fired = false;
    return (value) => {
        if (fired) { panic("a suspended task was woken twice"); }
        fired = true;
        wake { k(value); };
    };
}

/**
 * Runs the tasks side by side and returns their results, in the order the
 * tasks were given.
 *
 * If one fails, the others are cancelled at their next suspension point, and
 * once every one has stopped the failure is thrown from here. A second failure
 * is dropped with its task.
 */
fn all<T, X, E>(tasks: List<() -> <async, Throw<X>, E> T>): <async, Throw<X>, E> List<T> {
    var slots: List<Promise<T>> = [];
    var failure: Option<X> = Option.None;
    var cancelled = false;
    var remaining = tasks.len();
    var settled: Promise<unit> = promise();

    fn finish() {
        remaining -= 1;
        if (remaining == 0) { resolve(settled, ()); }
    }

    for (task in tasks) {
        var slot: Promise<T> = promise();
        slots.push(slot);
        run {
            run {
                resolve(slot, task());
            } handle Throw {
                final ctl throw(e) {
                    if (!cancelled) {
                        failure = Option.Some(e);
                        cancelled = true;
                    }
                }
            }
            finish();
        } handle async {
            ctl suspend(register) {
                var wake = waker();
                register(__once(wake, (value) => {
                    if (!cancelled) { resume value; } else { finish(); }
                }));
            }
            fn waker() { return waker(); }
        }
    }

    if (tasks.len() > 0) { await(settled); }
    match failure {
        Option.Some(e) => { throw(e); }
        Option.None => {}
    }
    var results: List<T> = [];
    for (slot in slots) { results.push(await(slot)); }
    return results;
}

/** Runs the actions side by side, as `all` does, for their effects alone. */
fn interleaved<X, E>(actions: List<() -> <async, Throw<X>, E> unit>): <async, Throw<X>, E> unit {
    all(actions);
}

/** Runs two tasks side by side, as `all` does, when their results differ in type. */
fn both<A, B, X, E>(
    a: () -> <async, Throw<X>, E> A,
    b: () -> <async, Throw<X>, E> B
): <async, Throw<X>, E> (A, B) {
    var left: Promise<A> = promise();
    var right: Promise<B> = promise();
    all([ () => { resolve(left, a()); }, () => { resolve(right, b()); } ]);
    return (await(left), await(right));
}

/**
 * Runs `main` and every task it starts, and returns once they have all
 * finished.
 *
 * Panics if every task is waiting and none is left to wake one, and with the
 * failure's value if one reaches here unhandled.
 */
fn block_on<X, E>(main: () -> <async, Throw<X>, E> unit): <E> unit {
    var ready: List<() -> unit> = [];
    var finished = false;
    run {
        run {
            main();
        } handle Throw {
            final ctl throw(e) { panic("uncaught failure: " + str(e)); }
        }
        finished = true;
    } handle async {
        ctl suspend(register) {
            register(__once((k) => { ready.push(k); }, (value) => { resume value; }));
        }
        fn waker() { return (k) => { ready.push(k); }; }
    }
    // Scopes hold the list `waker` handed out, so it is read with a cursor
    // rather than replaced by its tail.
    var at = 0;
    while (at < ready.len()) {
        var next = ready[at];
        at += 1;
        next();
    }
    if (!finished) { panic("deadlock: every task is waiting, and nothing is left to wake one"); }
}
