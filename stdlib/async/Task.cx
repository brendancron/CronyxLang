/**
 * Tasks that wait, and the scopes that run them.
 *
 * ```
 * import { async, block_on, all, pause } from "std/async/Task";
 *
 * fn count(name: string): int {
 *     for (var i = 0; i < 2; i += 1) { print(name + " " + str(i)); pause(); }
 *     return name.len();
 * }
 *
 * block_on {
 *     var sizes = all([ () => count("a"), () => count("bb") ]);
 *     print(str(sizes[0]) + " " + str(sizes[1]));
 * };
 * ```
 *
 * `block_on` is the one scheduler and sits at the root; `all`, `interleaved`
 * and `both` are scopes, which return only once every task in them has
 * finished. A task runs where its scope is, under the handlers around it, and
 * nothing outlives the scope that started it.
 */

import { Throw } from "../core/Error";
import { Duration, Instant, Time } from "../os/Time";
import { Promise, promise, resolve, await } from "Promise";

/** Waiting, and the one queue waiting tasks are woken through. */
effect async {
    /**
     * Parks the task and hands `register` the callback that wakes it. Whatever
     * calls that callback supplies what `suspend` returns. It may be called
     * once.
     */
    ctl suspend<T>(register: ((T) -> unit) -> unit): T;

    /** The function that puts a wake-up in the scheduler's queue. */
    fn waker(): (() -> unit) -> unit;

    /**
     * Calls `wake` once `delay` has passed, and hands back what cancels that.
     * A timer that is cancelled, or has fired, is not waited for.
     */
    fn after(delay: Duration, wake: () -> unit): () -> unit;

    /**
     * Calls `wake` once the socket can be read from without waiting, or
     * written to when `writing`, and hands back what cancels that.
     */
    fn when_ready(socket: int, writing: bool, wake: () -> unit): () -> unit;
}

/** Lets every other task that is ready run before this one carries on. */
fn pause() {
    suspend { it(()) };
}

// A second call would run the rest of the task twice, and finish it twice.
fn __once<T>(wake: (() -> unit) -> unit, k: (T) -> unit): (T) -> unit {
    var fired = false;
    return (value) => {
        if (fired) { panic("a suspended task was woken twice"); }
        fired = true;
        wake { k(value); };
    };
}

/**
 * Runs the tasks side by side and returns their results, in the order the
 * tasks were given.
 *
 * If one fails, the others are cancelled where they are waiting, and their
 * `defer`s run; one not yet started never starts. Once every one has stopped,
 * the failure is thrown from here. A second failure is dropped with its task.
 */
fn all<T, X, E>(tasks: List<() -> <async, Throw<X>, E> T>): <async, Throw<X>, E> List<T> {
    var slots: List<Promise<T>> = [];
    var parked: List<__Parked> = [];
    var failure: Option<X> = Option.None;
    var cancelled = false;
    var remaining = tasks.len();
    var settled: Promise<unit> = promise();

    fn finish() {
        remaining -= 1;
        if (remaining == 0) { resolve(settled, ()); }
    }

    for (task in tasks) {
        var slot: Promise<T> = promise();
        slots.push(slot);
        if (cancelled) {
            finish();
            continue;
        }
        var here = __Parked { stop: Option.None };
        parked.push(here);
        run {
            defer { finish(); }
            run {
                resolve(slot, task());
            } handle Throw {
                final ctl throw(e) {
                    if (!cancelled) {
                        failure = Option.Some(e);
                        cancelled = true;
                        for (other in parked) {
                            match other.stop {
                                Option.Some(stop) => { stop(); }
                                Option.None => {}
                            }
                        }
                    }
                }
            }
        } handle async {
            ctl suspend(register) {
                // Per wait, so a task unwound here can still wait in a `defer`,
                // and a wake-up left behind by the wait it was unwound from
                // finds it gone.
                var live = true;
                here.stop = Option.Some(() => {
                    live = false;
                    here.stop = Option.None;
                    discontinue;
                });
                var wake = waker();
                register(__once(wake, (value) => {
                    if (live) {
                        here.stop = Option.None;
                        resume value;
                    }
                }));
            }
            fn waker() { return waker(); }
            fn after(delay, wake) { return after(delay, wake); }
            fn when_ready(socket, writing, wake) { return when_ready(socket, writing, wake); }
        }
    }

    if (remaining > 0) { await(settled); }
    match failure {
        Option.Some(e) => { throw(e); }
        Option.None => {}
    }
    var results: List<T> = [];
    for (slot in slots) { results.push(await(slot)); }
    return results;
}

type __Parked {
    stop: Option<() -> unit>
}

/** Runs the actions side by side, as `all` does, for their effects alone. */
fn interleaved<X, E>(actions: List<() -> <async, Throw<X>, E> unit>): <async, Throw<X>, E> unit {
    all(actions);
}

/** Runs two tasks side by side, as `all` does, when their results differ in type. */
fn both<A, B, X, E>(
    a: () -> <async, Throw<X>, E> A,
    b: () -> <async, Throw<X>, E> B
): <async, Throw<X>, E> (A, B) {
    var left: Promise<A> = promise();
    var right: Promise<B> = promise();
    all([ () => { resolve(left, a()); }, () => { resolve(right, b()); } ]);
    return (await(left), await(right));
}

type __Timer {
    due: Instant,
    wake: () -> unit,
    cancelled: bool
}

type __Watch {
    socket: int,
    writing: bool,
    wake: () -> unit,
    cancelled: bool
}

/**
 * Runs `main` and every task it starts, and returns once they have all
 * finished. When every task is waiting, it waits for the first timer through
 * `Time`, or, while a task waits on a socket, for that socket or the first
 * timer, whichever comes first.
 *
 * Panics if every task is waiting and none is left to wake one, and with the
 * failure's value if one reaches here unhandled.
 */
fn block_on<X, E>(main: () -> <async, Throw<X>, E> unit): <Time, E> unit {
    var ready: List<() -> unit> = [];
    var timers: List<__Timer> = [];
    var watches: List<__Watch> = [];
    var finished = false;
    run {
        run {
            main();
        } handle Throw {
            final ctl throw(e) { panic("uncaught failure: " + str(e)); }
        }
        finished = true;
    } handle async {
        ctl suspend(register) {
            register(__once((k) => { ready.push(k); }, (value) => { resume value; }));
        }
        fn waker() { return (k) => { ready.push(k); }; }
        fn after(delay, wake) {
            var timer = __Timer { due: instant() + delay, wake: wake, cancelled: false };
            timers.push(timer);
            return () => { timer.cancelled = true; };
        }
        fn when_ready(socket, writing, wake) {
            var watch = __Watch { socket: socket, writing: writing, wake: wake, cancelled: false };
            watches.push(watch);
            return () => { watch.cancelled = true; };
        }
    }
    // Scopes hold the list `waker` handed out, so it is read with a cursor
    // rather than replaced by its tail.
    var at = 0;
    var waiting = true;
    while (waiting) {
        while (at < ready.len()) {
            var next = ready[at];
            at += 1;
            next();
        }
        watches = __watching(watches);
        var first = __first_due(timers);
        if (watches.len() > 0) {
            var limit = -1;
            match first {
                Option.Some(timer) => { limit = __at_least_zero((timer.due - instant()).nanos); }
                Option.None => {}
            }
            __wake_ready(watches, limit);
            match first {
                Option.Some(timer) => {
                    if (!(instant() < timer.due)) { __fire(timer); }
                }
                Option.None => {}
            }
            timers = __pending(timers);
        } else {
            match first {
                Option.None => { waiting = false; }
                Option.Some(timer) => {
                    if (instant() < timer.due) { wait_until(timer.due); }
                    __fire(timer);
                    timers = __pending(timers);
                }
            }
        }
    }
    if (!finished) { panic("deadlock: every task is waiting, and nothing is left to wake one"); }
}

fn __fire(timer: __Timer) {
    timer.cancelled = true;
    timer.wake();
}

fn __at_least_zero(n: int): int {
    if (n < 0) { return 0; }
    return n;
}

fn __watching(watches: List<__Watch>): List<__Watch> {
    var live: List<__Watch> = [];
    for (watch in watches) {
        if (!watch.cancelled) { live.push(watch); }
    }
    return live;
}

// In the order they were set, so tasks waiting on sockets that became ready
// together carry on in the order they began waiting.
fn __wake_ready(watches: List<__Watch>, limit: int) {
    var reads: List<int> = [];
    var writes: List<int> = [];
    for (watch in watches) {
        if (watch.writing) { writes.push(watch.socket); } else { reads.push(watch.socket); }
    }
    var (readable, writable) = __net_wait(reads.items[0:reads.len()], writes.items[0:writes.len()], limit);
    for (watch in watches) {
        var found = readable;
        if (watch.writing) { found = writable; }
        if (!watch.cancelled && __holds(found, watch.socket)) {
            watch.cancelled = true;
            watch.wake();
        }
    }
}

fn __holds(sockets: Array<int>, wanted: int): bool {
    for (socket in sockets) {
        if (socket == wanted) { return true; }
    }
    return false;
}

// The earliest, and of two due together the one set first, so tasks asleep
// for the same time wake in the order they went to sleep.
fn __first_due(timers: List<__Timer>): Option<__Timer> {
    var first: Option<__Timer> = Option.None;
    for (timer in timers) {
        if (!timer.cancelled) {
            match first {
                Option.None => { first = Option.Some(timer); }
                Option.Some(best) => {
                    if (timer.due < best.due) { first = Option.Some(timer); }
                }
            }
        }
    }
    return first;
}

fn __pending(timers: List<__Timer>): List<__Timer> {
    var left: List<__Timer> = [];
    for (timer in timers) {
        if (!timer.cancelled) { left.push(timer); }
    }
    return left;
}
