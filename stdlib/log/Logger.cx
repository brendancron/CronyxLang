/**
 * Logging, as an effect.
 *
 * ```
 * import { Logger, Level, info, warn } from "std/log/Logger";
 *
 * fn serve(port: int) {
 *     info("listening on " + str(port));
 *     warn("no certificate, serving plain HTTP");
 * }
 * ```
 *
 * The root writes each message to standard error, as `[info] listening on
 * 8080`. `record` is the one operation; the functions below are what a
 * program calls. A test handles `Logger` to see what was logged instead, and a program
 * handles it to send logs somewhere else or to drop the ones below a level.
 */

/** How much a message matters, from least to most. */
type Level {
    Trace,
    Debug,
    Info,
    Warn,
    Error
}

impl Level {
    /** 0 for `Trace` up to 4 for `Error`, for comparing two levels. */
    fn rank(self): int {
        match self {
            Level.Trace => { return 0; }
            Level.Debug => { return 1; }
            Level.Info => { return 2; }
            Level.Warn => { return 3; }
            Level.Error => { return 4; }
        }
        return 0;
    }

    /** The level's name in lower case: `info`. */
    fn label(self): string { return __label(self); }
}

/** Where log messages go. */
effect Logger {
    /** Records the message at the level. */
    fn record(level: Level, message: string): unit;
}

/** Logs at `Trace`: detail only worth seeing while chasing a problem. */
fn trace(message: string): <Logger> unit { record(Level.Trace, message); }

/** Logs at `Info`: what the program is doing. */
fn info(message: string): <Logger> unit { record(Level.Info, message); }

/** Logs at `Warn`: something is off, and the program carries on. */
fn warn(message: string): <Logger> unit { record(Level.Warn, message); }

/** Logs at `Error`: something failed. */
fn error(message: string): <Logger> unit { record(Level.Error, message); }

/** How the root writes a message: its level in brackets, then the message. */
fn __written_line(level: Level, message: string): string {
    return "[" + __label(level) + "] " + message + "\n";
}

// A function rather than the method, for the root to call: a library's call
// `level.label()` also names a bare `label`, which a program's own top-level
// function of that name would answer to.
fn __label(level: Level): string {
    match level {
        Level.Trace => { return "trace"; }
        Level.Debug => { return "debug"; }
        Level.Info => { return "info"; }
        Level.Warn => { return "warn"; }
        Level.Error => { return "error"; }
    }
    return "";
}
