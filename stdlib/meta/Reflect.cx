/**
 * What a type says about itself, which is what `typeof` answers with.
 *
 * ```
 * type Point { x: Int, y: Int }
 *
 * meta {
 *     match typeof(Point).shape {
 *         TypeShape.Product(name, _, fields) => {
 *             for (f in fields) { print(str(f.name)); }
 *         }
 *         _ => {}
 *     }
 * }
 * ```
 *
 * A deriver reads these to decide what to write. Their shape is fixed by the
 * compiler, which builds the values: renaming a field here changes what is
 * emitted. The names are long because a program is free to declare its own
 * `Shape`.
 */

/** An argument written in an attribute, by the kind of literal it was. */
type AttrArg {
    /** `@table("people")`. */
    Str(String),

    /** `@width(4)`. */
    Int(Int),

    /** `@scale(1.5)`. */
    Float(Float),

    /** `@skip(true)`. */
    Bool(Bool),
}

/** One attribute as it was written. A doc comment is never one of these. */
type Attr {
    /** The name after the `@`. */
    name: Name,

    /** Its arguments, in the order written. */
    args: Array<AttrArg>
}

/**
 * A type as a field or a payload names it. One level deep: its arguments are
 * references too, so a type that contains itself is not reflected forever, and
 * a deriver that needs to look inside one asks `typeof`.
 */
type TypeRef {
    /** A declared or a primitive type, with its arguments: `Int`, `List<String>`. */
    Named(Name, Array<TypeRef>),

    /** One of the reflected type's own parameters. */
    Param(Name),

    /** A function, a tuple, a record with no declared type. */
    Other,
}

impl TypeRef {
    /** The type as a program writes it: `Option<Int>`, `T`, `?` for one with no name. */
    fn text(self): String {
        match self {
            TypeRef.Named(name, args) => {
                if (args.len() == 0) { return str(name); }
                var parts: List<String> = [str(name), "<"];
                for (var i = 0; i < args.len(); i += 1) {
                    if (i > 0) { parts.push(", "); }
                    parts.push(args[i].text());
                }
                parts.push(">");
                return __str_join(parts.items, parts.count);
            }
            TypeRef.Param(name) => { return str(name); }
            TypeRef.Other => { return "?"; }
        }
        return "?";
    }
}

/** A field of a product type, in the order the type declares them. */
type TypeField {
    /** The field's name. */
    name: Name,

    /** Its type. */
    ty: TypeRef,

    /** Its doc comment, empty where there is none. */
    doc: String,

    /** Its attributes, with the doc comment not among them. */
    attrs: Array<Attr>
}

/** A variant of a sum type. */
type TypeVariant {
    /** The variant's name. */
    name: Name,

    /** How many values it carries. */
    arity: Int,

    /** The type of each value it carries, in order. */
    payload: Array<TypeRef>,

    /** The name of each, when it carries named fields -- `Rect { w, h }` -- and empty when they are positional. */
    fields: Array<Name>,

    /** Its doc comment, empty where there is none. */
    doc: String,

    /** Its attributes, with the doc comment not among them. */
    attrs: Array<Attr>
}

/** What kind of type it is, and what it is made of. */
type TypeShape {
    /** A primitive: nothing to take apart. */
    Scalar,

    /** The type's name, its parameters, and its fields, all present at once. */
    Product(Name, Array<Name>, Array<TypeField>),

    /** The type's name, its parameters, and its variants, one at a time. */
    Sum(Name, Array<Name>, Array<TypeVariant>),

    /** Something with no shape to report -- a function, a tuple. */
    Other,
}

/**
 * A type as a whole, which is what a bare `typeof` answers with. `doc` is the
 * text of a doc comment, empty where there is none.
 */
type Type {
    /** As a program writes it: `Int`, `List<String>`. */
    name: String,

    shape: TypeShape,

    /** Its attributes, with the doc comment not among them. */
    attrs: Array<Attr>,

    doc: String
}

// Reflection's own records are written as their structure, the way a value
// read in a meta block is usually inspected: `Named(Int, [])`.
impl Debug for AttrArg {
    fn debug(self): String {
        match self {
            AttrArg.Str(v) => { return "Str(" + debug(v) + ")"; }
            AttrArg.Int(v) => { return "Int(" + debug(v) + ")"; }
            AttrArg.Float(v) => { return "Float(" + debug(v) + ")"; }
            AttrArg.Bool(v) => { return "Bool(" + debug(v) + ")"; }
        }
    }
}
impl Display for AttrArg { fn fmt(self): String { return debug(self); } }

impl Debug for Attr {
    fn debug(self): String { return "{ name: " + debug(self.name) + ", args: " + debug(self.args) + " }"; }
}
impl Display for Attr { fn fmt(self): String { return debug(self); } }

impl Debug for TypeRef {
    fn debug(self): String {
        match self {
            TypeRef.Named(name, args) => { return "Named(" + debug(name) + ", " + debug(args) + ")"; }
            TypeRef.Param(name) => { return "Param(" + debug(name) + ")"; }
            TypeRef.Other => { return "Other"; }
        }
    }
}
impl Display for TypeRef { fn fmt(self): String { return debug(self); } }

impl Debug for TypeField {
    fn debug(self): String {
        return "{ name: " + debug(self.name) + ", ty: " + debug(self.ty) + ", doc: " + debug(self.doc)
            + ", attrs: " + debug(self.attrs) + " }";
    }
}
impl Display for TypeField { fn fmt(self): String { return debug(self); } }

impl Debug for TypeVariant {
    fn debug(self): String {
        return "{ name: " + debug(self.name) + ", arity: " + debug(self.arity) + ", payload: " + debug(self.payload)
            + ", fields: " + debug(self.fields) + ", doc: " + debug(self.doc) + ", attrs: " + debug(self.attrs) + " }";
    }
}
impl Display for TypeVariant { fn fmt(self): String { return debug(self); } }

impl Debug for TypeShape {
    fn debug(self): String {
        match self {
            TypeShape.Scalar => { return "Scalar"; }
            TypeShape.Product(name, params, fields) => {
                return "Product(" + debug(name) + ", " + debug(params) + ", " + debug(fields) + ")";
            }
            TypeShape.Sum(name, params, variants) => {
                return "Sum(" + debug(name) + ", " + debug(params) + ", " + debug(variants) + ")";
            }
            TypeShape.Other => { return "Other"; }
        }
    }
}
impl Display for TypeShape { fn fmt(self): String { return debug(self); } }

impl Debug for Type {
    fn debug(self): String { return self.name; }
}

/** A type is written as its name. */
impl Display for Type {
    fn fmt(self): String { return self.name; }
}

/**
 * What a module declares, which is what `moduleof` answers with.
 *
 * ```
 * import "helpers";
 *
 * meta {
 *     match moduleof(helpers) {
 *         Module.File(name, declarations) => {
 *             for (d in declarations) { print(str(d.name) + ": " + d.doc); }
 *         }
 *         _ => {}
 *     }
 * }
 * ```
 *
 * Asking is a reference to the module, so its top-level `meta` blocks run first
 * and what they generate is among its declarations.
 */
type Module {
    /** A file: its name as imported, and its top-level declarations in source order, written or generated. */
    File(Name, Array<Declaration>),

    /** A directory: its name, and the modules inside it. */
    Directory(Name, Array<Module>),
}

/** A named top-level declaration. An impl has no name, and is reached through its type. */
type Declaration {
    /** Its name, which a `gen` can call it by. */
    name: Name,

    kind: DeclarationKind,

    /** Its doc comment, empty where there is none. */
    doc: String,

    /** Its attributes, with the doc comment not among them. */
    attrs: Array<Attr>,

    /** A function's parameter names, in order; empty for anything else. */
    params: Array<Name>,

    /** Where it was written, so a meta block can report a mistake there with `compile_error`. */
    span: Span
}

/** What a declaration declares. */
type DeclarationKind {
    Function,
    Type,
    Trait,
}
