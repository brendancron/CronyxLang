/**
 * What a type says about itself, which is what `typeof` answers with.
 *
 * ```
 * type Point { x: int, y: int }
 *
 * meta {
 *     match typeof(Point).shape {
 *         TypeShape.Product(name, _, fields) => {
 *             for (f in fields) { print(str(f.name)); }
 *         }
 *         _ => {}
 *     }
 * }
 * ```
 *
 * A deriver reads these to decide what to write. Their shape is fixed by the
 * compiler, which builds the values: renaming a field here changes what is
 * emitted. The names are long because a program is free to declare its own
 * `Shape`.
 */

/** An argument written in an attribute, by the kind of literal it was. */
type AttrArg {
    /** `@table("people")`. */
    Str(string),

    /** `@width(4)`. */
    Int(int),

    /** `@scale(1.5)`. */
    Float(float),

    /** `@skip(true)`. */
    Bool(bool),
}

/** One attribute as it was written. A doc comment is never one of these. */
type Attr {
    /** The name after the `@`. */
    name: Name,

    /** Its arguments, in the order written. */
    args: Array<AttrArg>
}

/**
 * A type as a field or a payload names it. One level deep: its arguments are
 * references too, so a type that contains itself is not reflected forever, and
 * a deriver that needs to look inside one asks `typeof`.
 */
type TypeRef {
    /** A declared or a primitive type, with its arguments: `int`, `List<string>`. */
    Named(Name, Array<TypeRef>),

    /** One of the reflected type's own parameters. */
    Param(Name),

    /** A function, a tuple, a record with no declared type. */
    Other,
}

impl TypeRef {
    /** The type as a program writes it: `Option<int>`, `T`, `?` for one with no name. */
    fn text(self): string {
        match self {
            TypeRef.Named(name, args) => {
                if (args.len() == 0) { return str(name); }
                var out = str(name) + "<";
                for (var i = 0; i < args.len(); i += 1) {
                    if (i > 0) { out = out + ", "; }
                    out = out + args[i].text();
                }
                return out + ">";
            }
            TypeRef.Param(name) => { return str(name); }
            TypeRef.Other => { return "?"; }
        }
        return "?";
    }
}

/** A field of a product type, in the order the type declares them. */
type TypeField {
    /** The field's name. */
    name: Name,

    /** Its type. */
    ty: TypeRef,

    /** Its doc comment, empty where there is none. */
    doc: string,

    /** Its attributes, with the doc comment not among them. */
    attrs: Array<Attr>
}

/** A variant of a sum type. */
type TypeVariant {
    /** The variant's name. */
    name: Name,

    /** How many values it carries. */
    arity: int,

    /** The type of each value it carries, in order. */
    payload: Array<TypeRef>,

    /** The name of each, when it carries named fields -- `Rect { w, h }` -- and empty when they are positional. */
    fields: Array<Name>,

    /** Its doc comment, empty where there is none. */
    doc: string,

    /** Its attributes, with the doc comment not among them. */
    attrs: Array<Attr>
}

/** What kind of type it is, and what it is made of. */
type TypeShape {
    /** A primitive: nothing to take apart. */
    Scalar,

    /** The type's name, its parameters, and its fields, all present at once. */
    Product(Name, Array<Name>, Array<TypeField>),

    /** The type's name, its parameters, and its variants, one at a time. */
    Sum(Name, Array<Name>, Array<TypeVariant>),

    /** Something with no shape to report -- a function, a tuple. */
    Other,
}
