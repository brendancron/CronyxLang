/**
 * The comparisons that need no type of their own.
 *
 * Each works on anything implementing `PartialOrd` -- `int`, `float`, a
 * `string`, a `Duration` -- and `abs` on anything that can also be negated.
 *
 * ```
 * import { min, max, abs } from "std/math/Math";
 *
 * print(min(3, 9));   // 3
 * print(abs(0 - 4));  // 4
 * ```
 */

/** Whichever is smaller; the first when they are equal or do not compare. */
fn min<T: PartialOrd>(a: T, b: T): T {
    if (b < a) { return b; }
    return a;
}

/** Whichever is larger; the first when they are equal or do not compare. */
fn max<T: PartialOrd>(a: T, b: T): T {
    if (b > a) { return b; }
    return a;
}

/** The value without its sign: the larger of it and its negation. */
fn abs<T: PartialOrd>(a: T): T {
    return max(a, -a);
}
