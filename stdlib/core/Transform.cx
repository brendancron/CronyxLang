/**
 * What a `run` means. Its body is handed here with the handlers the run binds,
 * and comes back split at each call to an operation that takes control: the
 * rest of the block becomes the continuation handed to that operation's method
 * on the handler's value, and what the method returns is what the run answers.
 * A call to a function that performs such an operation is split the same way,
 * through a copy of the function under a new name, which is handed the
 * handler of every effect it takes control of and then the continuation after
 * its own parameters: one copy serves every run, whichever handles what. A function
 * value whose type takes control is made taking the handler of each such
 * effect and its continuation wherever it is written (`effect_lambda`), so a
 * call through one hands it those. Any other operation is left as written,
 * for the checker to reach through the evidence it binds.
 *
 * A branch holding a split ends by calling what follows it, and a loop holding
 * one is a local function calling itself, so `break` and `continue` are calls
 * too. A `defer` is run by every way out of its scope, the continuations' among
 * them: each continuation first asks whether it was resumed with the
 * discontinue signal, and if so runs the cleanups in scope and hands the signal
 * on. An arm that never names its continuation discontinues it before each
 * way out of the arm. A `return` that leaves the function the run stands in
 * leaves its value in a flag and answers the signal in the run's place; each
 * arm stops once its continuation comes back with the flag set, and the value
 * is returned once the run is done.
 *
 * A run inside the region comes already transformed, as a bound run. One
 * whose code takes control of an effect a run around it handles is made a
 * function value taking those handlers and what follows it (`__tx_prompt`),
 * which is split at like any other; any other inner run holds no call this one
 * splits at but in the methods of handlers that take no control.
 */

import {
    Expr, ExprKind, Stmt, StmtKind, Param, Signature, StaticParam, ValuedBlock, Decl, DeclKind, FnDecl,
    FieldInit, Args, ValuedArm, MatchArm, TypeExpr, TypeKind, Applied, BinOp, UnOp, HandlerClause,
    Operation, operation_of, operation_in, names_function, processed_row, open_type, open_row, plain_marker, cps_marker, handler_param, controls, operations, method_row, bound_arguments, arms_row,
    processed, processed_fn, fresh, declare, declof_call, instance_of, remembered, remember
} from "std/compiler/Ast";

/** Statements, then the value they finish with; none when every path through them returns. */
type Tail {
    stmts: List<Stmt>,
    value: Option<Expr>
}

/**
 * An effect a run inside the region binds through a handler with a value, and
 * the methods of that handler this run splits at: what they perform, they
 * perform outside the run that binds them.
 */
type Held {
    label: Name,
    value: Expr,
    splitting: List<Name>,
    /** For each method in `splitting`, the effects whose handlers it is handed. */
    taking: List<List<Name>>
}

/** The handler an effect this run splits at is reached through: the run's own value, or a parameter it was handed. */
type Handing {
    label: Name,
    handler: Expr
}

/** What a block is transformed under. */
type Cx {
    /** The effects the run binds whose operations take control, less those a run inside binds. */
    bound: List<Applied>,
    /** The handler of each effect in `bound`. */
    handlers: List<Handing>,
    /** What every continuation answers, as written, when it can be. */
    answer: Option<TypeExpr>,
    /** In a function this made, the continuation its `return` hands a value to. */
    ret: Option<Name>,
    /** In a loop holding a split, what `break` and `continue` call. */
    breaks: Option<Name>,
    continues: Option<Name>,
    /** How many of `cleanups` were in scope where that loop began. */
    looped: int,
    /** The `defer`s in scope in this function, innermost first. */
    cleanups: List<Stmt>,
    /** The block finishes with the run's own value, so a `defer` after its last split still runs last. */
    top: bool,
    /** The values of the handlers the runs inside bind, innermost first. */
    held: List<Held>,
    /** What a continuation performs, as written for one this hands on. */
    row: List<Applied>,
    /** At the run's top, where a `return` leaving the function the run stands in leaves its value. */
    leave: Option<Name>,
    /** The effects the runs inside bind: an operation of one is theirs, whatever its arguments. */
    inner: List<Name>,
    /**
     * `ret` is handed on as it is to a call that takes control in tail
     * position: its row is open, where a copy's is settled by the copy's key.
     */
    direct: bool,
    /** In a method of a run that takes control outward, its continuation: a call to it hands on this run's handlers too. */
    resumes: List<Name>
}

/** The run's body, split at each call that takes control, in the run `shell` holds the handlers of. */
fn effect_transform(body: List<Stmt>, value: Option<Expr>, bound: List<Name>, shell: Expr): Expr {
    var typed = processed(ValuedBlock { stmts: body, value: value });
    var outward = __tx_outward(bound);
    if (outward.len() > 0) { return __tx_prompt(typed, bound, shell, outward); }
    var answer = Option.Some(__tx_named("unit"));
    match typed.value {
        Option.Some(v) => { answer = __tx_known(v.ty); }
        _ => {}
    }
    var crossing = __tx_crossing(typed.stmts);
    var leave: Option<Name> = Option.None;
    match crossing {
        Option.Some(_) => { leave = Option.Some(fresh("left")); }
        _ => {}
    }
    var applied = __tx_applied(bound, shell);
    var cx = Cx {
        bound: applied, handlers: __tx_run_handlers(shell), answer: answer, ret: Option.None, breaks: Option.None, continues: Option.None,
        looped: 0, cleanups: [], top: true, held: [], row: __tx_continuation_row(applied, shell), leave: leave, inner: [], direct: false, resumes: []
    };
    var transformed = __tx_expr_of(__tx_block(cx, typed.stmts, 0, (c: Cx) => { return __tx_finish(c, 0, typed.value); }));
    match shell.kind {
        ExprKind.Run(ty, _, clauses) => {
            var run_body = ValuedBlock { stmts: [], value: Option.Some(transformed) };
            var handlers = __tx_discontinuing(clauses);
            match crossing {
                Option.Some(at) => {
                    match leave {
                        Option.Some(left) => {
                            var r = __tx_left_run(left, at, transformed);
                            run_body = r.body;
                            handlers = __tx_cons_clause(r.flag, __tx_stopping(handlers, left));
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            var made = __tx_rebuilt(shell, ExprKind.Run(ty, run_body, handlers));
            return made;
        }
        _ => {}
    }
    return compile_error(shell.span, "A run's handlers come as a run.");
}

/**
 * A function value whose type takes control of `taken`, wherever it is
 * written: after its own parameters it takes the handler of each, then its
 * continuation, and its body is split at each call that takes control of one
 * of them. The type is the one where the value is used, which may take more
 * than its body performs.
 */
fn effect_lambda(lambda: Expr, taken: List<Name>): Expr {
    var typed = processed(ValuedBlock { stmts: [], value: Option.Some(lambda) });
    match typed.value {
        Option.Some(l) => {
            match l.kind {
                ExprKind.Lambda(params, _, body) => {
                    var labels: List<Name> = [];
                    for (n in taken) { labels = __tx_sorted_in(labels, n); }
                    var bound: List<Applied> = [];
                    for (n in labels) {
                        var found = Applied { name: n, args: [] };
                        match l.ty {
                            Option.Some(t) => {
                                match t.kind {
                                    TypeKind.Function(_, _, row) => {
                                        for (a in row) { if (n == a.name) { found = a; } }
                                    }
                                    _ => {}
                                }
                            }
                            _ => {}
                        }
                        bound.push(found);
                    }
                    var k = fresh("k");
                    var cx = Cx {
                        bound: bound, handlers: __tx_own_handlers(labels), answer: Option.None, ret: Option.Some(k),
                        breaks: Option.None, continues: Option.None, looped: 0, cleanups: [], top: false, held: [], row: [],
                        leave: Option.None, inner: [], direct: true, resumes: []
                    };
                    var finish = (c: Cx) => {
                        return __tx_unwind(c, 0, () => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(k)), [Expr.of(ExprKind.Unit)])); });
                    };
                    var made = __tx_body(__tx_block(cx, body, 0, finish));
                    var ps: List<Param> = [];
                    for (p in params) { ps.push(p); }
                    for (n in labels) { ps.push(Param { name: handler_param(n), ty: Option.None, implicit: false }); }
                    ps.push(Param { name: k, ty: Option.None, implicit: false });
                    var written: List<Applied> = [];
                    for (a in bound) { written.push(a); }
                    for (a in __tx_open_row_of(l.ty)) {
                        var known = false;
                        for (b in bound) { if (b.name == a.name) { known = true; } }
                        if (!known) { written.push(a); }
                    }
                    var sg = Signature {
                        ret: Option.None,
                        row: Option.Some(written),
                        static_params: [StaticParam { name: cps_marker(), ty: Option.None, pack: false }]
                    };
                    return Expr { kind: ExprKind.Lambda(ps, sg, made), span: lambda.span, ty: Option.None };
                }
                _ => {}
            }
        }
        _ => {}
    }
    return compile_error(lambda.span, "Only a function value is made taking control.");
}

// ---- a run whose code takes control outward ----

/**
 * The effects that take control which an outer run handles for the run's
 * code, sorted as handlers are handed: what it performs and the run does not
 * bind, and what its methods perform, which stand outside it.
 */
fn __tx_outward(bound: List<Name>): List<Applied> {
    var out: List<Applied> = [];
    for (a in processed_row()) {
        var own = false;
        for (b in bound) { if (b == a.name) { own = true; } }
        if (!own) { out = __tx_outward_add(out, a); }
    }
    for (a in arms_row()) { out = __tx_outward_add(out, a); }
    return out;
}

fn __tx_outward_add(out: List<Applied>, a: Applied): List<Applied> {
    for (o in out) { if (o.name == a.name) { return out; } }
    if (!controls(a.name)) { return out; }
    return __tx_sorted_applied(out, a);
}

fn __tx_sorted_applied(xs: List<Applied>, x: Applied): List<Applied> {
    var out: List<Applied> = [];
    var placed = false;
    for (a in xs) {
        if (!placed && str(x.name) < str(a.name)) {
            out.push(x);
            placed = true;
        }
        out.push(a);
    }
    if (!placed) { out.push(x); }
    return out;
}

fn __tx_names_of(xs: List<Applied>): List<Name> {
    var out: List<Name> = [];
    for (a in xs) { out.push(a.name); }
    return out;
}

/**
 * A run whose code takes control of effects an outer run handles, made a
 * function value taking their handlers and what follows the run, so whatever
 * splits the code around it splits at it. Its body is split at every call
 * that takes control, its own effects' or the outer ones'. What the run
 * answers is handed to `answer`, which starts as what follows the run: a
 * method of the run reads it on the way in and answers through it, and its
 * continuation sets it to what follows the call that resumes it. Each outer
 * handler is wrapped to put it back as it was when its operation was
 * performed, since a method of the run may have moved it before that
 * continuation is resumed.
 */
fn __tx_prompt(typed: ValuedBlock, bound: List<Name>, shell: Expr, outward: List<Applied>): Expr {
    match __tx_crossing(typed.stmts) {
        Option.Some(at) => {
            return compile_error(at.span, "A 'return' out of the function a 'run' stands in, from a run whose code takes control of an effect another run handles, is not supported yet.");
        }
        _ => {}
    }
    match shell.kind {
        ExprKind.Run(ty, _, clauses) => {
            var answer = fresh("answer");
            var after = fresh("k");
            var outer = __tx_names_of(outward);
            var made: List<Stmt> = [Stmt.of(StmtKind.Let(answer, Option.None, Option.Some(__tx_var(after))))];
            var handlers: List<Handing> = [];
            for (m in __tx_prompt_methods(__tx_discontinuing(clauses), bound, outward, answer, shell.span)) {
                made.push(m.decl);
                handlers.push(Handing { label: m.label, handler: __tx_var(m.name) });
            }
            // An effect the run binds is its own in its body, though its methods perform it outward.
            for (l in outer) {
                var own = false;
                for (b in bound) { if (b == l) { own = true; } }
                if (!own) {
                    var w = fresh("hv");
                    made.push(Stmt.of(StmtKind.Let(w, Option.Some(TypeExpr.of(TypeKind.Named(open_type()))), Option.Some(__tx_wrapped(l, answer)))));
                    handlers.push(Handing { label: l, handler: __tx_var(w) });
                }
            }
            var all = __tx_applied(bound, shell);
            for (a in outward) { all.push(a); }
            var cx = Cx {
                bound: all, handlers: handlers, answer: Option.None, ret: Option.Some(answer), breaks: Option.None, continues: Option.None,
                looped: 0, cleanups: [], top: false, held: [], row: [], leave: Option.None, inner: [], direct: false, resumes: []
            };
            var answered = __tx_var(answer);
            var finish = (c: Cx) => {
                match typed.value {
                    Option.Some(v) => {
                        return __tx_anf(c, v, (x: Expr) => {
                            return __tx_leave_with(c, 0, x, (held: Expr) => { return __tx_tail([], __tx_call(answered, [held])); });
                        });
                    }
                    _ => { return __tx_unwind(c, 0, () => { return __tx_tail([], __tx_call(answered, [Expr.of(ExprKind.Unit)])); }); }
                }
            };
            for (st in __tx_body(__tx_block(cx, typed.stmts, 0, finish))) { made.push(st); }
            var params: List<Param> = [];
            for (l in outer) { params.push(Param { name: handler_param(l), ty: Option.None, implicit: false }); }
            params.push(Param { name: after, ty: Option.None, implicit: false });
            var prompt = Expr.of(ExprKind.Lambda(params, __tx_made_sg(outward, true), made));
            var run_body = ValuedBlock { stmts: [], value: Option.Some(__tx_call(prompt, [])) };
            return __tx_rebuilt(shell, ExprKind.Run(ty, run_body, __tx_unmarked_clauses(clauses, bound)));
        }
        _ => {}
    }
    return compile_error(shell.span, "A run's handlers come as a run.");
}

/**
 * The run's values once its methods that take control are made inside its
 * body: what is left is what an operation taking no control reaches, or no
 * value where that is nothing.
 */
fn __tx_unmarked_clauses(clauses: List<HandlerClause>, bound: List<Name>): List<HandlerClause> {
    var out: List<HandlerClause> = [];
    for (c in clauses) {
        match c {
            HandlerClause.Bound(label, h, value) => {
                var own = false;
                for (b in bound) { if (b == label) { own = true; } }
                var kept = __tx_unmarked_value(label, value);
                if (own) { out.push(HandlerClause.Bound(label, h, kept)); } else { out.push(c); }
            }
            _ => { out.push(c); }
        }
    }
    return out;
}

fn __tx_unmarked_value(label: Name, value: Option<Stmt>): Option<Stmt> {
    match value {
        Option.Some(st) => {
            match st.kind {
                StmtKind.Let(hv, ty, init) => {
                    match init {
                        Option.Some(record) => {
                            match record.kind {
                                ExprKind.Record(fields) => {
                                    var kept: List<FieldInit> = [];
                                    for (f in fields) {
                                        var control = false;
                                        match operation_in(label, f.name) {
                                            Option.Some(op) => { control = op.takes_control; }
                                            _ => {}
                                        }
                                        if (!control) { kept.push(f); }
                                    }
                                    if (kept.len() == 0) { return Option.None; }
                                    var made = __tx_rebuilt(record, ExprKind.Record(kept));
                                    return Option.Some(__tx_restmt(st, StmtKind.Let(hv, ty, Option.Some(made))));
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return value;
}

/**
 * A function the transform makes taking the handlers of `row`'s effects and a
 * continuation. A plain one is part of the function it stands in, and answers
 * what the function value taking control around it does.
 */
fn __tx_made_sg(row: List<Applied>, plain: bool): Signature {
    var written: List<Applied> = [];
    for (a in row) { written.push(a); }
    written.push(Applied { name: open_row(), args: [] });
    var marks = [StaticParam { name: cps_marker(), ty: Option.None, pack: false }];
    if (plain) { marks.push(StaticParam { name: plain_marker(), ty: Option.None, pack: false }); }
    return Signature { ret: Option.None, row: Option.Some(written), static_params: marks };
}

/** Whether a bound run's body is a run made a function value taking control outward. */
fn __tx_is_prompt(body: ValuedBlock): bool {
    if (body.stmts.len() > 0) { return false; }
    match body.value {
        Option.Some(v) => {
            match v.kind {
                ExprKind.Call(f, _) => {
                    match f.kind {
                        ExprKind.Lambda(_, sg, _) => { return __tx_is_cps(sg); }
                        _ => { return false; }
                    }
                }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

fn __tx_is_cps(sg: Signature): bool {
    for (p in sg.static_params) { if (p.name == cps_marker()) { return true; } }
    return false;
}

fn __tx_var(n: Name): Expr { return Expr.of(ExprKind.Var(n)); }

fn __tx_params(names: List<Name>): List<Param> {
    var out: List<Param> = [];
    for (n in names) { out.push(Param { name: n, ty: Option.None, implicit: false }); }
    return out;
}

fn __tx_args(names: List<Name>): List<Expr> {
    var out: List<Expr> = [];
    for (n in names) { out.push(__tx_var(n)); }
    return out;
}

/** The outer handler of `label` as the run's code is handed it: each method that takes control puts `answer` back when it resumes. */
fn __tx_wrapped(label: Name, answer: Name): Expr {
    var h = __tx_var(handler_param(label));
    var fields: List<FieldInit> = [];
    for (op in operations(label)) {
        var names: List<Name> = [];
        for (var i = 0; i < op.arity; i += 1) { names.push(fresh("a")); }
        var method = Expr.of(ExprKind.Field(h, op.name));
        if (op.takes_control) {
            var k = fresh("k");
            var saved = fresh("answer");
            var x = fresh("x");
            var put_back = Stmt.of(StmtKind.Expression(Expr.of(ExprKind.Assign(answer, __tx_var(saved)))));
            var resumed = __tx_lambda(__tx_params([x]), [put_back, __tx_return_call(__tx_var(k), __tx_var(x))]);
            var ps = __tx_params(names);
            ps.push(Param { name: k, ty: Option.None, implicit: false });
            var body = [
                Stmt.of(StmtKind.Let(saved, Option.None, Option.Some(__tx_var(answer)))),
                Stmt.of(StmtKind.Return(Option.Some(__tx_call(method, __tx_snoc(__tx_args(names), resumed)))))
            ];
            fields.push(FieldInit { name: op.name, value: __tx_lambda(ps, body) });
        } else {
            fields.push(FieldInit { name: op.name, value: __tx_lambda(__tx_params(names), [Stmt.of(StmtKind.Return(Option.Some(__tx_call(method, __tx_args(names)))))]) });
        }
    }
    return Expr.of(ExprKind.Record(fields));
}

/** A handler of the run's own, as its body is handed it. */
type PromptMethods {
    label: Name,
    name: Name,
    decl: Stmt
}

/**
 * The run's handlers of effects that take control, each a record of its
 * methods made taking control outward. A method stands outside the run, so
 * the outer handlers it is handed are those around the run, unwrapped.
 */
fn __tx_prompt_methods(clauses: List<HandlerClause>, bound: List<Name>, outward: List<Applied>, answer: Name, span: Span): List<PromptMethods> {
    var typed = processed(ValuedBlock { stmts: [], value: Option.Some(Expr.of(ExprKind.Run(Option.None, ValuedBlock { stmts: [], value: Option.None }, clauses))) });
    var checked = clauses;
    match typed.value {
        Option.Some(r) => {
            match r.kind {
                ExprKind.Run(_, _, cs) => { checked = cs; }
                _ => {}
            }
        }
        _ => {}
    }
    var out: List<PromptMethods> = [];
    for (c in checked) {
        match c {
            HandlerClause.Bound(label, _, value) => {
                var own = false;
                for (b in bound) { if (b == label) { own = true; } }
                match value {
                    Option.Some(st) => {
                        match st.kind {
                            StmtKind.Let(hv, _, init) => {
                                match init {
                                    Option.Some(record) => {
                                        match record.kind {
                                            ExprKind.Record(fields) => {
                                                if (own) {
                                                    var made: List<FieldInit> = [];
                                                    for (f in fields) { made.push(FieldInit { name: f.name, value: __tx_prompt_method(label, hv, f, outward, answer, span) }); }
                                                    var name = fresh("hv");
                                                    out.push(PromptMethods { label: label, name: name, decl: Stmt.of(StmtKind.Let(name, Option.None, Option.Some(Expr.of(ExprKind.Record(made))))) });
                                                }
                                            }
                                            _ => {}
                                        }
                                    }
                                    _ => {}
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }
    return out;
}

/**
 * One method of the run's own handler. One that takes no control calls the
 * run's value. One that does reads where the run's answer goes on the way in
 * and answers through it, and calls its continuation as a function taking
 * control outward, which sets where the answer goes to what follows that call.
 */
fn __tx_prompt_method(label: Name, hv: Name, f: FieldInit, outward: List<Applied>, answer: Name, span: Span): Expr {
    var control = false;
    match operation_in(label, f.name) {
        Option.Some(op) => { control = op.takes_control; }
        _ => {}
    }
    match f.value.kind {
        ExprKind.Lambda(params, _, body) => {
            if (!control) {
                var names: List<Name> = [];
                for (p in params) { names.push(fresh("a")); }
                var method = Expr.of(ExprKind.Field(__tx_var(hv), f.name));
                return __tx_lambda(__tx_params(names), [Stmt.of(StmtKind.Return(Option.Some(__tx_call(method, __tx_args(names)))))]);
            }
            if (__tx_named_method(body)) {
                return compile_error(span, "A named handler of '" + str(label) + "' in a run whose code takes control of an effect another run handles is not supported yet.");
            }
            var resume = params[params.len() - 1].name;
            var given = fresh("k");
            var entered = fresh("answer");
            var outer = __tx_names_of(outward);
            var x = fresh("x");
            var then = fresh("k");
            var cps_params = __tx_params([x]);
            for (l in outer) { cps_params.push(Param { name: handler_param(l), ty: Option.None, implicit: false }); }
            cps_params.push(Param { name: then, ty: Option.None, implicit: false });
            var continuation = Expr.of(ExprKind.Lambda(cps_params, __tx_made_sg(outward, true), [
                Stmt.of(StmtKind.Expression(Expr.of(ExprKind.Assign(answer, __tx_var(then))))),
                __tx_return_call(__tx_var(given), __tx_var(x))
            ]));
            var handlers: List<Handing> = [];
            for (l in outer) { handlers.push(Handing { label: l, handler: __tx_var(handler_param(l)) }); }
            var cx = Cx {
                bound: outward, handlers: handlers, answer: Option.None, ret: Option.Some(entered), breaks: Option.None, continues: Option.None,
                looped: 0, cleanups: [], top: false, held: [], row: [], leave: Option.None, inner: [], direct: false, resumes: [resume]
            };
            var finish = (c: Cx) => {
                return __tx_unwind(c, 0, () => { return __tx_tail([], __tx_call(__tx_var(entered), [Expr.of(ExprKind.Unit)])); });
            };
            var made = [
                Stmt.of(StmtKind.Let(entered, Option.None, Option.Some(__tx_var(answer)))),
                Stmt.of(StmtKind.Let(resume, Option.None, Option.Some(continuation)))
            ];
            for (st in __tx_body(__tx_block(cx, body, 0, finish))) { made.push(st); }
            var ps: List<Param> = [];
            for (var i = 0; i < params.len() - 1; i += 1) { ps.push(__tx_typed_param(params[i], f.value.ty, i)); }
            ps.push(Param { name: given, ty: Option.None, implicit: false });
            return __tx_lambda(ps, made);
        }
        _ => {}
    }
    return f.value;
}

/** Whether a method is a named handler's, which calls the operation itself for its impl to answer. */
fn __tx_named_method(body: List<Stmt>): bool {
    if (body.len() != 1) { return false; }
    match body[0].kind {
        StmtKind.Return(value) => {
            match value {
                Option.Some(e) => {
                    match e.kind {
                        ExprKind.Call(f, _) => {
                            match operation_of(f) {
                                Option.Some(_) => { return true; }
                                _ => { return false; }
                            }
                        }
                        _ => { return false; }
                    }
                }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

/** Whether `f` is the continuation of a method this makes taking control outward. */
fn __tx_resumes(cx: Cx, f: Expr): bool {
    match f.kind {
        ExprKind.Var(n) => {
            for (r in cx.resumes) { if (r == n) { return true; } }
            return false;
        }
        _ => { return false; }
    }
}

// ---- a `return` that leaves the function the run stands in ----

/** The flag a crossing `return` leaves its value in, and the run's body that returns it once the run is done. */
type Left {
    flag: HandlerClause,
    body: ValuedBlock
}

/** The first `return` in the run's own code, outside a function value: what it returns says what the flag holds. */
fn __tx_crossing(ss: List<Stmt>): Option<Stmt> {
    for (s in ss) {
        match __tx_crossing_stmt(s) {
            Option.Some(r) => { return Option.Some(r); }
            _ => {}
        }
    }
    return Option.None;
}

fn __tx_crossing_stmt(s: Stmt): Option<Stmt> {
    match s.kind {
        StmtKind.Return(_) => { return Option.Some(s); }
        StmtKind.Block(ss) => { return __tx_crossing(ss); }
        StmtKind.If(_, t, e) => {
            match __tx_crossing_stmt(t) {
                Option.Some(r) => { return Option.Some(r); }
                _ => {}
            }
            match e {
                Option.Some(x) => { return __tx_crossing_stmt(x); }
                _ => { return Option.None; }
            }
        }
        StmtKind.While(_, b) => { return __tx_crossing_stmt(b); }
        StmtKind.ForIn(_, _, b) => { return __tx_crossing_stmt(b); }
        StmtKind.Match(_, arms) => {
            for (a in arms) {
                match __tx_crossing(a.body) {
                    Option.Some(r) => { return Option.Some(r); }
                    _ => {}
                }
            }
            return Option.None;
        }
        StmtKind.Expression(e) => {
            match e.kind {
                ExprKind.Run(_, body, clauses) => {
                    if (__tx_is_bound(clauses)) { return __tx_crossing(body.stmts); }
                    return Option.None;
                }
                _ => { return Option.None; }
            }
        }
        _ => { return Option.None; }
    }
}

/**
 * The run's body once a `return` may leave through it: the transformed body's
 * answer is held, and what the flag holds, once it holds a value rather than
 * the discontinue signal it starts as, is returned from the function the run
 * stands in. A bound run's body is not a function of its own, so the `return`
 * there is that function's.
 */
fn __tx_left_run(left: Name, crossing: Stmt, transformed: Expr): Left {
    var held: Option<TypeExpr> = Option.Some(__tx_named("unit"));
    match crossing.kind {
        StmtKind.Return(value) => {
            match value {
                Option.Some(v) => { held = v.ty; }
                _ => {}
            }
        }
        _ => {}
    }
    var decl = Stmt.of(StmtKind.Let(left, held, Option.Some(__tx_signal())));
    var answer = fresh("answer");
    var leaving = Stmt.of(StmtKind.If(__tx_holds(left), __tx_block_stmt([Stmt.of(StmtKind.Return(Option.Some(Expr.of(ExprKind.Var(left)))))]), Option.None));
    var body = ValuedBlock {
        stmts: [Stmt.of(StmtKind.Let(answer, Option.None, Option.Some(transformed))), leaving],
        value: Option.Some(Expr.of(ExprKind.Var(answer)))
    };
    return Left { flag: HandlerClause.Bound(left, left, Option.Some(decl)), body: body };
}

fn __tx_signal(): Expr { return __tx_call(Expr.of(ExprKind.Var("__discontinued".as_name())), []); }

/** Whether the flag holds what a `return` left in it. */
fn __tx_holds(left: Name): Expr {
    var test = __tx_call(Expr.of(ExprKind.Var("__is_discontinued".as_name())), [Expr.of(ExprKind.Var(left))]);
    return Expr.of(ExprKind.Unary(UnOp.Not, test));
}

/** A crossing `return`: its value left in the flag, the run's `defer`s run, and the signal answered in the run's place. */
fn __tx_leaving(cx: Cx, left: Name, v: Expr): Tail {
    var set = Stmt.of(StmtKind.Expression(Expr.of(ExprKind.Assign(left, v))));
    return __tx_prepend([set], __tx_unwind(cx, 0, () => { return __tx_tail([], __tx_signal()); }));
}

/** The run's methods, each stopping once its continuation comes back with the flag set. */
fn __tx_stopping(clauses: List<HandlerClause>, left: Name): List<HandlerClause> {
    var out: List<HandlerClause> = [];
    for (c in clauses) {
        match c {
            HandlerClause.Bound(label, h, value) => {
                match value {
                    Option.Some(s) => {
                        match s.kind {
                            StmtKind.Let(hv, ty, init) => {
                                match init {
                                    Option.Some(record) => {
                                        match record.kind {
                                            ExprKind.Record(fields) => {
                                                var methods: List<FieldInit> = [];
                                                for (f in fields) {
                                                    methods.push(FieldInit { name: f.name, value: __tx_stopping_method(label, f.name, f.value, left) });
                                                }
                                                var made = __tx_rebuilt(record, ExprKind.Record(methods));
                                                out.push(HandlerClause.Bound(label, h, Option.Some(__tx_restmt(s, StmtKind.Let(hv, ty, Option.Some(made))))));
                                            }
                                            _ => { out.push(c); }
                                        }
                                    }
                                    _ => { out.push(c); }
                                }
                            }
                            _ => { out.push(c); }
                        }
                    }
                    _ => { out.push(c); }
                }
            }
            _ => { out.push(c); }
        }
    }
    return out;
}

fn __tx_stopping_method(label: Name, method: Name, m: Expr, left: Name): Expr {
    match operation_in(label, method) {
        Option.Some(op) => {
            if (!op.takes_control) { return m; }
        }
        _ => { return m; }
    }
    match m.kind {
        ExprKind.Lambda(params, sg, body) => {
            if (params.len() == 0) { return m; }
            var k = params[params.len() - 1].name;
            return __tx_rebuilt(m, ExprKind.Lambda(params, sg, __tx_stopped(body, k, left)));
        }
        _ => { return m; }
    }
}

/** Statements of an arm, each that resumes followed by the test of the flag. */
fn __tx_stopped(ss: List<Stmt>, k: Name, left: Name): List<Stmt> {
    var out: List<Stmt> = [];
    for (s in ss) {
        match s.kind {
            StmtKind.Return(_) => { out.push(s); }
            StmtKind.Block(inner) => { out.push(__tx_restmt(s, StmtKind.Block(__tx_stopped(inner, k, left)))); }
            StmtKind.If(c, t, e) => {
                var otherwise: Option<Stmt> = Option.None;
                match e {
                    Option.Some(x) => { otherwise = Option.Some(__tx_block_stmt(__tx_stopped([x], k, left))); }
                    _ => {}
                }
                out.push(__tx_restmt(s, StmtKind.If(c, __tx_block_stmt(__tx_stopped([t], k, left)), otherwise)));
            }
            StmtKind.While(c, b) => { out.push(__tx_restmt(s, StmtKind.While(c, __tx_block_stmt(__tx_stopped([b], k, left))))); }
            StmtKind.ForIn(ns, over, b) => { out.push(__tx_restmt(s, StmtKind.ForIn(ns, over, __tx_block_stmt(__tx_stopped([b], k, left))))); }
            _ => {
                out.push(s);
                if (__tx_mentions_stmt(s, k)) { out.push(__tx_stop_test(left)); }
            }
        }
    }
    return out;
}

fn __tx_stop_test(left: Name): Stmt {
    return Stmt.of(StmtKind.If(__tx_holds(left), __tx_block_stmt([Stmt.of(StmtKind.Return(Option.Some(__tx_signal())))]), Option.None));
}

fn __tx_cons_clause(c: HandlerClause, cs: List<HandlerClause>): List<HandlerClause> {
    var out = [c];
    for (x in cs) { out.push(x); }
    return out;
}

// ---- contexts ----

/** Each effect the run binds, at the arguments its clause binds it at. */
fn __tx_applied(bound: List<Name>, shell: Expr): List<Applied> {
    var out: List<Applied> = [];
    for (label in bound) {
        var args: List<TypeExpr> = [];
        match shell.kind {
            ExprKind.Run(_, _, clauses) => {
                for (c in clauses) {
                    match c {
                        HandlerClause.Bound(l, h, _) => { if (l == label) { args = bound_arguments(h, l); } }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        out.push(Applied { name: label, args: args });
    }
    return out;
}

/** Each effect the run binds, and the value of its handler where the run stands. */
fn __tx_run_handlers(shell: Expr): List<Handing> {
    var out: List<Handing> = [];
    match shell.kind {
        ExprKind.Run(_, _, clauses) => {
            for (c in clauses) {
                match c {
                    HandlerClause.Bound(label, _, value) => {
                        match value {
                            Option.Some(s) => {
                                match s.kind {
                                    StmtKind.Let(hv, _, _) => { out.push(Handing { label: label, handler: Expr.of(ExprKind.Var(hv)) }); }
                                    _ => {}
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    return out;
}

/** The handler of `label` where `cx` stands. */
fn __tx_handler(cx: Cx, label: Name): Option<Expr> {
    for (h in cx.handlers) { if (h.label == label) { return Option.Some(h.handler); } }
    return Option.None;
}

/** Handlers a function takes control through, one per effect, each its own parameter. */
fn __tx_own_handlers(labels: List<Name>): List<Handing> {
    var out: List<Handing> = [];
    for (l in labels) { out.push(Handing { label: l, handler: Expr.of(ExprKind.Var(handler_param(l))) }); }
    return out;
}

/**
 * What a continuation of the run performs: what the rest of its body and its
 * methods do, the run's own effects among them, since an operation handed its
 * continuation keeps its effect.
 */
fn __tx_continuation_row(bound: List<Applied>, shell: Expr): List<Applied> {
    var out: List<Applied> = [];
    for (a in processed_row()) {
        var handed = false;
        for (b in bound) { if (__tx_same_effect(a, b) && __tx_has_value(shell, b.name)) { handed = true; } }
        if (!handed) { out.push(a); }
    }
    return out;
}

/** Whether the run binds the effect through a handler of its own, whose method a call handed its continuation calls in the effect's place. */
fn __tx_has_value(shell: Expr, label: Name): bool {
    match shell.kind {
        ExprKind.Run(_, _, clauses) => {
            for (c in clauses) {
                match c {
                    HandlerClause.Bound(l, _, value) => {
                        if (l == label) {
                            match value {
                                Option.Some(_) => { return true; }
                                _ => { return false; }
                            }
                        }
                    }
                    _ => {}
                }
            }
            return false;
        }
        _ => { return false; }
    }
}

fn __tx_same_type(a: TypeExpr, b: TypeExpr): bool {
    match a.kind {
        TypeKind.Named(x) => {
            match b.kind {
                TypeKind.Named(y) => { return x == y; }
                _ => { return false; }
            }
        }
        TypeKind.Applied(x, xs) => {
            match b.kind {
                TypeKind.Applied(y, ys) => { return x == y && __tx_same_types(xs, ys); }
                _ => { return false; }
            }
        }
        TypeKind.Tuple(xs) => {
            match b.kind {
                TypeKind.Tuple(ys) => { return __tx_same_types(xs, ys); }
                _ => { return false; }
            }
        }
        TypeKind.Function(xs, x, _) => {
            match b.kind {
                TypeKind.Function(ys, y, _) => { return __tx_same_types(xs, ys) && __tx_same_type(x, y); }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

fn __tx_same_types(xs: List<TypeExpr>, ys: List<TypeExpr>): bool {
    if (xs.len() != ys.len()) { return false; }
    for (var i = 0; i < xs.len(); i += 1) { if (!__tx_same_type(xs[i], ys[i])) { return false; } }
    return true;
}

/** Two effects in rows the same, as far as is known: where either one's arguments are not, the name says. */
fn __tx_same_effect(a: Applied, b: Applied): bool {
    if (a.name != b.name) { return false; }
    if (a.args.len() == 0 || b.args.len() == 0) { return true; }
    if (a.args.len() != b.args.len()) { return false; }
    for (var i = 0; i < a.args.len(); i += 1) {
        if (!__tx_same_type(a.args[i], b.args[i])) { return false; }
    }
    return true;
}

fn __tx_cx(cx: Cx, ret: Option<Name>, breaks: Option<Name>, continues: Option<Name>, looped: int, cleanups: List<Stmt>): Cx {
    return Cx {
        bound: cx.bound, handlers: cx.handlers, answer: cx.answer, ret: ret, breaks: breaks, continues: continues,
        looped: looped, cleanups: cleanups, top: false, held: cx.held, row: cx.row, leave: cx.leave, inner: cx.inner, direct: cx.direct, resumes: cx.resumes
    };
}

fn __tx_branch_cx(cx: Cx): Cx { return __tx_cx(cx, cx.ret, cx.breaks, cx.continues, cx.looped, cx.cleanups); }

fn __tx_loop_cx(cx: Cx, breaks: Name, continues: Name): Cx {
    return __tx_cx(cx, cx.ret, Option.Some(breaks), Option.Some(continues), cx.cleanups.len(), cx.cleanups);
}

fn __tx_deferred_cx(cx: Cx, d: Stmt): Cx {
    var cleanups = [d];
    for (c in cx.cleanups) { cleanups.push(c); }
    return __tx_cx(cx, cx.ret, cx.breaks, cx.continues, cx.looped, cleanups);
}

/** A function this makes, handing what it returns to `ret`. */
fn __tx_fn_cx(cx: Cx, ret: Name, answer: Option<TypeExpr>, row: List<Applied>, direct: bool): Cx {
    return Cx {
        bound: cx.bound, handlers: cx.handlers, answer: answer, ret: Option.Some(ret), breaks: Option.None, continues: Option.None,
        looped: 0, cleanups: [], top: false, held: cx.held, row: row, leave: Option.None, inner: cx.inner, direct: direct, resumes: cx.resumes
    };
}

/** Inside a bound run: what it binds is its own, and its values are what a call it binds is redirected through. */
fn __tx_inside_run(cx: Cx, clauses: List<HandlerClause>): Cx {
    var bound: List<Applied> = [];
    for (b in cx.bound) {
        var claimed = false;
        for (c in clauses) {
            match c {
                HandlerClause.Bound(label, h, _) => {
                    if (__tx_same_effect(b, Applied { name: label, args: bound_arguments(h, label) })) { claimed = true; }
                }
                _ => {}
            }
        }
        if (!claimed) { bound.push(b); }
    }
    var held: List<Held> = [];
    for (c in clauses) {
        match c {
            HandlerClause.Bound(label, _, value) => {
                match value {
                    Option.Some(s) => {
                        match s.kind {
                            StmtKind.Let(hv, _, init) => {
                                var splitting: List<Name> = [];
                                var taking: List<List<Name>> = [];
                                match init {
                                    Option.Some(record) => {
                                        match record.kind {
                                            ExprKind.Record(fields) => {
                                                for (f in fields) {
                                                    if (__tx_takes_continuation(cx, f.value)) {
                                                        splitting.push(f.name);
                                                        taking.push(__tx_ctl_labels(f.value.ty));
                                                    }
                                                }
                                            }
                                            _ => {}
                                        }
                                    }
                                    _ => {}
                                }
                                held.push(Held { label: label, value: Expr.of(ExprKind.Var(hv)), splitting: splitting, taking: taking });
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }
    for (h in cx.held) { held.push(h); }
    var inner: List<Name> = [];
    for (c in clauses) {
        match c {
            HandlerClause.Bound(label, _, _) => { inner.push(label); }
            _ => {}
        }
    }
    for (n in cx.inner) { inner.push(n); }
    return Cx {
        bound: bound, handlers: cx.handlers, answer: cx.answer, ret: cx.ret, breaks: cx.breaks, continues: cx.continues,
        looped: cx.looped, cleanups: cx.cleanups, top: false, held: held, row: cx.row, leave: cx.leave, inner: inner, direct: cx.direct, resumes: cx.resumes
    };
}

// ---- statements ----

fn __tx_block(cx: Cx, ss: List<Stmt>, i: int, finish: (Cx) -> Tail): Tail {
    if (i == ss.len()) { return finish(cx); }
    var s = ss[i];
    var rest = (c: Cx) => { return __tx_block(c, ss, i + 1, finish); };
    match s.kind {
        StmtKind.Return(value) => { return __tx_return(cx, s, value); }
        StmtKind.Break => { return __tx_jump(cx, s, cx.breaks); }
        StmtKind.Continue => { return __tx_jump(cx, s, cx.continues); }
        StmtKind.Defer(d) => {
            if (!cx.top || cx.cleanups.len() > 0 || __tx_splits_from(cx, ss, i + 1)) {
                return rest(__tx_deferred_cx(cx, d));
            }
        }
        _ => {}
    }
    if (!__tx_stmt_splits(cx, s)) {
        var plain = __tx_plain(cx, s);
        if (__tx_leaves(s)) { return __tx_done([plain]); }
        return __tx_prepend([plain], rest(cx));
    }
    match s.kind {
        StmtKind.Expression(e) => {
            return __tx_anf(cx, e, (v: Expr) => { return __tx_prepend(__tx_evaluated(v), rest(cx)); });
        }
        StmtKind.Let(x, ty, init) => {
            match init {
                Option.Some(e) => {
                    if (__tx_is_direct(cx, e)) {
                        var written = e.ty;
                        match ty {
                            Option.Some(_) => { written = ty; }
                            _ => {}
                        }
                        return __tx_split(cx, __tx_args_valued(cx, e), Param { name: x, ty: __tx_written(cx, written), implicit: false }, () => { return rest(cx); });
                    }
                    return __tx_anf(cx, e, (v: Expr) => {
                        return __tx_prepend([__tx_restmt(s, StmtKind.Let(x, __tx_written(cx, ty), Option.Some(v)))], rest(cx));
                    });
                }
                _ => {}
            }
        }
        StmtKind.LetTuple(xs, e) => {
            return __tx_anf(cx, e, (v: Expr) => {
                return __tx_prepend([__tx_restmt(s, StmtKind.LetTuple(xs, v))], rest(cx));
            });
        }
        StmtKind.Block(body) => {
            return __tx_joined(cx, s, rest, (after: () -> Tail) => { return __tx_branch(cx, body, after); });
        }
        StmtKind.If(c, t, e) => {
            return __tx_joined(cx, s, rest, (after: () -> Tail) => {
                return __tx_anf(cx, c, (cv: Expr) => {
                    var otherwise = __tx_body(after());
                    match e {
                        Option.Some(x) => { otherwise = __tx_body(__tx_branch(cx, __tx_stmts_of(x), after)); }
                        _ => {}
                    }
                    var then = __tx_body(__tx_branch(cx, __tx_stmts_of(t), after));
                    var branched = __tx_restmt(s, StmtKind.If(cv, __tx_block_stmt(then), Option.Some(__tx_block_stmt(otherwise))));
                    return __tx_done([branched]);
                });
            });
        }
        StmtKind.Match(x, arms) => {
            return __tx_joined(cx, s, rest, (after: () -> Tail) => {
                return __tx_anf(cx, x, (xv: Expr) => {
                    var out: List<MatchArm> = [];
                    for (a in arms) {
                        out.push(MatchArm { pattern: a.pattern, body: __tx_body(__tx_branch(cx, a.body, after)) });
                    }
                    return __tx_prepend([__tx_restmt(s, StmtKind.Match(xv, out))], after());
                });
            });
        }
        StmtKind.While(c, body) => { return __tx_loop(cx, s, [], c, __tx_stmts_of(body), () => { return rest(cx); }); }
        StmtKind.ForIn(names, over, body) => { return __tx_for_in(cx, s, names, over, body, () => { return rest(cx); }); }
        StmtKind.Declare(d) => { return __tx_prepend([__tx_local_fn(cx, s, d)], rest(cx)); }
        _ => {}
    }
    return compile_error(s.span, __tx_unsupported(cx, s));
}

/** `ss` as a branch, carrying on with what `after` makes once its own `defer`s have run. */
fn __tx_branch(cx: Cx, ss: List<Stmt>, after: () -> Tail): Tail {
    var base = cx.cleanups.len();
    return __tx_block(__tx_branch_cx(cx), ss, 0, (c: Cx) => { return __tx_unwind(c, base, after); });
}

/** What a scope's `defer`s since `base` do before `exit` leaves it. */
fn __tx_unwind(cx: Cx, base: int, exit: () -> Tail): Tail {
    var count = cx.cleanups.len() - base;
    if (count <= 0) { return exit(); }
    var leaving: List<Stmt> = [];
    for (var n = 0; n < count; n += 1) { leaving.push(cx.cleanups[n]); }
    var kept: List<Stmt> = [];
    for (var n = count; n < cx.cleanups.len(); n += 1) { kept.push(cx.cleanups[n]); }
    var after = __tx_cx(cx, cx.ret, cx.breaks, cx.continues, cx.looped, kept);
    return __tx_block(after, leaving, 0, (c: Cx) => { return exit(); });
}

/** The run's value, or a function's end: evaluated in its scope, which is left after. */
fn __tx_finish(cx: Cx, base: int, value: Option<Expr>): Tail {
    match value {
        Option.Some(e) => {
            return __tx_anf(cx, e, (v: Expr) => {
                return __tx_leave_with(cx, base, v, (held: Expr) => { return __tx_tail([], held); });
            });
        }
        _ => { return __tx_unwind(cx, base, () => { return __tx_tail([], Expr.of(ExprKind.Unit)); }); }
    }
}

/** `v`, already evaluated, handed to `exit` once the `defer`s since `base` have run. */
fn __tx_leave_with(cx: Cx, base: int, v: Expr, exit: (Expr) -> Tail): Tail {
    if (cx.cleanups.len() <= base || __tx_literal(v)) {
        return __tx_unwind(cx, base, () => { return exit(v); });
    }
    var t = fresh("t");
    var held = Expr { kind: ExprKind.Var(t), span: v.span, ty: v.ty };
    return __tx_prepend([Stmt.of(StmtKind.Let(t, Option.None, Option.Some(v)))], __tx_unwind(cx, base, () => { return exit(held); }));
}

/**
 * What follows a statement, as a function each of the statement's branches
 * ends by calling. A statement every path of which leaves has nothing after
 * it to call.
 */
fn __tx_joined(cx: Cx, s: Stmt, rest: (Cx) -> Tail, branch: (() -> Tail) -> Tail): Tail {
    if (__tx_leaves(s)) { return branch(() => { return __tx_done([]); }); }
    var j = fresh("join");
    var u = Param { name: fresh("u"), ty: Option.Some(__tx_named("unit")), implicit: false };
    var joined = __tx_lambda([u], __tx_body(rest(cx)));
    var after = () => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(j)), [Expr.of(ExprKind.Unit)])); };
    return __tx_prepend([Stmt.of(StmtKind.Let(j, Option.None, Option.Some(joined)))], branch(after));
}

/** Whether every path through `s` ends in a `return`, `break` or `continue`. */
fn __tx_leaves(s: Stmt): bool {
    match s.kind {
        StmtKind.Return(_) => { return true; }
        StmtKind.Break => { return true; }
        StmtKind.Continue => { return true; }
        StmtKind.Block(ss) => {
            for (x in ss) { if (__tx_leaves(x)) { return true; } }
            return false;
        }
        StmtKind.If(_, t, e) => {
            match e {
                Option.Some(x) => { return __tx_leaves(t) && __tx_leaves(x); }
                _ => { return false; }
            }
        }
        StmtKind.Match(_, arms) => {
            for (a in arms) {
                if (!__tx_leaves(__tx_block_stmt(a.body))) { return false; }
            }
            return arms.len() > 0;
        }
        _ => { return false; }
    }
}

/** A loop holding a split: a function that tests the condition, runs the body and calls itself. */
fn __tx_loop(cx: Cx, s: Stmt, before: List<Stmt>, c: Expr, body: List<Stmt>, rest: () -> Tail): Tail {
    var after = fresh("after");
    var again = fresh("loop");
    var inner = __tx_loop_cx(cx, after, again);
    var base = cx.cleanups.len();
    var unit = Expr.of(ExprKind.Unit);
    var looped = () => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(again)), [unit])); };
    var step = __tx_anf(inner, c, (cv: Expr) => {
        var then = __tx_body(__tx_block(inner, body, 0, (c2: Cx) => { return __tx_unwind(c2, base, looped); }));
        var leave = [__tx_return_call(Expr.of(ExprKind.Var(after)), unit)];
        return __tx_done([__tx_restmt(s, StmtKind.If(cv, __tx_block_stmt(then), Option.Some(__tx_block_stmt(leave))))]);
    });
    var u = Param { name: fresh("u"), ty: Option.Some(__tx_named("unit")), implicit: false };
    var v = Param { name: fresh("u"), ty: Option.Some(__tx_named("unit")), implicit: false };
    var stmts: List<Stmt> = [];
    for (b in before) { stmts.push(b); }
    stmts.push(Stmt.of(StmtKind.Let(after, Option.None, Option.Some(__tx_lambda([u], __tx_body(rest()))))));
    match cx.answer {
        Option.Some(answer) => {
            var fn_decl = Decl.of(DeclKind.Fn(FnDecl { name: again, params: [v], signature: __tx_own_sg(Option.Some(answer)), body: __tx_body(step) }));
            stmts.push(Stmt.of(StmtKind.Declare(fn_decl)));
        }
        _ => {
            // What the loop answers has no name here, so it is a variable that
            // starts out as what follows the loop, whose type says it, and is
            // then the loop.
            var w = Param { name: fresh("u"), ty: Option.Some(__tx_named("unit")), implicit: false };
            stmts.push(Stmt.of(StmtKind.Let(again, Option.None, Option.Some(__tx_lambda([w], [__tx_return_call(Expr.of(ExprKind.Var(after)), unit)])))));
            stmts.push(Stmt.of(StmtKind.Expression(Expr.of(ExprKind.Assign(again, __tx_lambda([v], __tx_body(step)))))));
        }
    }
    return __tx_tail(stmts, __tx_call(Expr.of(ExprKind.Var(again)), [unit]));
}

/** `for (x in xs)` over a list or an array, as the loop over its indices it means. */
fn __tx_for_in(cx: Cx, s: Stmt, names: List<Name>, over: Expr, body: Stmt, rest: () -> Tail): Tail {
    if (!__tx_indexed(over)) {
        return compile_error(s.span, "A loop over this sequence holding a call that takes control is not supported by the transform yet.");
    }
    return __tx_anf(cx, over, (seq_value: Expr) => {
        var seq = fresh("seq");
        var index = fresh("i");
        var seq_var = Expr.of(ExprKind.Var(seq));
        var index_var = Expr.of(ExprKind.Var(index));
        var before = [
            Stmt.of(StmtKind.Let(seq, Option.None, Option.Some(seq_value))),
            Stmt.of(StmtKind.Let(index, Option.None, Option.Some(Expr.of(ExprKind.Int(0)))))
        ];
        var len = Expr.of(ExprKind.MethodCall(seq_var, "len".as_name(), []));
        var c = Expr.of(ExprKind.Binary(BinOp.Less, index_var, len));
        var element = Expr.of(ExprKind.Index(seq_var, index_var));
        var each: List<Stmt> = [];
        if (names.len() == 1) {
            each.push(Stmt.of(StmtKind.Let(names[0], Option.None, Option.Some(element))));
        } else {
            var whole = fresh("tuple");
            each.push(Stmt.of(StmtKind.Let(whole, Option.None, Option.Some(element))));
            for (var n = 0; n < names.len(); n += 1) {
                var part = Expr.of(ExprKind.TupleGet(Expr.of(ExprKind.Var(whole)), n));
                each.push(Stmt.of(StmtKind.Let(names[n], Option.None, Option.Some(part))));
            }
        }
        var step = Expr.of(ExprKind.Binary(BinOp.Add, index_var, Expr.of(ExprKind.Int(1))));
        each.push(Stmt.of(StmtKind.Expression(Expr.of(ExprKind.Assign(index, step)))));
        each.push(body);
        return __tx_loop(cx, s, before, c, each, rest);
    });
}

fn __tx_indexed(over: Expr): bool {
    match over.ty {
        Option.Some(t) => {
            match t.kind {
                TypeKind.Applied(n, _) => { return str(n) == "List" || str(n) == "Array"; }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

fn __tx_jump(cx: Cx, s: Stmt, target: Option<Name>): Tail {
    match target {
        Option.Some(n) => {
            return __tx_unwind(cx, cx.looped, () => {
                return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(n)), [Expr.of(ExprKind.Unit)]));
            });
        }
        _ => {}
    }
    return __tx_done([s]);
}

fn __tx_return(cx: Cx, s: Stmt, value: Option<Expr>): Tail {
    var k = Expr.of(ExprKind.Unit);
    match cx.ret {
        Option.Some(n) => { k = Expr.of(ExprKind.Var(n)); }
        _ => {
            match cx.leave {
                Option.Some(left) => {
                    match value {
                        Option.Some(e) => { return __tx_anf(cx, e, (v: Expr) => { return __tx_leaving(cx, left, v); }); }
                        _ => { return __tx_leaving(cx, left, Expr.of(ExprKind.Unit)); }
                    }
                }
                _ => { return compile_error(s.span, "A 'return' out of the function a 'run' stands in is not supported by the transform here."); }
            }
        }
    }
    var handed = (v: Expr) => { return __tx_tail([], __tx_call(k, [v])); };
    match value {
        Option.Some(e) => {
            if (cx.direct && cx.cleanups.len() == 0 && __tx_is_direct(cx, e)) {
                return __tx_tail([], __tx_split_call(cx, __tx_args_valued(cx, e), k));
            }
            return __tx_anf(cx, e, (v: Expr) => { return __tx_leave_with(cx, 0, v, handed); });
        }
        _ => { return __tx_unwind(cx, 0, () => { return handed(Expr.of(ExprKind.Unit)); }); }
    }
}

/**
 * A function declared in the region whose body takes control: it is made
 * taking a continuation, and is generic over what that answers and performs,
 * since it calls itself.
 */
fn __tx_local_fn(cx: Cx, s: Stmt, d: Decl): Stmt {
    match d.kind {
        DeclKind.Fn(f) => {
            var k = fresh("k");
            var r = fresh("R");
            var row = fresh("E");
            var answer = TypeExpr.of(TypeKind.Named(r));
            var inner = __tx_fn_cx(cx, k, Option.Some(answer), [], false);
            var result = __tx_named("unit");
            match f.signature.ret {
                Option.Some(t) => { result = t; }
                _ => {}
            }
            var params: List<Param> = [];
            for (p in f.params) { params.push(p); }
            var k_ty = TypeExpr.of(TypeKind.Function([result], answer, [Applied { name: row, args: [] }]));
            params.push(Param { name: k, ty: Option.Some(k_ty), implicit: false });
            var sg = Signature {
                ret: Option.Some(answer),
                row: Option.None,
                static_params: [StaticParam { name: r, ty: Option.None, pack: false }, StaticParam { name: row, ty: Option.None, pack: false }]
            };
            var finish = (c: Cx) => {
                return __tx_unwind(c, 0, () => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(k)), [Expr.of(ExprKind.Unit)])); });
            };
            var body = __tx_body(__tx_block(inner, f.body, 0, finish));
            var made = FnDecl { name: f.name, params: params, signature: sg, body: body };
            return __tx_restmt(s, StmtKind.Declare(Decl { kind: DeclKind.Fn(made), attrs: d.attrs, span: d.span }));
        }
        _ => {}
    }
    return compile_error(s.span, "A call that takes control inside a local declaration is not supported by the transform yet.");
}

/** The statements that evaluate `e`, then hand what is left of it to `k`. */
fn __tx_anf(cx: Cx, e: Expr, k: (Expr) -> Tail): Tail {
    if (!__tx_splits(cx, e)) { return k(__tx_values(cx, e)); }
    if (__tx_is_direct(cx, e)) {
        var x = fresh("x");
        var after = () => { return k(Expr { kind: ExprKind.Var(x), span: e.span, ty: e.ty }); };
        return __tx_split(cx, __tx_args_valued(cx, e), Param { name: x, ty: __tx_written(cx, e.ty), implicit: false }, after);
    }
    match e.kind {
        ExprKind.Call(f, args) => {
            return __tx_anf_all(cx, args, (vs: List<Expr>) => {
                var call = __tx_rebuilt(e, ExprKind.Call(f, vs));
                if (__tx_controls(cx, f, vs)) {
                    var x = fresh("x");
                    var after = () => { return k(Expr { kind: ExprKind.Var(x), span: e.span, ty: e.ty }); };
                    return __tx_split(cx, call, Param { name: x, ty: __tx_written(cx, e.ty), implicit: false }, after);
                }
                return k(__tx_rebuilt(e, ExprKind.Call(__tx_values(cx, f), vs)));
            });
        }
        ExprKind.StaticCall(f, sa, args) => {
            return __tx_anf_all(cx, args, (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.StaticCall(f, sa, vs)));
            });
        }
        ExprKind.MethodCall(r, m, args) => {
            // `Option.Some(x)` is a method call on a type, and a type is no value to hold.
            if (__tx_names_type(r)) {
                return __tx_anf_all(cx, args, (vs: List<Expr>) => {
                    return k(__tx_rebuilt(e, ExprKind.MethodCall(r, m, vs)));
                });
            }
            return __tx_anf_all(cx, __tx_cons(r, args), (vs: List<Expr>) => {
                var call = __tx_rebuilt(e, ExprKind.MethodCall(vs[0], m, __tx_from(vs, 1)));
                if (__tx_dyn_controls(cx, r, m)) {
                    var x = fresh("x");
                    var after = () => { return k(Expr { kind: ExprKind.Var(x), span: e.span, ty: e.ty }); };
                    return __tx_split(cx, call, Param { name: x, ty: __tx_written(cx, e.ty), implicit: false }, after);
                }
                return k(call);
            });
        }
        ExprKind.Binary(op, a, b) => {
            return __tx_anf_all(cx, [a, b], (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.Binary(op, vs[0], vs[1])));
            });
        }
        ExprKind.And(a, b) => { return __tx_logic(cx, e, a, b, true, k); }
        ExprKind.Or(a, b) => { return __tx_logic(cx, e, a, b, false, k); }
        ExprKind.Unary(op, a) => {
            return __tx_anf(cx, a, (v: Expr) => { return k(__tx_rebuilt(e, ExprKind.Unary(op, v))); });
        }
        ExprKind.Assign(n, a) => {
            return __tx_anf(cx, a, (v: Expr) => { return k(__tx_rebuilt(e, ExprKind.Assign(n, v))); });
        }
        ExprKind.Compound(op, n, a) => {
            return __tx_anf(cx, a, (v: Expr) => { return k(__tx_rebuilt(e, ExprKind.Compound(op, n, v))); });
        }
        ExprKind.CompoundIndex(op, a, i, v) => {
            return __tx_anf_all(cx, [a, i, v], (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.CompoundIndex(op, vs[0], vs[1], vs[2])));
            });
        }
        ExprKind.CompoundField(op, r, f, v) => {
            return __tx_anf_all(cx, [r, v], (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.CompoundField(op, vs[0], f, vs[1])));
            });
        }
        ExprKind.Field(r, f) => {
            return __tx_anf(cx, r, (v: Expr) => { return k(__tx_rebuilt(e, ExprKind.Field(v, f))); });
        }
        ExprKind.TupleGet(t, i) => {
            return __tx_anf(cx, t, (v: Expr) => { return k(__tx_rebuilt(e, ExprKind.TupleGet(v, i))); });
        }
        ExprKind.Index(a, i) => {
            return __tx_anf_all(cx, [a, i], (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.Index(vs[0], vs[1])));
            });
        }
        ExprKind.FieldAssign(r, f, a) => {
            return __tx_anf_all(cx, [r, a], (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.FieldAssign(vs[0], f, vs[1])));
            });
        }
        ExprKind.IndexAssign(a, i, v) => {
            return __tx_anf_all(cx, [a, i, v], (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.IndexAssign(vs[0], vs[1], vs[2])));
            });
        }
        ExprKind.Tuple(items) => {
            return __tx_anf_all(cx, items, (vs: List<Expr>) => { return k(__tx_rebuilt(e, ExprKind.Tuple(vs))); });
        }
        ExprKind.Collection(items) => {
            return __tx_anf_all(cx, items, (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.Collection(vs)));
            });
        }
        ExprKind.NewCall(t, targs, args) => {
            return __tx_anf_all(cx, args, (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.NewCall(t, targs, vs)));
            });
        }
        ExprKind.New(t, fields) => {
            return __tx_anf_all(cx, __tx_values_of(fields), (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.New(t, __tx_fields(fields, vs))));
            });
        }
        ExprKind.NewGeneric(t, sa, fields) => {
            return __tx_anf_all(cx, __tx_values_of(fields), (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.NewGeneric(t, sa, __tx_fields(fields, vs))));
            });
        }
        ExprKind.Record(fields) => {
            return __tx_anf_all(cx, __tx_values_of(fields), (vs: List<Expr>) => {
                return k(__tx_rebuilt(e, ExprKind.Record(__tx_fields(fields, vs))));
            });
        }
        ExprKind.NewVariant(t, v, payload) => {
            match payload {
                Args.Positional(items) => {
                    return __tx_anf_all(cx, items, (vs: List<Expr>) => {
                        return k(__tx_rebuilt(e, ExprKind.NewVariant(t, v, Args.Positional(vs))));
                    });
                }
                Args.Named(fields) => {
                    return __tx_anf_all(cx, __tx_values_of(fields), (vs: List<Expr>) => {
                        return k(__tx_rebuilt(e, ExprKind.NewVariant(t, v, Args.Named(__tx_fields(fields, vs)))));
                    });
                }
                _ => {}
            }
        }
        ExprKind.Match(x, arms) => { return __tx_match_expr(cx, e, x, arms, k); }
        ExprKind.Run(r, body, clauses) => {
            if (__tx_is_bound(clauses)) { return __tx_bound_run(cx, e, r, body, clauses, k); }
        }
        _ => {}
    }
    return compile_error(e.span, "A call that takes control inside " + __tx_construct(e) + " is not supported by the transform yet.");
}

/**
 * A run inside the region holding a split for this one: its handlers are
 * declared where it stands, its body is split in place, and what it answers is
 * handed to what follows it.
 */
fn __tx_bound_run(cx: Cx, e: Expr, r: Option<TypeExpr>, body: ValuedBlock, clauses: List<HandlerClause>, k: (Expr) -> Tail): Tail {
    var j = fresh("join");
    var v = fresh("v");
    var jv = Expr.of(ExprKind.Var(j));
    var after = __tx_lambda([Param { name: v, ty: __tx_written(cx, e.ty), implicit: false }], __tx_body(k(Expr { kind: ExprKind.Var(v), span: e.span, ty: e.ty })));
    var inner = __tx_branch_cx(__tx_run_cx(cx, body, clauses));
    var base = cx.cleanups.len();
    var split = __tx_block(inner, body.stmts, 0, (c: Cx) => {
        match body.value {
            Option.Some(x) => {
                return __tx_anf(c, x, (xv: Expr) => {
                    return __tx_leave_with(c, base, xv, (held: Expr) => { return __tx_tail([], __tx_call(jv, [held])); });
                });
            }
            _ => { return __tx_unwind(c, base, () => { return __tx_tail([], __tx_call(jv, [Expr.of(ExprKind.Unit)])); }); }
        }
    });
    var lowered = __tx_rebuilt(e, ExprKind.Run(r, ValuedBlock { stmts: __tx_body(split), value: Option.None }, __tx_lowered_clauses(cx, body, clauses)));
    return __tx_tail([Stmt.of(StmtKind.Let(j, Option.None, Option.Some(after)))], lowered);
}

/** `a && b` or `a || b` with a split in it: the right operand is reached on one branch only. */
fn __tx_logic(cx: Cx, e: Expr, a: Expr, b: Expr, is_and: bool, k: (Expr) -> Tail): Tail {
    if (!__tx_splits(cx, b)) {
        return __tx_anf(cx, a, (av: Expr) => {
            if (is_and) { return k(__tx_rebuilt(e, ExprKind.And(av, __tx_values(cx, b)))); }
            return k(__tx_rebuilt(e, ExprKind.Or(av, __tx_values(cx, b))));
        });
    }
    var j = fresh("join");
    var v = fresh("v");
    var bool_ty = __tx_named("bool");
    var after = __tx_lambda([Param { name: v, ty: Option.Some(bool_ty), implicit: false }], __tx_body(k(__tx_typed_var(v, bool_ty))));
    var jv = Expr.of(ExprKind.Var(j));
    return __tx_prepend([Stmt.of(StmtKind.Let(j, Option.None, Option.Some(after)))], __tx_anf(cx, a, (av: Expr) => {
        var evaluated = __tx_body(__tx_anf(__tx_branch_cx(cx), b, (bv: Expr) => { return __tx_tail([], __tx_call(jv, [bv])); }));
        var settled = [__tx_return_call(jv, Expr.of(ExprKind.Bool(!is_and)))];
        var then = settled;
        var otherwise = evaluated;
        if (is_and) {
            then = evaluated;
            otherwise = settled;
        }
        return __tx_done([Stmt.of(StmtKind.If(av, __tx_block_stmt(then), Option.Some(__tx_block_stmt(otherwise))))]);
    }));
}

/** A `match` holding a split, as a value: each arm hands its value to what follows. */
fn __tx_match_expr(cx: Cx, e: Expr, x: Expr, arms: List<ValuedArm>, k: (Expr) -> Tail): Tail {
    var j = fresh("join");
    var v = fresh("v");
    var after = __tx_lambda([Param { name: v, ty: __tx_written(cx, e.ty), implicit: false }], __tx_body(k(Expr { kind: ExprKind.Var(v), span: e.span, ty: e.ty })));
    var jv = Expr.of(ExprKind.Var(j));
    return __tx_prepend([Stmt.of(StmtKind.Let(j, Option.None, Option.Some(after)))], __tx_anf(cx, x, (xv: Expr) => {
        var inner = __tx_branch_cx(cx);
        var base = cx.cleanups.len();
        var out: List<MatchArm> = [];
        for (a in arms) {
            var value = a.body.value;
            var handed = (c: Cx) => {
                match value {
                    Option.Some(r) => {
                        return __tx_anf(c, r, (rv: Expr) => {
                            return __tx_leave_with(c, base, rv, (held: Expr) => { return __tx_tail([], __tx_call(jv, [held])); });
                        });
                    }
                    _ => { return __tx_unwind(c, base, () => { return __tx_tail([], __tx_call(jv, [Expr.of(ExprKind.Unit)])); }); }
                }
            };
            out.push(MatchArm { pattern: a.pattern, body: __tx_body(__tx_block(inner, a.body.stmts, 0, handed)) });
        }
        return __tx_done([Stmt.of(StmtKind.Match(xv, out))]);
    }));
}

fn __tx_names_type(e: Expr): bool {
    match e.kind {
        ExprKind.Var(_) => {
            match e.ty {
                Option.None => { return true; }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

/** Each of `es` evaluated in order, and handed to `k`. One ahead of the last that splits is held in a temporary, so it is still evaluated first. */
fn __tx_anf_all(cx: Cx, es: List<Expr>, k: (List<Expr>) -> Tail): Tail {
    var last = -1;
    for (var i = 0; i < es.len(); i += 1) {
        if (__tx_splits(cx, es[i])) { last = i; }
    }
    return __tx_anf_from(cx, es, 0, last, [], k);
}

fn __tx_anf_from(cx: Cx, es: List<Expr>, i: int, last: int, done: List<Expr>, k: (List<Expr>) -> Tail): Tail {
    if (i == es.len()) { return k(done); }
    var e = es[i];
    if (i < last) {
        return __tx_anf(cx, e, (v: Expr) => { return __tx_held(cx, es, i, last, done, v, k); });
    }
    if (i == last) {
        return __tx_anf(cx, e, (v: Expr) => { return __tx_anf_from(cx, es, i + 1, last, __tx_snoc(done, v), k); });
    }
    return __tx_anf_from(cx, es, i + 1, last, __tx_snoc(done, __tx_values(cx, e)), k);
}

fn __tx_held(cx: Cx, es: List<Expr>, i: int, last: int, done: List<Expr>, v: Expr, k: (List<Expr>) -> Tail): Tail {
    if (__tx_literal(v)) { return __tx_anf_from(cx, es, i + 1, last, __tx_snoc(done, v), k); }
    var t = fresh("t");
    var held = Expr { kind: ExprKind.Var(t), span: v.span, ty: v.ty };
    return __tx_prepend(
        [Stmt.of(StmtKind.Let(t, Option.None, Option.Some(v)))],
        __tx_anf_from(cx, es, i + 1, last, __tx_snoc(done, held), k));
}

// ---- splits ----

/** A call whose arguments split nothing, with what is made in them rewritten. */
fn __tx_args_valued(cx: Cx, e: Expr): Expr {
    match e.kind {
        ExprKind.Call(f, args) => {
            var out: List<Expr> = [];
            for (a in args) { out.push(__tx_values(cx, a)); }
            return __tx_rebuilt(e, ExprKind.Call(f, out));
        }
        _ => { return e; }
    }
}

/** A call that takes control, handed a continuation binding `param` around what `after` makes; its arguments are rewritten already. */
fn __tx_split(cx: Cx, e: Expr, param: Param, after: () -> Tail): Tail {
    if (__tx_is_discontinue(e)) {
        var answered = Param { name: fresh("r"), ty: Option.None, implicit: false };
        var unit = Stmt.of(StmtKind.Let(param.name, Option.None, Option.Some(Expr.of(ExprKind.Unit))));
        var resumed = __tx_lambda([answered], __tx_body(__tx_prepend([unit], after())));
        return __tx_tail([], __tx_split_call(cx, e, resumed));
    }
    var k = __tx_lambda([param], __tx_continued(cx, param.name, __tx_body(after())));
    return __tx_tail([], __tx_split_call(cx, e, k));
}

/** A continuation's body: resumed with the discontinue signal, it runs the cleanups in scope and hands the signal on. */
fn __tx_continued(cx: Cx, x: Name, body: List<Stmt>): List<Stmt> {
    var signal = __tx_call(Expr.of(ExprKind.Var("__discontinued".as_name())), []);
    var up = __tx_unwind(cx, 0, () => {
        match cx.ret {
            Option.Some(k) => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(k)), [signal])); }
            _ => { return __tx_tail([], signal); }
        }
    });
    var test = __tx_call(Expr.of(ExprKind.Var("__is_discontinued".as_name())), [Expr.of(ExprKind.Var(x))]);
    var out = [Stmt.of(StmtKind.If(test, __tx_block_stmt(__tx_body(up)), Option.None))];
    for (s in body) { out.push(s); }
    return out;
}

/**
 * The call handed its continuation: an operation through its handler's
 * method, a function through its copy, handed the handler of each effect this
 * run splits at, and a value with the handler of each effect its type takes
 * control of.
 */
fn __tx_split_call(cx: Cx, e: Expr, k: Expr): Expr {
    match e.kind {
        ExprKind.Call(f, args) => {
            match operation_of(f) {
                Option.Some(op) => {
                    for (h in cx.held) {
                        if (h.label == op.label) {
                            var method = Expr.of(ExprKind.Field(h.value, op.name));
                            return __tx_call(method, __tx_snoc(__tx_handed(cx, args, __tx_held_takes(h, op.name), e.span), k));
                        }
                    }
                    if (op.takes_control && __tx_binds(cx, op.label)) {
                        match __tx_handler(cx, op.label) {
                            Option.Some(h) => { return __tx_call(Expr.of(ExprKind.Field(h, op.name)), __tx_snoc(args, k)); }
                            _ => {}
                        }
                    }
                    return compile_error(e.span, "An operation whose handler takes control of this run is not supported by the transform yet.");
                }
                _ => {}
            }
            if (__tx_is_discontinue(e)) {
                var through: List<Name> = [];
                if (__tx_resumes(cx, args[0])) { through = __tx_names_of(cx.bound); }
                return __tx_call(args[0], __tx_snoc(__tx_handed(cx, [__tx_signal()], through, e.span), k));
            }
            if (__tx_resumes(cx, f)) {
                return __tx_call(f, __tx_snoc(__tx_handed(cx, args, __tx_names_of(cx.bound), e.span), k));
            }
            if (names_function(f)) {
                return __tx_call(Expr.of(ExprKind.Var(__tx_copy_of(cx, e, f))), __tx_snoc(__tx_handed(cx, args, __tx_ctl_labels(f.ty), e.span), k));
            }
            return __tx_call(__tx_values(cx, f), __tx_snoc(__tx_handed(cx, args, __tx_ctl_labels(f.ty), e.span), k));
        }
        ExprKind.MethodCall(r, m, args) => {
            var taken: List<Name> = [];
            for (l in __tx_dyn_labels(r, m)) { if (controls(l)) { taken = __tx_sorted_in(taken, l); } }
            return __tx_rebuilt(e, ExprKind.MethodCall(r, m, __tx_snoc(__tx_handed(cx, args, taken, e.span), k)));
        }
        _ => {}
    }
    return compile_error(e.span, "Only a call takes control.");
}

/** What a method called on a trait object writes in its row; nothing when `r` is no trait object. */
fn __tx_dyn_labels(r: Expr, m: Name): List<Name> {
    var out: List<Name> = [];
    match r.ty {
        Option.Some(t) => {
            match t.kind {
                TypeKind.Named(n) => { for (l in method_row(n, m)) { out.push(l); } }
                TypeKind.Applied(n, _) => { for (l in method_row(n, m)) { out.push(l); } }
                _ => {}
            }
        }
        _ => {}
    }
    return out;
}

/** Whether a method called on a trait object takes control of an effect this run splits at. */
fn __tx_dyn_controls(cx: Cx, r: Expr, m: Name): bool {
    for (l in __tx_dyn_labels(r, m)) { if (controls(l) && __tx_binds(cx, l)) { return true; } }
    return false;
}

/** `args`, then the handler of each of `labels` where `cx` stands. */
fn __tx_handed(cx: Cx, args: List<Expr>, labels: List<Name>, span: Span): List<Expr> {
    var out: List<Expr> = [];
    for (a in args) { out.push(a); }
    for (l in labels) {
        match __tx_handler(cx, l) {
            Option.Some(h) => { out.push(h); }
            _ => {
                return compile_error(span, "This takes control of '" + str(l) + "', and no handler of it is in scope here.");
            }
        }
    }
    return out;
}

/** The effects a held method takes control of, as this run made it taking them. */
fn __tx_held_takes(h: Held, method: Name): List<Name> {
    for (var i = 0; i < h.splitting.len(); i += 1) {
        if (h.splitting[i] == method) { return h.taking[i]; }
    }
    return [];
}

/** The effects a function type's row holds whose operations take control, in the order a value of it takes their handlers. */
fn __tx_ctl_labels(ty: Option<TypeExpr>): List<Name> {
    var out: List<Name> = [];
    match ty {
        Option.Some(t) => {
            match t.kind {
                TypeKind.Function(_, _, row) => {
                    for (a in row) {
                        if (controls(a.name)) { out = __tx_sorted_in(out, a.name); }
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return out;
}

fn __tx_sorted_in(xs: List<Name>, x: Name): List<Name> {
    var out: List<Name> = [];
    var placed = false;
    for (n in xs) {
        if (n == x) { placed = true; }
        if (!placed && str(x) < str(n)) {
            out.push(x);
            placed = true;
        }
        out.push(n);
    }
    if (!placed) { out.push(x); }
    return out;
}

fn __tx_is_discontinue(e: Expr): bool {
    match e.kind {
        ExprKind.Call(f, args) => {
            match f.kind {
                ExprKind.Var(n) => { return str(n) == "discontinue" && args.len() == 1; }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

/**
 * The copy is generic over what its continuation answers and performs, and
 * says so, so that a copy calling itself has its return type written. Its
 * name is taken before its body is made, which is what a recursive call finds.
 */
fn __tx_copy_of(cx: Cx, call: Expr, f: Expr): Name {
    var labels = __tx_ctl_labels(f.ty);
    var taken: List<Applied> = [];
    for (b in cx.bound) { for (l in labels) { if (l == b.name) { taken.push(b); } } }
    var key = __tx_cons_name(instance_of(f), labels);
    match remembered(key) {
        Option.Some(copy) => { return copy; }
        _ => {}
    }
    match processed_fn(__tx_called_at(declof_call(f), f.ty)).kind {
        DeclKind.Fn(fd) => {
            var copy = fresh(str(fd.name));
            remember(key, copy);
            remember([copy], copy);
            var k = fresh("k");
            var params: List<Param> = [];
            var own: List<Name> = [];
            for (sp in fd.signature.static_params) { own.push(sp.name); }
            // A copy's continuation is written at the key its call settled, which is no type for another run's.
            var last = fd.params.len();
            match f.kind {
                ExprKind.Var(n) => {
                    match remembered([n]) {
                        Option.Some(_) => { last = fd.params.len() - 1; }
                        _ => {}
                    }
                }
                _ => {}
            }
            for (var i = 0; i < fd.params.len(); i += 1) {
                var p = __tx_typed_param(__tx_param(fd.params[i], own), f.ty, i);
                if (i >= last || __tx_names_handler(p.name)) { p = Param { name: p.name, ty: Option.None, implicit: p.implicit }; }
                params.push(p);
            }
            var sg = Signature { ret: Option.None, row: Option.None, static_params: [] };
            var answer: Option<TypeExpr> = Option.None;
            var k_ty: Option<TypeExpr> = Option.None;
            var own_row: List<Applied> = [];
            match __tx_known(call.ty) {
                Option.Some(result) => {
                    var r = fresh("R");
                    var row = fresh("E");
                    own_row = [];
                    var r_ty = TypeExpr.of(TypeKind.Named(r));
                    answer = Option.Some(r_ty);
                    k_ty = Option.Some(TypeExpr.of(TypeKind.Function([result], r_ty, [Applied { name: row, args: [] }])));
                    sg = Signature {
                        ret: answer,
                        row: Option.None,
                        static_params: [
                            StaticParam { name: r, ty: Option.None, pack: false },
                            StaticParam { name: row, ty: Option.None, pack: false }
                        ]
                    };
                }
                _ => {}
            }
            for (l in labels) { params.push(Param { name: handler_param(l), ty: Option.None, implicit: false }); }
            params.push(Param { name: k, ty: k_ty, implicit: false });
            var inner = Cx {
                bound: taken, handlers: __tx_own_handlers(labels), answer: answer, ret: Option.Some(k), breaks: Option.None, continues: Option.None,
                looped: 0, cleanups: [], top: false, held: [], row: own_row, leave: Option.None, inner: [], direct: false, resumes: []
            };
            var finish = (c: Cx) => {
                return __tx_unwind(c, 0, () => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(k)), [Expr.of(ExprKind.Unit)])); });
            };
            var body = __tx_body(__tx_block(inner, fd.body, 0, finish));
            declare(Decl.of(DeclKind.Fn(FnDecl { name: copy, params: params, signature: sg, body: body })));
            return copy;
        }
        _ => {}
    }
    return compile_error(f.span, "Only a function is copied for a run.");
}

/**
 * The function a call reaches, each parameter at the type the call settled
 * for it: a static parameter that stands only in a row is no part of the key,
 * so the instance still names it where it is written.
 */
fn __tx_called_at(d: Decl, ty: Option<TypeExpr>): Decl {
    match d.kind {
        DeclKind.Fn(fd) => {
            var params: List<Param> = [];
            for (var i = 0; i < fd.params.len(); i += 1) {
                var p = fd.params[i];
                params.push(__tx_typed_param(Param { name: p.name, ty: Option.None, implicit: p.implicit }, ty, i));
                match params[i].ty {
                    Option.None => { params[i] = p; }
                    _ => {}
                }
            }
            return Decl { kind: DeclKind.Fn(FnDecl { name: fd.name, params: params, signature: fd.signature, body: fd.body }), attrs: d.attrs, span: d.span };
        }
        _ => { return d; }
    }
}

/** A parameter nobody wrote a type for, as the callee's type has it: a method's `self` among them. */
fn __tx_typed_param(p: Param, ty: Option<TypeExpr>, i: int): Param {
    match p.ty {
        Option.Some(_) => { return p; }
        _ => {}
    }
    match ty {
        Option.Some(t) => {
            match t.kind {
                TypeKind.Function(ps, _, _) => {
                    if (i < ps.len() && __tx_settled(ps[i])) { return Param { name: p.name, ty: Option.Some(ps[i]), implicit: p.implicit }; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return p;
}

/**
 * A parameter of a function this makes, as written, unless its type names a
 * static parameter of the function it was made from: a copy's own `R` and `E`
 * are no names where a copy of the copy stands.
 */
fn __tx_param(p: Param, own: List<Name>): Param {
    match p.ty {
        Option.Some(t) => {
            if (__tx_names_any(t, own)) { return Param { name: p.name, ty: Option.None, implicit: p.implicit }; }
        }
        _ => {}
    }
    return p;
}

fn __tx_names_any(t: TypeExpr, names: List<Name>): bool {
    match t.kind {
        TypeKind.Named(n) => {
            for (x in names) { if (x == n) { return true; } }
            return false;
        }
        TypeKind.Function(ps, r, row) => {
            for (a in row) {
                for (x in names) { if (x == a.name) { return true; } }
                for (arg in a.args) { if (__tx_names_any(arg, names)) { return true; } }
            }
            for (p in ps) { if (__tx_names_any(p, names)) { return true; } }
            return __tx_names_any(r, names);
        }
        TypeKind.Applied(n, args) => {
            for (x in names) { if (x == n) { return true; } }
            for (a in args) { if (__tx_names_any(a, names)) { return true; } }
            return false;
        }
        TypeKind.Tuple(items) => {
            for (a in items) { if (__tx_names_any(a, names)) { return true; } }
            return false;
        }
        _ => { return false; }
    }
}

/**
 * A type written in the region, unless it names a function this run splits
 * calls through, or holds one the checker had not settled, which are left to
 * inference.
 */
fn __tx_written(cx: Cx, ty: Option<TypeExpr>): Option<TypeExpr> {
    return __tx_known(ty);
}

/** The type, if it holds no part the checker had not settled. */
fn __tx_known(ty: Option<TypeExpr>): Option<TypeExpr> {
    match ty {
        Option.Some(t) => {
            if (__tx_settled(t)) { return ty; }
            return Option.None;
        }
        _ => { return ty; }
    }
}

fn __tx_settled(t: TypeExpr): bool {
    match t.kind {
        TypeKind.Named(n) => { return n != open_type(); }
        TypeKind.Applied(_, args) => { return __tx_all_settled(args); }
        TypeKind.Tuple(items) => { return __tx_all_settled(items); }
        TypeKind.Record(fields) => {
            for (f in fields) { if (!__tx_settled(f.ty)) { return false; } }
            return true;
        }
        TypeKind.Function(ps, r, row) => {
            for (label in row) { if (!__tx_all_settled(label.args)) { return false; } }
            return __tx_all_settled(ps) && __tx_settled(r);
        }
        TypeKind.Variadic(x) => { return __tx_settled(x); }
        TypeKind.Spread(x) => { return __tx_settled(x); }
        _ => { return true; }
    }
}

fn __tx_all_settled(ts: List<TypeExpr>): bool {
    for (t in ts) { if (!__tx_settled(t)) { return false; } }
    return true;
}

/** Whether a type mentions a function performing an effect this run splits at. */
fn __tx_type_splits(cx: Cx, t: TypeExpr): bool {
    match t.kind {
        TypeKind.Function(ps, r, row) => {
            for (label in row) { if (__tx_row_binds(cx, label)) { return true; } }
            for (p in ps) { if (__tx_type_splits(cx, p)) { return true; } }
            return __tx_type_splits(cx, r);
        }
        TypeKind.Applied(_, args) => {
            for (a in args) { if (__tx_type_splits(cx, a)) { return true; } }
            return false;
        }
        TypeKind.Tuple(items) => {
            for (a in items) { if (__tx_type_splits(cx, a)) { return true; } }
            return false;
        }
        _ => { return false; }
    }
}

// ---- values ----

/**
 * An expression no split stands in, with each function value made in it that
 * performs an effect this run splits at made taking its continuation.
 */
fn __tx_values(cx: Cx, e: Expr): Expr {
    match e.kind {
        ExprKind.Var(_) => { return e; }
        ExprKind.Lambda(params, sg, body) => {
            // A function value written in the program is made taking control where it is checked.
            if (!__tx_is_own(sg) || __tx_is_cps(sg)) { return e; }
            if (__tx_takes_continuation(cx, e)) { return __tx_taking_continuation(cx, e, params, sg, body); }
            return __tx_rebuilt(e, ExprKind.Lambda(params, sg, __tx_inside(cx, body)));
        }
        ExprKind.Run(r, body, clauses) => {
            if (!__tx_is_bound(clauses)) { return e; }
            var inner = __tx_run_cx(cx, body, clauses);
            var stmts = __tx_inside(inner, body.stmts);
            var value: Option<Expr> = Option.None;
            match body.value {
                Option.Some(v) => { value = Option.Some(__tx_values(inner, v)); }
                _ => {}
            }
            return __tx_rebuilt(e, ExprKind.Run(r, ValuedBlock { stmts: stmts, value: value }, __tx_lowered_clauses(cx, body, clauses)));
        }
        ExprKind.Match(x, arms) => {
            var out: List<ValuedArm> = [];
            for (a in arms) {
                var value: Option<Expr> = Option.None;
                match a.body.value {
                    Option.Some(v) => { value = Option.Some(__tx_values(cx, v)); }
                    _ => {}
                }
                out.push(ValuedArm { pattern: a.pattern, body: ValuedBlock { stmts: __tx_inside(cx, a.body.stmts), value: value } });
            }
            return __tx_rebuilt(e, ExprKind.Match(__tx_values(cx, x), out));
        }
        _ => {}
    }
    return __tx_map(e, (c: Expr) => { return __tx_values(cx, c); });
}

fn __tx_takes_continuation(cx: Cx, e: Expr): bool {
    if (__tx_performs_ty(cx, e.ty)) { return true; }
    match e.kind {
        ExprKind.Lambda(_, _, body) => { return __tx_all_split(cx, body); }
        _ => { return false; }
    }
}

/**
 * A function value made taking control: after its own parameters, the handler
 * of each effect its type takes control of, then its continuation.
 */
fn __tx_taking_continuation(cx: Cx, e: Expr, params: List<Param>, written: Signature, body: List<Stmt>): Expr {
    var k = fresh("k");
    var labels = __tx_ctl_labels(e.ty);
    var inner = __tx_handing(__tx_fn_cx(cx, k, cx.answer, cx.row, true), labels);
    var ps: List<Param> = [];
    for (p in params) { ps.push(p); }
    for (l in labels) { ps.push(Param { name: handler_param(l), ty: Option.None, implicit: false }); }
    ps.push(Param { name: k, ty: Option.None, implicit: false });
    var finish = (c: Cx) => {
        return __tx_unwind(c, 0, () => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(k)), [Expr.of(ExprKind.Unit)])); });
    };
    var made = __tx_body(__tx_block(inner, body, 0, finish));
    var marks = [StaticParam { name: cps_marker(), ty: Option.None, pack: false }];
    if (__tx_is_own(written)) { marks.push(StaticParam { name: plain_marker(), ty: Option.None, pack: false }); }
    var sg = Signature { ret: Option.None, row: Option.Some(__tx_open_row_of(e.ty)), static_params: marks };
    return Expr { kind: ExprKind.Lambda(ps, sg, made), span: e.span, ty: Option.None };
}

/** Whether a parameter holds a handler a copy was handed, whose type is the run's that handed it. */
fn __tx_names_handler(n: Name): bool {
    var parts = str(n).split('#');
    return parts.len() > 1 && parts[0] == "hv";
}

/** `cx` with the handlers of `labels` its own parameters, ahead of those around it. */
fn __tx_handing(cx: Cx, labels: List<Name>): Cx {
    var handlers = __tx_own_handlers(labels);
    for (h in cx.handlers) { handlers.push(h); }
    return Cx {
        bound: cx.bound, handlers: handlers, answer: cx.answer, ret: cx.ret, breaks: cx.breaks, continues: cx.continues,
        looped: cx.looped, cleanups: cx.cleanups, top: cx.top, held: cx.held, row: cx.row, leave: cx.leave, inner: cx.inner, direct: cx.direct, resumes: cx.resumes
    };
}

/** A function type's row as written for the value made from it, open past what it holds. */
fn __tx_open_row_of(ty: Option<TypeExpr>): List<Applied> {
    var out: List<Applied> = [];
    match ty {
        Option.Some(t) => {
            match t.kind {
                TypeKind.Function(_, _, row) => { for (a in row) { out.push(a); } }
                _ => {}
            }
        }
        _ => {}
    }
    out.push(Applied { name: open_row(), args: [] });
    return out;
}

/** What a bound run's body is split under: a run made a function value is called where it stands. */
fn __tx_run_cx(cx: Cx, body: ValuedBlock, clauses: List<HandlerClause>): Cx {
    if (__tx_is_prompt(body)) { return cx; }
    return __tx_inside_run(cx, clauses);
}

fn __tx_lowered_clauses(cx: Cx, body: ValuedBlock, clauses: List<HandlerClause>): List<HandlerClause> {
    if (__tx_is_prompt(body)) { return clauses; }
    return __tx_clause_values(cx, clauses);
}

/** The handlers of a bound run inside the region, whose methods are code of the region too. */
fn __tx_clause_values(cx: Cx, clauses: List<HandlerClause>): List<HandlerClause> {
    var out: List<HandlerClause> = [];
    for (c in clauses) {
        match c {
            HandlerClause.Bound(label, h, value) => {
                match value {
                    Option.Some(s) => { out.push(HandlerClause.Bound(label, h, Option.Some(__tx_rewritten_value(cx, s)))); }
                    _ => { out.push(c); }
                }
            }
            _ => { out.push(c); }
        }
    }
    return out;
}

/**
 * A handler's value as this run rewrote it, marked so when it changed: its
 * methods are checked as written then, not against the types they were
 * first checked at.
 */
fn __tx_rewritten_value(cx: Cx, before: Stmt): Stmt {
    if (!__tx_rewrites_stmt(cx, before)) { return before; }
    var after = __tx_inside_stmt(cx, before);
    match after.kind {
        StmtKind.Let(hv, _, init) => {
            return __tx_restmt(after, StmtKind.Let(hv, Option.Some(TypeExpr.of(TypeKind.Named(open_type()))), init));
        }
        _ => { return after; }
    }
}

/** Whether `__tx_inside_stmt` changes anything in `s`. */
fn __tx_rewrites_stmt(cx: Cx, s: Stmt): bool {
    var found = false;
    match s.kind {
        StmtKind.Let(_, ty, _) => {
            match ty {
                Option.Some(t) => { if (__tx_type_splits(cx, t)) { found = true; } }
                _ => {}
            }
        }
        StmtKind.Declare(d) => {
            match d.kind {
                DeclKind.Fn(f) => { if (__tx_all_split(cx, f.body) || __tx_rewrites_all(cx, f.body)) { found = true; } }
                _ => {}
            }
        }
        _ => {}
    }
    __tx_stmt_map(s, (e: Expr) => {
        if (__tx_rewrites(cx, e)) { found = true; }
        return e;
    }, (c: Stmt) => {
        if (__tx_rewrites_stmt(cx, c)) { found = true; }
        return c;
    });
    return found;
}

fn __tx_rewrites_all(cx: Cx, ss: List<Stmt>): bool {
    for (s in ss) { if (__tx_rewrites_stmt(cx, s)) { return true; } }
    return false;
}

fn __tx_rewrites(cx: Cx, e: Expr): bool {
    match e.kind {
        ExprKind.Lambda(_, _, body) => { return __tx_takes_continuation(cx, e) || __tx_rewrites_all(cx, body); }
        ExprKind.Var(_) => { return __tx_performs_ty(cx, e.ty) && names_function(e); }
        ExprKind.Run(_, body, clauses) => {
            if (!__tx_is_bound(clauses)) { return false; }
            if (__tx_is_prompt(body)) { return false; }
            for (c in clauses) {
                match c {
                    HandlerClause.Bound(_, _, value) => {
                        match value {
                            Option.Some(v) => { if (__tx_rewrites_stmt(cx, v)) { return true; } }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            var inner = __tx_inside_run(cx, clauses);
            if (__tx_rewrites_all(inner, body.stmts)) { return true; }
            match body.value {
                Option.Some(v) => { return __tx_rewrites(inner, v); }
                _ => { return false; }
            }
        }
        ExprKind.Match(x, arms) => {
            if (__tx_rewrites(cx, x)) { return true; }
            for (a in arms) {
                if (__tx_rewrites_all(cx, a.body.stmts)) { return true; }
                match a.body.value {
                    Option.Some(v) => { if (__tx_rewrites(cx, v)) { return true; } }
                    _ => {}
                }
            }
            return false;
        }
        _ => {}
    }
    for (c in __tx_children(e)) { if (__tx_rewrites(cx, c)) { return true; } }
    return false;
}

fn __tx_is_bound(clauses: List<HandlerClause>): bool {
    if (clauses.len() == 0) { return false; }
    for (c in clauses) {
        match c {
            HandlerClause.Bound(_, _, _) => {}
            _ => { return false; }
        }
    }
    return true;
}

/** Statements inside a function value this run does not split, with what is made in them rewritten. */
fn __tx_inside(cx: Cx, ss: List<Stmt>): List<Stmt> {
    var out: List<Stmt> = [];
    for (s in ss) { out.push(__tx_inside_stmt(cx, s)); }
    return out;
}

fn __tx_inside_stmt(cx: Cx, s: Stmt): Stmt {
    match s.kind {
        StmtKind.Let(x, ty, init) => {
            match init {
                Option.Some(e) => { return __tx_restmt(s, StmtKind.Let(x, __tx_written(cx, ty), Option.Some(__tx_values(cx, e)))); }
                _ => { return s; }
            }
        }
        StmtKind.Declare(d) => {
            match d.kind {
                DeclKind.Fn(f) => {
                    if (__tx_all_split(cx, f.body)) { return __tx_local_fn(cx, s, d); }
                    var inner = FnDecl { name: f.name, params: f.params, signature: f.signature, body: __tx_inside(cx, f.body) };
                    return __tx_restmt(s, StmtKind.Declare(Decl { kind: DeclKind.Fn(inner), attrs: d.attrs, span: d.span }));
                }
                _ => { return s; }
            }
        }
        _ => {}
    }
    return __tx_stmt_map(s, (e: Expr) => { return __tx_values(cx, e); }, (c: Stmt) => { return __tx_inside_stmt(cx, c); });
}

// ---- statements no split stands in ----

/** A statement no split stands in, with each exit to a continuation handed on. */
fn __tx_plain(cx: Cx, s: Stmt): Stmt {
    return __tx_exiting(cx, s, false, false);
}

/**
 * `return`, and a `break` or `continue` of a loop holding a split, are calls
 * to what carries on after them, made once the `defer`s they leave have run. A
 * `defer` written inside the statement would run after that call instead.
 */
fn __tx_exiting(cx: Cx, s: Stmt, looped: bool, deferred: bool): Stmt {
    match s.kind {
        StmtKind.Return(value) => {
            match cx.ret {
                Option.Some(k) => {
                    __tx_no_defer(s, deferred);
                    var v = Expr.of(ExprKind.Unit);
                    match value {
                        Option.Some(e) => { v = __tx_values(cx, e); }
                        _ => {}
                    }
                    var handed = (held: Expr) => { return __tx_tail([], __tx_call(Expr.of(ExprKind.Var(k)), [held])); };
                    return __tx_block_stmt(__tx_body(__tx_leave_with(cx, 0, v, handed)));
                }
                _ => {
                    match cx.leave {
                        Option.Some(left) => {
                            __tx_no_defer(s, deferred);
                            var v = Expr.of(ExprKind.Unit);
                            match value {
                                Option.Some(e) => { v = __tx_values(cx, e); }
                                _ => {}
                            }
                            return __tx_block_stmt(__tx_body(__tx_leaving(cx, left, v)));
                        }
                        _ => { return compile_error(s.span, "A 'return' out of the function a 'run' stands in is not supported by the transform here."); }
                    }
                }
            }
        }
        StmtKind.Expression(e) => {
            match e.kind {
                ExprKind.Run(r, body, clauses) => {
                    if (__tx_is_bound(clauses)) {
                        var inner = __tx_run_cx(cx, body, clauses);
                        var value: Option<Expr> = Option.None;
                        match body.value {
                            Option.Some(v) => { value = Option.Some(__tx_values(inner, v)); }
                            _ => {}
                        }
                        var stmts = __tx_all_exiting(inner, body.stmts, looped, deferred);
                        var lowered = __tx_rebuilt(e, ExprKind.Run(r, ValuedBlock { stmts: stmts, value: value }, __tx_lowered_clauses(cx, body, clauses)));
                        return __tx_restmt(s, StmtKind.Expression(lowered));
                    }
                }
                _ => {}
            }
        }
        StmtKind.Break => {
            if (looped) { return s; }
            return __tx_jumping(cx, s, cx.breaks, deferred);
        }
        StmtKind.Continue => {
            if (looped) { return s; }
            return __tx_jumping(cx, s, cx.continues, deferred);
        }
        StmtKind.Block(ss) => { return __tx_restmt(s, StmtKind.Block(__tx_all_exiting(cx, ss, looped, deferred))); }
        StmtKind.If(c, t, e) => {
            var otherwise: Option<Stmt> = Option.None;
            match e {
                Option.Some(x) => { otherwise = Option.Some(__tx_exiting(cx, x, looped, deferred)); }
                _ => {}
            }
            return __tx_restmt(s, StmtKind.If(__tx_values(cx, c), __tx_exiting(cx, t, looped, deferred), otherwise));
        }
        StmtKind.While(c, b) => { return __tx_restmt(s, StmtKind.While(__tx_values(cx, c), __tx_exiting(cx, b, true, deferred))); }
        StmtKind.ForIn(ns, over, b) => { return __tx_restmt(s, StmtKind.ForIn(ns, __tx_values(cx, over), __tx_exiting(cx, b, true, deferred))); }
        StmtKind.Match(x, arms) => {
            var out: List<MatchArm> = [];
            for (a in arms) { out.push(MatchArm { pattern: a.pattern, body: __tx_all_exiting(cx, a.body, looped, deferred) }); }
            return __tx_restmt(s, StmtKind.Match(__tx_values(cx, x), out));
        }
        StmtKind.Defer(d) => { return __tx_restmt(s, StmtKind.Defer(__tx_inside_stmt(cx, d))); }
        _ => {}
    }
    return __tx_inside_stmt(cx, s);
}

fn __tx_all_exiting(cx: Cx, ss: List<Stmt>, looped: bool, deferred: bool): List<Stmt> {
    var out: List<Stmt> = [];
    var waiting = deferred;
    for (s in ss) {
        out.push(__tx_exiting(cx, s, looped, waiting));
        match s.kind {
            StmtKind.Defer(_) => { waiting = true; }
            _ => {}
        }
    }
    return out;
}

fn __tx_jumping(cx: Cx, s: Stmt, target: Option<Name>, deferred: bool): Stmt {
    match target {
        Option.Some(_) => {
            __tx_no_defer(s, deferred);
            return __tx_block_stmt(__tx_body(__tx_jump(cx, s, target)));
        }
        _ => { return s; }
    }
}

fn __tx_no_defer(s: Stmt, deferred: bool) {
    if (deferred) {
        compile_error(s.span, "Leaving a 'defer' in code split at a call that takes control is not supported by the transform yet.");
    }
}

fn __tx_unsupported(cx: Cx, s: Stmt): string {
    return "A call that takes control inside " + __tx_culprit(cx, s) + " is not supported by the transform yet.";
}

/** What a statement holds a call that takes control inside, where the transform cannot split it. */
fn __tx_culprit(cx: Cx, s: Stmt): string {
    match s.kind {
        StmtKind.Declare(_) => { return "a local declaration"; }
        StmtKind.Block(ss) => { return __tx_culprit_of(cx, ss); }
        StmtKind.If(_, t, e) => {
            if (__tx_stmt_reaches(cx, t)) { return __tx_culprit(cx, t); }
            match e {
                Option.Some(x) => { return __tx_culprit(cx, x); }
                _ => {}
            }
        }
        StmtKind.While(_, b) => { if (__tx_stmt_reaches(cx, b)) { return __tx_culprit(cx, b); } }
        StmtKind.ForIn(_, _, b) => { if (__tx_stmt_reaches(cx, b)) { return __tx_culprit(cx, b); } }
        StmtKind.Match(_, arms) => {
            for (a in arms) { if (__tx_all_reach(cx, a.body)) { return __tx_culprit_of(cx, a.body); } }
        }
        _ => {}
    }
    return "this statement";
}

fn __tx_culprit_of(cx: Cx, ss: List<Stmt>): string {
    for (s in ss) { if (__tx_stmt_reaches(cx, s)) { return __tx_culprit(cx, s); } }
    return "this statement";
}

fn __tx_construct(e: Expr): string {
    match e.kind {
        ExprKind.Run(_, _, _) => { return "a nested 'run'"; }
        ExprKind.Lambda(_, _, _) => { return "a function value"; }
        ExprKind.Spread(_) => { return "a spread"; }
        _ => { return "this expression"; }
    }
}

// ---- where a split stands ----

/** Whether running `s` reaches a call that takes control, other than from inside a function value. */
fn __tx_stmt_splits(cx: Cx, s: Stmt): bool {
    match s.kind {
        StmtKind.Expression(e) => { return __tx_splits(cx, e); }
        StmtKind.Let(_, _, init) => {
            match init {
                Option.Some(e) => { return __tx_splits(cx, e); }
                _ => { return false; }
            }
        }
        StmtKind.LetTuple(_, e) => { return __tx_splits(cx, e); }
        StmtKind.Return(value) => {
            match value {
                Option.Some(e) => { return __tx_splits(cx, e); }
                _ => { return false; }
            }
        }
        StmtKind.Block(ss) => { return __tx_all_split(cx, ss); }
        StmtKind.If(c, t, e) => {
            if (__tx_splits(cx, c) || __tx_stmt_splits(cx, t)) { return true; }
            match e {
                Option.Some(x) => { return __tx_stmt_splits(cx, x); }
                _ => { return false; }
            }
        }
        StmtKind.While(c, b) => { return __tx_splits(cx, c) || __tx_stmt_splits(cx, b); }
        StmtKind.ForIn(_, over, b) => { return __tx_splits(cx, over) || __tx_stmt_splits(cx, b); }
        StmtKind.Match(x, arms) => {
            if (__tx_splits(cx, x)) { return true; }
            for (a in arms) { if (__tx_all_split(cx, a.body)) { return true; } }
            return false;
        }
        StmtKind.Declare(d) => {
            match d.kind {
                DeclKind.Fn(f) => { return __tx_all_split(cx, f.body); }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

fn __tx_all_split(cx: Cx, ss: List<Stmt>): bool {
    for (s in ss) { if (__tx_stmt_splits(cx, s)) { return true; } }
    return false;
}

fn __tx_splits_from(cx: Cx, ss: List<Stmt>, i: int): bool {
    for (var n = i; n < ss.len(); n += 1) { if (__tx_stmt_splits(cx, ss[n])) { return true; } }
    return false;
}

/** Whether evaluating `e` reaches a call that takes control, other than from inside a function value. */
fn __tx_splits(cx: Cx, e: Expr): bool {
    match e.kind {
        ExprKind.Call(f, args) => { return __tx_controls(cx, f, args) || __tx_splits(cx, f) || __tx_any_splits(cx, args); }
        ExprKind.MethodCall(r, m, args) => { return __tx_dyn_controls(cx, r, m) || __tx_splits(cx, r) || __tx_any_splits(cx, args); }
        ExprKind.Match(x, arms) => {
            if (__tx_splits(cx, x)) { return true; }
            for (a in arms) {
                if (__tx_all_split(cx, a.body.stmts)) { return true; }
                match a.body.value {
                    Option.Some(v) => { if (__tx_splits(cx, v)) { return true; } }
                    _ => {}
                }
            }
            return false;
        }
        ExprKind.Run(_, body, clauses) => {
            if (!__tx_is_bound(clauses)) { return false; }
            var inner = __tx_run_cx(cx, body, clauses);
            if (__tx_all_split(inner, body.stmts)) { return true; }
            match body.value {
                Option.Some(v) => { return __tx_splits(inner, v); }
                _ => { return false; }
            }
        }
        _ => {}
    }
    for (c in __tx_children(e)) {
        if (__tx_splits(cx, c)) { return true; }
    }
    return false;
}

fn __tx_any_splits(cx: Cx, es: List<Expr>): bool {
    for (e in es) { if (__tx_splits(cx, e)) { return true; } }
    return false;
}

/** A call that takes control itself, its arguments already evaluated. */
fn __tx_is_direct(cx: Cx, e: Expr): bool {
    match e.kind {
        ExprKind.Call(f, args) => { return __tx_controls(cx, f, args) && !__tx_any_splits(cx, args) && !__tx_splits(cx, f); }
        ExprKind.MethodCall(r, m, args) => { return __tx_dyn_controls(cx, r, m) && !__tx_any_splits(cx, args) && !__tx_splits(cx, r); }
        _ => { return false; }
    }
}

/**
 * Whether calling `f` takes control: an operation of an effect this run binds,
 * or anything whose type performs one, an operation another run binds whose
 * handler does among them. A call already handed its handlers and its
 * continuation was handed them by another run.
 */
fn __tx_controls(cx: Cx, f: Expr, args: List<Expr>): bool {
    if (__tx_resumes(cx, f)) { return true; }
    if (args.len() == 1 && __tx_resumes(cx, args[0]) && __tx_is_discontinue(__tx_call(f, args))) { return true; }
    match operation_of(f) {
        Option.Some(op) => {
            for (h in cx.held) {
                if (h.label == op.label) {
                    for (m in h.splitting) { if (m == op.name) { return true; } }
                    return false;
                }
            }
            if (__tx_binds(cx, op.label)) { return op.takes_control; }
        }
        _ => {}
    }
    match f.ty {
        Option.Some(t) => {
            match t.kind {
                TypeKind.Function(ps, _, _) => { if (args.len() > ps.len()) { return false; } }
                _ => {}
            }
        }
        _ => {}
    }
    return __tx_performs_ty(cx, f.ty);
}

/** Whether an operation of the effect is one this run splits at: an operation is bound by its effect's name alone. */
fn __tx_binds(cx: Cx, label: Name): bool {
    for (n in cx.inner) { if (n == label) { return false; } }
    for (b in cx.bound) { if (b.name == label) { return true; } }
    return false;
}

/** Whether an effect in a row is one this run splits at. */
fn __tx_row_binds(cx: Cx, a: Applied): bool {
    for (b in cx.bound) { if (__tx_same_effect(a, b)) { return true; } }
    return false;
}

/** Whether a function type's row holds an effect this run splits at. */
fn __tx_performs_ty(cx: Cx, ty: Option<TypeExpr>): bool {
    match ty {
        Option.Some(t) => {
            match t.kind {
                TypeKind.Function(_, _, row) => {
                    for (label in row) { if (__tx_row_binds(cx, label)) { return true; } }
                    return false;
                }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

/** Whether anything in `s`, a function value's body included, takes control. */
fn __tx_stmt_reaches(cx: Cx, s: Stmt): bool {
    match s.kind {
        StmtKind.Expression(e) => { return __tx_reaches(cx, e); }
        StmtKind.Let(_, _, init) => {
            match init {
                Option.Some(e) => { return __tx_reaches(cx, e); }
                _ => { return false; }
            }
        }
        StmtKind.LetTuple(_, e) => { return __tx_reaches(cx, e); }
        StmtKind.Block(ss) => { return __tx_all_reach(cx, ss); }
        StmtKind.If(c, t, e) => {
            if (__tx_reaches(cx, c) || __tx_stmt_reaches(cx, t)) { return true; }
            match e {
                Option.Some(x) => { return __tx_stmt_reaches(cx, x); }
                _ => { return false; }
            }
        }
        StmtKind.While(c, b) => { return __tx_reaches(cx, c) || __tx_stmt_reaches(cx, b); }
        StmtKind.ForIn(_, over, b) => { return __tx_reaches(cx, over) || __tx_stmt_reaches(cx, b); }
        StmtKind.Return(value) => {
            match value {
                Option.Some(e) => { return __tx_reaches(cx, e); }
                _ => { return false; }
            }
        }
        StmtKind.Defer(d) => { return __tx_stmt_reaches(cx, d); }
        StmtKind.Match(x, arms) => {
            if (__tx_reaches(cx, x)) { return true; }
            for (a in arms) { if (__tx_all_reach(cx, a.body)) { return true; } }
            return false;
        }
        StmtKind.Declare(d) => {
            match d.kind {
                DeclKind.Fn(f) => { return __tx_all_reach(cx, f.body); }
                _ => { return false; }
            }
        }
        _ => { return false; }
    }
}

fn __tx_all_reach(cx: Cx, ss: List<Stmt>): bool {
    for (s in ss) { if (__tx_stmt_reaches(cx, s)) { return true; } }
    return false;
}

fn __tx_reaches(cx: Cx, e: Expr): bool {
    match e.kind {
        ExprKind.Call(f, args) => { if (__tx_controls(cx, f, args)) { return true; } }
        ExprKind.Lambda(_, _, body) => { return __tx_all_reach(cx, body); }
        ExprKind.Match(x, arms) => {
            if (__tx_reaches(cx, x)) { return true; }
            for (a in arms) { if (__tx_valued_reaches(cx, a.body)) { return true; } }
            return false;
        }
        ExprKind.Run(_, body, clauses) => {
            if (__tx_is_bound(clauses)) { return __tx_valued_reaches(__tx_run_cx(cx, body, clauses), body); }
            return __tx_valued_reaches(cx, body);
        }
        _ => {}
    }
    for (c in __tx_children(e)) {
        if (__tx_reaches(cx, c)) { return true; }
    }
    return false;
}

fn __tx_valued_reaches(cx: Cx, b: ValuedBlock): bool {
    if (__tx_all_reach(cx, b.stmts)) { return true; }
    match b.value {
        Option.Some(v) => { return __tx_reaches(cx, v); }
        _ => { return false; }
    }
}

// ---- an arm that drops its continuation ----

/** Each handler's methods: one that takes control and never names its continuation discontinues it on its way out. */
fn __tx_discontinuing(clauses: List<HandlerClause>): List<HandlerClause> {
    var out: List<HandlerClause> = [];
    for (c in clauses) {
        match c {
            HandlerClause.Bound(label, h, value) => {
                match value {
                    Option.Some(s) => {
                        match s.kind {
                            StmtKind.Let(hv, ty, init) => {
                                match init {
                                    Option.Some(record) => {
                                        match record.kind {
                                            ExprKind.Record(fields) => {
                                                var methods: List<FieldInit> = [];
                                                for (f in fields) {
                                                    methods.push(FieldInit { name: f.name, value: __tx_dropping(label, f.name, f.value) });
                                                }
                                                var made = __tx_rebuilt(record, ExprKind.Record(methods));
                                                out.push(HandlerClause.Bound(label, h, Option.Some(__tx_restmt(s, StmtKind.Let(hv, ty, Option.Some(made))))));
                                            }
                                            _ => { out.push(c); }
                                        }
                                    }
                                    _ => { out.push(c); }
                                }
                            }
                            _ => { out.push(c); }
                        }
                    }
                    _ => { out.push(c); }
                }
            }
            _ => { out.push(c); }
        }
    }
    return out;
}

fn __tx_dropping(label: Name, method: Name, m: Expr): Expr {
    match operation_in(label, method) {
        Option.Some(op) => {
            if (!op.takes_control) { return m; }
        }
        _ => { return m; }
    }
    match m.kind {
        ExprKind.Lambda(params, sg, body) => {
            if (params.len() == 0) { return m; }
            var k = params[params.len() - 1].name;
            if (__tx_mentions_all(body, k)) { return m; }
            var dropped = __tx_dropped(body, k);
            if (body.len() == 0 || !__tx_leaves(body[body.len() - 1])) { dropped.push(__tx_discontinue_stmt(k)); }
            return __tx_rebuilt(m, ExprKind.Lambda(params, sg, dropped));
        }
        _ => { return m; }
    }
}

fn __tx_discontinue_stmt(k: Name): Stmt {
    return Stmt.of(StmtKind.Expression(__tx_call(Expr.of(ExprKind.Var("discontinue".as_name())), [Expr.of(ExprKind.Var(k))])));
}

/** An arm's statements, with `k` discontinued before each `return` that leaves the arm. */
fn __tx_dropped(ss: List<Stmt>, k: Name): List<Stmt> {
    var out: List<Stmt> = [];
    for (s in ss) { out.push(__tx_dropped_stmt(s, k)); }
    return out;
}

fn __tx_dropped_stmt(s: Stmt, k: Name): Stmt {
    match s.kind {
        StmtKind.Return(value) => {
            match value {
                Option.Some(e) => {
                    var t = fresh("t");
                    return __tx_block_stmt([
                        Stmt.of(StmtKind.Let(t, Option.None, Option.Some(e))),
                        __tx_discontinue_stmt(k),
                        __tx_restmt(s, StmtKind.Return(Option.Some(Expr { kind: ExprKind.Var(t), span: e.span, ty: e.ty })))
                    ]);
                }
                _ => { return __tx_block_stmt([__tx_discontinue_stmt(k), s]); }
            }
        }
        StmtKind.Block(ss) => { return __tx_restmt(s, StmtKind.Block(__tx_dropped(ss, k))); }
        StmtKind.If(c, t, e) => {
            var otherwise: Option<Stmt> = Option.None;
            match e {
                Option.Some(x) => { otherwise = Option.Some(__tx_dropped_stmt(x, k)); }
                _ => {}
            }
            return __tx_restmt(s, StmtKind.If(c, __tx_dropped_stmt(t, k), otherwise));
        }
        StmtKind.While(c, b) => { return __tx_restmt(s, StmtKind.While(c, __tx_dropped_stmt(b, k))); }
        StmtKind.ForIn(ns, over, b) => { return __tx_restmt(s, StmtKind.ForIn(ns, over, __tx_dropped_stmt(b, k))); }
        StmtKind.Match(x, arms) => {
            var out: List<MatchArm> = [];
            for (a in arms) { out.push(MatchArm { pattern: a.pattern, body: __tx_dropped(a.body, k) }); }
            return __tx_restmt(s, StmtKind.Match(x, out));
        }
        _ => { return s; }
    }
}

fn __tx_mentions_all(ss: List<Stmt>, n: Name): bool {
    for (s in ss) { if (__tx_mentions_stmt(s, n)) { return true; } }
    return false;
}

fn __tx_mentions_stmt(s: Stmt, n: Name): bool {
    var found = false;
    __tx_stmt_map(s, (e: Expr) => {
        if (__tx_mentions(e, n)) { found = true; }
        return e;
    }, (c: Stmt) => {
        if (__tx_mentions_stmt(c, n)) { found = true; }
        return c;
    });
    match s.kind {
        StmtKind.Declare(d) => {
            match d.kind {
                DeclKind.Fn(f) => { if (__tx_mentions_all(f.body, n)) { found = true; } }
                _ => {}
            }
        }
        _ => {}
    }
    return found;
}

fn __tx_mentions(e: Expr, n: Name): bool {
    match e.kind {
        ExprKind.Var(x) => { return x == n; }
        ExprKind.Lambda(_, _, body) => { return __tx_mentions_all(body, n); }
        ExprKind.Match(x, arms) => {
            if (__tx_mentions(x, n)) { return true; }
            for (a in arms) {
                if (__tx_mentions_all(a.body.stmts, n)) { return true; }
                match a.body.value {
                    Option.Some(v) => { if (__tx_mentions(v, n)) { return true; } }
                    _ => {}
                }
            }
            return false;
        }
        ExprKind.Run(_, body, _) => {
            if (__tx_mentions_all(body.stmts, n)) { return true; }
            match body.value {
                Option.Some(v) => { return __tx_mentions(v, n); }
                _ => { return false; }
            }
        }
        _ => {}
    }
    for (c in __tx_children(e)) { if (__tx_mentions(c, n)) { return true; } }
    return false;
}

// ---- structure ----

/** The expressions evaluated as part of `e`, but for a function value's body and a `match`'s arms. */
fn __tx_children(e: Expr): List<Expr> {
    match e.kind {
        ExprKind.Assign(_, a) => { return [a]; }
        ExprKind.Unary(_, a) => { return [a]; }
        ExprKind.Binary(_, a, b) => { return [a, b]; }
        ExprKind.And(a, b) => { return [a, b]; }
        ExprKind.Or(a, b) => { return [a, b]; }
        ExprKind.Call(f, args) => { return __tx_cons(f, args); }
        ExprKind.MethodCall(r, _, args) => { return __tx_cons(r, args); }
        ExprKind.StaticCall(f, _, args) => { return __tx_cons(f, args); }
        ExprKind.Compound(_, _, a) => { return [a]; }
        ExprKind.CompoundIndex(_, a, i, v) => { return [a, i, v]; }
        ExprKind.CompoundField(_, r, _, v) => { return [r, v]; }
        ExprKind.Index(a, i) => { return [a, i]; }
        ExprKind.IndexAssign(a, i, v) => { return [a, i, v]; }
        ExprKind.Tuple(items) => { return items; }
        ExprKind.TupleGet(t, _) => { return [t]; }
        ExprKind.Spread(a) => { return [a]; }
        ExprKind.Record(fields) => { return __tx_values_of(fields); }
        ExprKind.Field(r, _) => { return [r]; }
        ExprKind.FieldAssign(r, _, v) => { return [r, v]; }
        ExprKind.New(_, fields) => { return __tx_values_of(fields); }
        ExprKind.NewCall(_, _, args) => { return args; }
        ExprKind.NewGeneric(_, _, fields) => { return __tx_values_of(fields); }
        ExprKind.NewVariant(_, _, payload) => {
            match payload {
                Args.Positional(items) => { return items; }
                Args.Named(fields) => { return __tx_values_of(fields); }
                _ => { return []; }
            }
        }
        ExprKind.Collection(items) => { return items; }
        ExprKind.Match(x, _) => { return [x]; }
        _ => { return []; }
    }
}

/** `e` with `f` applied to each expression `__tx_children` gives of it. */
fn __tx_map(e: Expr, f: (Expr) -> Expr): Expr {
    var all = (es: List<Expr>) => {
        var out: List<Expr> = [];
        for (x in es) { out.push(f(x)); }
        return out;
    };
    var inits = (fields: List<FieldInit>) => {
        var out: List<FieldInit> = [];
        for (x in fields) { out.push(FieldInit { name: x.name, value: f(x.value) }); }
        return out;
    };
    match e.kind {
        ExprKind.Assign(n, a) => { return __tx_rebuilt(e, ExprKind.Assign(n, f(a))); }
        ExprKind.Unary(op, a) => { return __tx_rebuilt(e, ExprKind.Unary(op, f(a))); }
        ExprKind.Binary(op, a, b) => { return __tx_rebuilt(e, ExprKind.Binary(op, f(a), f(b))); }
        ExprKind.And(a, b) => { return __tx_rebuilt(e, ExprKind.And(f(a), f(b))); }
        ExprKind.Or(a, b) => { return __tx_rebuilt(e, ExprKind.Or(f(a), f(b))); }
        ExprKind.Call(c, args) => { return __tx_rebuilt(e, ExprKind.Call(f(c), all(args))); }
        ExprKind.MethodCall(r, m, args) => { return __tx_rebuilt(e, ExprKind.MethodCall(f(r), m, all(args))); }
        ExprKind.StaticCall(c, sa, args) => { return __tx_rebuilt(e, ExprKind.StaticCall(f(c), sa, all(args))); }
        ExprKind.Compound(op, n, a) => { return __tx_rebuilt(e, ExprKind.Compound(op, n, f(a))); }
        ExprKind.CompoundIndex(op, a, i, v) => { return __tx_rebuilt(e, ExprKind.CompoundIndex(op, f(a), f(i), f(v))); }
        ExprKind.CompoundField(op, r, n, v) => { return __tx_rebuilt(e, ExprKind.CompoundField(op, f(r), n, f(v))); }
        ExprKind.Index(a, i) => { return __tx_rebuilt(e, ExprKind.Index(f(a), f(i))); }
        ExprKind.IndexAssign(a, i, v) => { return __tx_rebuilt(e, ExprKind.IndexAssign(f(a), f(i), f(v))); }
        ExprKind.Tuple(items) => { return __tx_rebuilt(e, ExprKind.Tuple(all(items))); }
        ExprKind.TupleGet(t, i) => { return __tx_rebuilt(e, ExprKind.TupleGet(f(t), i)); }
        ExprKind.Spread(a) => { return __tx_rebuilt(e, ExprKind.Spread(f(a))); }
        ExprKind.Record(fields) => { return __tx_rebuilt(e, ExprKind.Record(inits(fields))); }
        ExprKind.Field(r, n) => { return __tx_rebuilt(e, ExprKind.Field(f(r), n)); }
        ExprKind.FieldAssign(r, n, v) => { return __tx_rebuilt(e, ExprKind.FieldAssign(f(r), n, f(v))); }
        ExprKind.New(t, fields) => { return __tx_rebuilt(e, ExprKind.New(t, inits(fields))); }
        ExprKind.NewCall(t, targs, args) => { return __tx_rebuilt(e, ExprKind.NewCall(t, targs, all(args))); }
        ExprKind.NewGeneric(t, sa, fields) => { return __tx_rebuilt(e, ExprKind.NewGeneric(t, sa, inits(fields))); }
        ExprKind.NewVariant(t, v, payload) => {
            match payload {
                Args.Positional(items) => { return __tx_rebuilt(e, ExprKind.NewVariant(t, v, Args.Positional(all(items)))); }
                Args.Named(fields) => { return __tx_rebuilt(e, ExprKind.NewVariant(t, v, Args.Named(inits(fields)))); }
                _ => { return e; }
            }
        }
        ExprKind.Collection(items) => { return __tx_rebuilt(e, ExprKind.Collection(all(items))); }
        _ => { return e; }
    }
}

/** `s` with `fe` applied to each expression it holds and `fs` to each statement, but for a declaration's. */
fn __tx_stmt_map(s: Stmt, fe: (Expr) -> Expr, fs: (Stmt) -> Stmt): Stmt {
    var some = (e: Option<Expr>) => {
        match e {
            Option.Some(x) => { return Option.Some(fe(x)); }
            _ => { return e; }
        }
    };
    match s.kind {
        StmtKind.Expression(e) => { return __tx_restmt(s, StmtKind.Expression(fe(e))); }
        StmtKind.Let(x, ty, init) => { return __tx_restmt(s, StmtKind.Let(x, ty, some(init))); }
        StmtKind.LetTuple(xs, e) => { return __tx_restmt(s, StmtKind.LetTuple(xs, fe(e))); }
        StmtKind.Block(ss) => {
            var out: List<Stmt> = [];
            for (x in ss) { out.push(fs(x)); }
            return __tx_restmt(s, StmtKind.Block(out));
        }
        StmtKind.If(c, t, e) => {
            var otherwise: Option<Stmt> = Option.None;
            match e {
                Option.Some(x) => { otherwise = Option.Some(fs(x)); }
                _ => {}
            }
            return __tx_restmt(s, StmtKind.If(fe(c), fs(t), otherwise));
        }
        StmtKind.While(c, b) => { return __tx_restmt(s, StmtKind.While(fe(c), fs(b))); }
        StmtKind.ForIn(ns, over, b) => { return __tx_restmt(s, StmtKind.ForIn(ns, fe(over), fs(b))); }
        StmtKind.Return(value) => { return __tx_restmt(s, StmtKind.Return(some(value))); }
        StmtKind.Defer(d) => { return __tx_restmt(s, StmtKind.Defer(fs(d))); }
        StmtKind.Match(x, arms) => {
            var out: List<MatchArm> = [];
            for (a in arms) {
                var body: List<Stmt> = [];
                for (b in a.body) { body.push(fs(b)); }
                out.push(MatchArm { pattern: a.pattern, body: body });
            }
            return __tx_restmt(s, StmtKind.Match(fe(x), out));
        }
        _ => { return s; }
    }
}

// ---- building ----

fn __tx_tail(stmts: List<Stmt>, value: Expr): Tail { return Tail { stmts: stmts, value: Option.Some(value) }; }

fn __tx_done(stmts: List<Stmt>): Tail { return Tail { stmts: stmts, value: Option.None }; }

fn __tx_prepend(before: List<Stmt>, t: Tail): Tail {
    var stmts: List<Stmt> = [];
    for (s in before) { stmts.push(s); }
    for (s in t.stmts) { stmts.push(s); }
    return Tail { stmts: stmts, value: t.value };
}

/** A tail as a function's body: its statements, then its value returned. */
fn __tx_body(t: Tail): List<Stmt> {
    var stmts: List<Stmt> = [];
    for (s in t.stmts) { stmts.push(s); }
    match t.value {
        Option.Some(v) => { stmts.push(Stmt.of(StmtKind.Return(Option.Some(v)))); }
        _ => {}
    }
    return stmts;
}

/** A tail as one expression: its value, or a function holding it called at once. */
fn __tx_expr_of(t: Tail): Expr {
    if (t.stmts.len() == 0) {
        match t.value {
            Option.Some(v) => { return v; }
            _ => {}
        }
    }
    return __tx_call(__tx_lambda([], __tx_body(t)), []);
}

fn __tx_lambda(params: List<Param>, body: List<Stmt>): Expr {
    return Expr.of(ExprKind.Lambda(params, __tx_own_sg(Option.None), body));
}

fn __tx_is_own(sg: Signature): bool {
    for (p in sg.static_params) { if (p.name == plain_marker()) { return true; } }
    return false;
}

/** A function this makes for itself binds what it performs where it is written, and is handed no evidence. */
fn __tx_own_sg(ret: Option<TypeExpr>): Signature {
    return Signature { ret: ret, row: Option.None, static_params: [StaticParam { name: plain_marker(), ty: Option.None, pack: false }] };
}

fn __tx_stmts_of(s: Stmt): List<Stmt> {
    match s.kind {
        StmtKind.Block(ss) => { return ss; }
        _ => { return [s]; }
    }
}

fn __tx_block_stmt(ss: List<Stmt>): Stmt { return Stmt.of(StmtKind.Block(ss)); }

fn __tx_return_call(f: Expr, v: Expr): Stmt { return Stmt.of(StmtKind.Return(Option.Some(__tx_call(f, [v])))); }

fn __tx_named(name: string): TypeExpr { return TypeExpr.of(TypeKind.Named(name.as_name())); }

fn __tx_typed_var(n: Name, t: TypeExpr): Expr {
    return Expr { kind: ExprKind.Var(n), span: __span_generated(), ty: Option.Some(t) };
}

/** The statement that still evaluates what is left of an expression statement, if anything is. */
fn __tx_evaluated(v: Expr): List<Stmt> {
    match v.kind {
        ExprKind.Var(_) => { return []; }
        _ => {}
    }
    if (__tx_literal(v)) { return []; }
    return [Stmt.of(StmtKind.Expression(v))];
}

fn __tx_literal(e: Expr): bool {
    match e.kind {
        ExprKind.Unit => { return true; }
        ExprKind.Int(_) => { return true; }
        ExprKind.Float(_) => { return true; }
        ExprKind.Str(_) => { return true; }
        ExprKind.Char(_) => { return true; }
        ExprKind.Bool(_) => { return true; }
        _ => { return false; }
    }
}

fn __tx_call(f: Expr, args: List<Expr>): Expr { return Expr.of(ExprKind.Call(f, args)); }

fn __tx_rebuilt(e: Expr, kind: ExprKind): Expr { return Expr { kind: kind, span: e.span, ty: e.ty }; }

fn __tx_restmt(s: Stmt, kind: StmtKind): Stmt { return Stmt { kind: kind, span: s.span }; }

fn __tx_cons(x: Expr, xs: List<Expr>): List<Expr> {
    var out = [x];
    for (e in xs) { out.push(e); }
    return out;
}

fn __tx_cons_name(x: Name, xs: List<Name>): List<Name> {
    var out = [x];
    for (n in xs) { out.push(n); }
    return out;
}

fn __tx_snoc(xs: List<Expr>, x: Expr): List<Expr> {
    var out: List<Expr> = [];
    for (e in xs) { out.push(e); }
    out.push(x);
    return out;
}

fn __tx_from(xs: List<Expr>, start: int): List<Expr> {
    var out: List<Expr> = [];
    for (var i = start; i < xs.len(); i += 1) { out.push(xs[i]); }
    return out;
}

fn __tx_values_of(fields: List<FieldInit>): List<Expr> {
    var out: List<Expr> = [];
    for (f in fields) { out.push(f.value); }
    return out;
}

fn __tx_fields(fields: List<FieldInit>, values: List<Expr>): List<FieldInit> {
    var out: List<FieldInit> = [];
    for (var i = 0; i < fields.len(); i += 1) { out.push(FieldInit { name: fields[i].name, value: values[i] }); }
    return out;
}
