/**
 * The fixed-size array, and slicing it.
 *
 * An array is the primitive every other collection is built on: its length is
 * fixed at construction and `Array<T>(n, v)` is how one is made, with `v` in
 * every slot. A list literal builds one first, so `[1, 2, 3]` is an array
 * before whatever it was annotated with gets it.
 *
 * ```
 * var row = Array<int>(3, 0);
 * row[0] = 7;
 * print(row.len());   // 3
 * ```
 *
 * `filled` builds one of more than one dimension:
 *
 * ```
 * import { filled } from "std/core/Array";
 *
 * var grid = filled<2, int>([3, 3], 0);
 * grid[1][1] = 5;
 * ```
 */

import { __span } from "Range";

impl Array<T> {
    /** Whether any slot holds a value equal to this one. */
    fn contains(self, v: T): bool {
        var i = 0;
        while (i < self.len()) {
            if (self[i] == v) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}

// Nothing in Cronyx can raise, so an index a list must reject is aimed past its
// backing array and the array's own bounds check does the rejecting. Passing the
// index straight through would not do: the spare capacity behind `count` holds
// values that were left there.
fn __past_end<T>(items: Array<T>): int {
    return items.len();
}

// Slicing is indexing by a range, so it is the same operator over a different
// index — and it copies, because a view would need to say how long it lives.
impl Index<Range> for Array<T> {
    type Output = Array<T>;

    /** A new array holding the slots the range covers. */
    fn get(self, r: Range): Array<T> {
        var bounds = __span(r, self.len());
        return __array_copy(self, bounds.0, bounds.1);
    }
}

// A level passes on the extents it has not spent, so `dims.len() == n` says the
// same thing at every depth and only the outermost call can be the one that
// broke it. `Array<T>(len, v)` puts the one `v` in every slot, so the seed is
// written over from 1 up; left alone it would alias every row to the first.
/**
 * An `n`-deep array of arrays, with `fill` in every leaf.
 *
 * `n` is a static *value*, not a type, because it decides the return type: the
 * copy `filled<2, int>` is the one that answers with `Array<Array<int>>`. It
 * must equal the number of extents given, and panics if it does not.
 *
 * Every slot gets a subtree of its own rather than sharing one, so writing to
 * `grid[1][1]` does not write to every row.
 */
fn filled<n: int, T>(dims: Array<int>, fill: T) {
    if (dims.len() != n) {
        panic("filled<" + str(n) + "> takes " + str(n) + " dimensions, but " + str(dims.len()) + " were given.");
    }
    meta if (n == 0) {
        gen return fill;
    } else {
        gen var len = dims[0];
        gen var rest = dims[1:];
        gen var out = Array(len, filled<n - 1, T>(rest, fill));
        gen var i = 1;
        gen while (i < len) {
            out[i] = filled<n - 1, T>(rest, fill);
            i = i + 1;
        }
        gen return out;
    }
}
