/**
 * The terminal: standard output and standard error.
 *
 * ```
 * print("hello");                 // standard output, and a newline
 * printerr("warning: no config");   // standard error
 * ```
 *
 * In core because the compiler names it: every program's top level runs under
 * the prelude's `__root`, which handles it. A test captures output by handling
 * it too:
 *
 * ```
 * var said: List<string> = [];
 * run { print("hi"); } handle Console {
 *     fn write(to, text) { said.push(text); }
 * }
 * ```
 *
 * Writing is synchronous, as console output is in every mainstream runtime,
 * so a function that prints is not put through continuations for it.
 */

/** Which of the two output streams. */
type Stream {
    /** Standard output. */
    Out,

    /** Standard error. */
    Err
}

/** The process's standard streams. */
effect Console {
    /** Writes the text to the stream as it is, with nothing added. */
    fn write(to: Stream, text: string): unit;
}
