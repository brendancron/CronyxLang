/**
 * A sequence pulled one value at a time.
 *
 * ```
 * import { Yield, iterator } from "std/iter/Yield";
 *
 * for (n in iterator { yield(1); yield(2); }) { print(n); }
 * ```
 *
 * In core because `for` takes one, and closes it when the loop is left early.
 */

/**
 * `next` hands out the next value, or `None` once there are none, and `close`
 * lets go of what the sequence still holds when nobody will ask again.
 *
 * `E` is what pulling a value performs, so reading a file line by line is an
 * `Iter<string, <async, Throw<IoError>>>`: the effects happen where it is
 * pulled rather than where it was made.
 */
type Iter<T, E> {
    /** The next value, or `None` at the end. */
    next: () -> <E> Option<T>,

    /** Finishes with the sequence. Asking for more afterwards answers `None`. */
    close: () -> unit
}

/**
 * A collection whose items can be pulled one at a time, which is what lets
 * one function take a `List` or an `Array`:
 *
 * ```
 * fn total<C: Iterable<int>>(items: C): int {
 *     var sum = 0;
 *     for (n in items.iter()) { sum += n; }
 *     return sum;
 * }
 * ```
 */
trait Iterable<T> {
    /** Each item in order. */
    fn iter(self): Iter<T, <>>;
}

impl Iterable<T> for List<T> {
    fn iter(self): Iter<T, <>> {
        var items = self;
        var at = 0;
        return Iter {
            next: () => {
                if (at >= items.len()) { return Option.None; }
                at += 1;
                return Option.Some(items[at - 1]);
            },
            close: () => {}
        };
    }
}

impl Iterable<T> for Array<T> {
    fn iter(self): Iter<T, <>> {
        var items = self;
        var at = 0;
        return Iter {
            next: () => {
                if (at >= items.len()) { return Option.None; }
                at += 1;
                return Option.Some(items[at - 1]);
            },
            close: () => {}
        };
    }
}
