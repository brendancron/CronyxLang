/**
 * `RegexAst` to an NFA.
 *
 * Thompson's construction: every node becomes a fragment with one start and one
 * end, joined by transitions that consume nothing. `std/automata/Dfa` is what
 * makes the result deterministic.
 */

import { Nfa, Transition, epsilon } from "../automata/Nfa";
import { RegexAst, RegexNode } from "RegexAst";

type Fragment {
    start: int,
    end: int
}

// Thompson's construction. Symbols are code points, and `.` is expanded to
// printable ASCII here rather than being a wildcard the simulator knows about.
fn build(ast: RegexAst): Nfa {
    var states: List<int> = [];
    var alphabet: List<int> = [];
    var transitions: List<Transition> = [];
    var counter: List<int> = [0];

    var frag = build_node(states, alphabet, transitions, counter, ast, ast.root);
    var accept: List<int> = [frag.end];

    return Nfa {
        states: states,
        alphabet: alphabet,
        transitions: transitions,
        start: frag.start,
        accept: accept
    };
}

fn fresh(states: List<int>, counter: List<int>): int {
    var id = counter[0];
    counter[0] = id + 1;
    states.push(id);
    return id;
}

fn add_symbol(alphabet: List<int>, cp: int) {
    for (known in alphabet) {
        if (known == cp) { return; }
    }
    alphabet.push(cp);
}

fn add_trans(transitions: List<Transition>, src: int, cp: int, to: int) {
    transitions.push(Transition { src: src, on: cp, to: to });
}

fn add_eps(transitions: List<Transition>, src: int, to: int) {
    transitions.push(Transition { src: src, on: epsilon(), to: to });
}

fn build_node(
    states: List<int>,
    alphabet: List<int>,
    transitions: List<Transition>,
    counter: List<int>,
    ast: RegexAst,
    node_id: int
): Fragment {
    match ast.nodes[node_id] {
        RegexNode.Literal(cp) => {
            return build_literal(states, alphabet, transitions, counter, cp);
        }
        RegexNode.Concat(left, right) => {
            var l = build_node(states, alphabet, transitions, counter, ast, left);
            var r = build_node(states, alphabet, transitions, counter, ast, right);
            add_eps(transitions, l.end, r.start);
            return Fragment { start: l.start, end: r.end };
        }
        RegexNode.Alt(left, right) => {
            var s = fresh(states, counter);
            var e = fresh(states, counter);
            var l = build_node(states, alphabet, transitions, counter, ast, left);
            var r = build_node(states, alphabet, transitions, counter, ast, right);
            add_eps(transitions, s, l.start);
            add_eps(transitions, s, r.start);
            add_eps(transitions, l.end, e);
            add_eps(transitions, r.end, e);
            return Fragment { start: s, end: e };
        }
        RegexNode.Star(child) => {
            var s = fresh(states, counter);
            var e = fresh(states, counter);
            var c = build_node(states, alphabet, transitions, counter, ast, child);
            add_eps(transitions, s, c.start);
            add_eps(transitions, s, e);
            add_eps(transitions, c.end, c.start);
            add_eps(transitions, c.end, e);
            return Fragment { start: s, end: e };
        }
        RegexNode.Plus(child) => {
            var e = fresh(states, counter);
            var c = build_node(states, alphabet, transitions, counter, ast, child);
            add_eps(transitions, c.end, c.start);
            add_eps(transitions, c.end, e);
            return Fragment { start: c.start, end: e };
        }
        RegexNode.Quest(child) => {
            var s = fresh(states, counter);
            var e = fresh(states, counter);
            var c = build_node(states, alphabet, transitions, counter, ast, child);
            add_eps(transitions, s, c.start);
            add_eps(transitions, s, e);
            add_eps(transitions, c.end, e);
            return Fragment { start: s, end: e };
        }
        RegexNode.Dot => {
            return build_range(states, alphabet, transitions, counter);
        }
        RegexNode.Class(chars, negated) => {
            return build_class(states, alphabet, transitions, counter, chars, negated);
        }
        RegexNode.Empty => {
            var s = fresh(states, counter);
            return Fragment { start: s, end: s };
        }
    }
}

fn build_literal(
    states: List<int>,
    alphabet: List<int>,
    transitions: List<Transition>,
    counter: List<int>,
    cp: int
): Fragment {
    var s = fresh(states, counter);
    var e = fresh(states, counter);
    add_trans(transitions, s, cp, e);
    add_symbol(alphabet, cp);
    return Fragment { start: s, end: e };
}

fn build_range(
    states: List<int>,
    alphabet: List<int>,
    transitions: List<Transition>,
    counter: List<int>
): Fragment {
    var s = fresh(states, counter);
    var e = fresh(states, counter);
    var cp = 32;
    while (cp <= 126) {
        add_trans(transitions, s, cp, e);
        add_symbol(alphabet, cp);
        cp = cp + 1;
    }
    return Fragment { start: s, end: e };
}

fn build_class(
    states: List<int>,
    alphabet: List<int>,
    transitions: List<Transition>,
    counter: List<int>,
    chars: List<int>,
    negated: bool
): Fragment {
    var s = fresh(states, counter);
    var e = fresh(states, counter);
    if (negated) {
        var cp = 32;
        while (cp <= 126) {
            if (!contains(chars, cp)) {
                add_trans(transitions, s, cp, e);
                add_symbol(alphabet, cp);
            }
            cp = cp + 1;
        }
    } else {
        for (cp in chars) {
            add_trans(transitions, s, cp, e);
            add_symbol(alphabet, cp);
        }
    }
    return Fragment { start: s, end: e };
}

fn contains(items: List<int>, val: int): bool {
    for (item in items) {
        if (item == val) { return true; }
    }
    return false;
}
