// Nodes live in one list and refer to their children by index, so a pattern
// of any depth costs no recursion to build or to walk.
type RegexNode {
    Literal(int),          // a code point
    Concat(int, int),
    Alt(int, int),
    Star(int),
    Plus(int),
    Quest(int),
    Dot,
    Class(List<int>, bool), // allowed code points, and whether negated
    Empty
}

type RegexAst {
    nodes: List<RegexNode>,
    root: int
}

fn make(): RegexAst {
    var nodes: List<RegexNode> = [];
    return new RegexAst { nodes: nodes, root: 0 };
}

fn push(ast: RegexAst, node: RegexNode): int {
    var id = ast.nodes.len();
    ast.nodes.push(node);
    return id;
}

fn literal(ast: RegexAst, cp: int): int { return push(ast, RegexNode::Literal(cp)); }
fn concat(ast: RegexAst, left: int, right: int): int {
    return push(ast, RegexNode::Concat(left, right));
}
fn alt(ast: RegexAst, left: int, right: int): int {
    return push(ast, RegexNode::Alt(left, right));
}
fn star(ast: RegexAst, child: int): int { return push(ast, RegexNode::Star(child)); }
fn plus(ast: RegexAst, child: int): int { return push(ast, RegexNode::Plus(child)); }
fn quest(ast: RegexAst, child: int): int { return push(ast, RegexNode::Quest(child)); }
fn dot(ast: RegexAst): int { return push(ast, RegexNode::Dot); }
fn class(ast: RegexAst, chars: List<int>, negated: bool): int {
    return push(ast, RegexNode::Class(chars, negated));
}
fn empty(ast: RegexAst): int { return push(ast, RegexNode::Empty); }
