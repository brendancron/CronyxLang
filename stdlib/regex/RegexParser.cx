/**
 * Pattern text to `RegexAst`.
 *
 * A recursive-descent parser over the usual precedence: alternation, then
 * concatenation, then the postfix repeats, then a term. Panics on a pattern it
 * cannot read, which `std/lang/Regex.compile` is the caller of.
 */

import { RegexAst, make, literal, concat, alt, star, plus, quest, dot, class, empty }
    from "RegexAst";

// A node index and where the parse stopped. `no_node` is what a level returns
// when it consumed nothing, which is how a term knows it is empty.
fn no_node(): int { return 0 - 1; }

type ParseResult {
    node: int,
    pos: int
}

fn found(node: int, pos: int): ParseResult {
    return ParseResult { node: node, pos: pos };
}

fn parse(pattern: string): RegexAst {
    var cps: List<int> = [];
    for (c in pattern.chars()) { cps.push(ord(c)); }
    var ast = make();
    var parsed = parse_expr(ast, cps, 0);
    ast.root = parsed.node;
    return ast;
}

fn parse_expr(ast: RegexAst, cps: List<int>, pos: int): ParseResult {
    var left = parse_term(ast, cps, pos);
    var cur = left.pos;
    var node = left.node;

    while (cur < cps.len() && cps[cur] == ord('|')) {
        cur = cur + 1;
        var right = parse_term(ast, cps, cur);
        cur = right.pos;
        node = alt(ast, node, right.node);
    }

    return found(node, cur);
}

fn parse_term(ast: RegexAst, cps: List<int>, pos: int): ParseResult {
    var cur = pos;
    var node = no_node();
    var going = true;

    while (going && cur < cps.len() && cps[cur] != ord('|') && cps[cur] != ord(')')) {
        var before = cur;
        var factor = parse_factor(ast, cps, cur);
        if (factor.pos == before) {
            going = false;
        } else {
            cur = factor.pos;
            if (node == no_node()) { node = factor.node; }
            else { node = concat(ast, node, factor.node); }
        }
    }

    if (node == no_node()) { node = empty(ast); }
    return found(node, cur);
}

fn parse_factor(ast: RegexAst, cps: List<int>, pos: int): ParseResult {
    var atom = parse_atom(ast, cps, pos);
    var cur = atom.pos;
    var node = atom.node;

    if (cur < cps.len()) {
        var c = cps[cur];
        if (c == ord('*')) { node = star(ast, node); cur = cur + 1; }
        else if (c == ord('+')) { node = plus(ast, node); cur = cur + 1; }
        else if (c == ord('?')) { node = quest(ast, node); cur = cur + 1; }
    }

    return found(node, cur);
}

fn parse_atom(ast: RegexAst, cps: List<int>, pos: int): ParseResult {
    if (pos >= cps.len()) { return found(empty(ast), pos); }

    var c = cps[pos];

    if (c == ord('(')) {
        var inner = parse_expr(ast, cps, pos + 1);
        var end = inner.pos;
        if (end < cps.len() && cps[end] == ord(')')) { end = end + 1; }
        return found(inner.node, end);
    }
    if (c == ord('[')) { return parse_class(ast, cps, pos + 1); }
    if (c == ord('.')) { return found(dot(ast), pos + 1); }
    if (c == ord('\\')) { return parse_escape(ast, cps, pos + 1); }

    // Belongs to a level above this one, so stop without consuming it.
    if (c == ord('|') || c == ord(')') || c == ord('*') || c == ord('+') || c == ord('?')) {
        return found(empty(ast), pos);
    }

    return found(literal(ast, c), pos + 1);
}

fn parse_escape(ast: RegexAst, cps: List<int>, pos: int): ParseResult {
    if (pos >= cps.len()) { return found(literal(ast, ord('\\')), pos); }

    var c = cps[pos];

    if (c == ord('n') || c == ord('t') || c == ord('r')) {
        return found(literal(ast, unescape(c)), pos + 1);
    }
    if (c == ord('d')) {
        return found(class(ast, range(ord('0'), ord('9')), false), pos + 1);
    }
    if (c == ord('s')) {
        var spaces: List<int> = [ord(' '), 9, 10, 13];
        return found(class(ast, spaces, false), pos + 1);
    }
    if (c == ord('w')) {
        var word = range(ord('A'), ord('Z'));
        append_range(word, ord('a'), ord('z'));
        append_range(word, ord('0'), ord('9'));
        word.push(ord('_'));
        return found(class(ast, word, false), pos + 1);
    }

    return found(literal(ast, c), pos + 1);
}

fn parse_class(ast: RegexAst, cps: List<int>, pos: int): ParseResult {
    var cur = pos;
    var negated = false;

    if (cur < cps.len() && cps[cur] == ord('^')) {
        negated = true;
        cur = cur + 1;
    }

    var chars: List<int> = [];
    while (cur < cps.len() && cps[cur] != ord(']')) {
        var c = cps[cur];
        if (c == ord('\\') && cur + 1 < cps.len()) {
            chars.push(unescape(cps[cur + 1]));
            cur = cur + 2;
        } else if (cur + 2 < cps.len() && cps[cur + 1] == ord('-') && cps[cur + 2] != ord(']')) {
            append_range(chars, c, cps[cur + 2]);
            cur = cur + 3;
        } else {
            chars.push(c);
            cur = cur + 1;
        }
    }

    if (cur < cps.len()) { cur = cur + 1; }
    return found(class(ast, chars, negated), cur);
}

fn range(lo: int, hi: int): List<int> {
    var out: List<int> = [];
    append_range(out, lo, hi);
    return out;
}

fn append_range(out: List<int>, lo: int, hi: int) {
    var at = lo;
    while (at <= hi) {
        out.push(at);
        at = at + 1;
    }
}

fn unescape(c: int): int {
    if (c == ord('n')) { return 10; }
    if (c == ord('t')) { return 9; }
    if (c == ord('r')) { return 13; }
    return c;
}
