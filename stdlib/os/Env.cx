/**
 * Environment variables.
 *
 * ```
 * import { Env } from "std/os/Env";
 *
 * match env_var("HOME") {
 *     Option.Some(home) => { print(home); }
 *     Option.None => { print("no home"); }
 * }
 * ```
 *
 * The root answers with the environment the program was started in. Setting a
 * variable changes what the program, and every process it starts afterwards,
 * sees.
 */

/** The program's environment variables. */
effect Env {
    /** The variable's value, or `None` if it is not set. */
    fn env_var(name: string): Option<string>;

    /** Sets the variable, replacing any value it had. */
    fn set_env_var(name: string, value: string): unit;

    /** Unsets the variable. Nothing happens if it was not set. */
    fn remove_env_var(name: string): unit;

    /** Every variable and its value, ordered by name. */
    fn env_vars(): Array<(string, string)>;
}

/** How the root answers `env_var`: from the environment the program started in. */
fn __env_var_of_process(name: string): Option<string> {
    var (found, value) = __env_get(name);
    if (found) { return Option.Some(value); }
    return Option.None;
}
