import { Nfa, epsilon_closure, step, is_accept, set_contains } from "Nfa";

// `no_state` is what a step returns when nothing is reachable — a DFA built
// here is partial, so a dead end is an absent transition rather than a sink.
fn no_state(): int { return 0 - 1; }

type DfaTransition {
    src: int,
    on: int,
    to: int
}

type Dfa {
    states: List<int>,
    alphabet: List<int>,
    transitions: List<DfaTransition>,
    start: int,
    accept: List<int>
}

fn new(start: int): Dfa {
    var states: List<int> = [start];
    var alphabet: List<int> = [];
    var transitions: List<DfaTransition> = [];
    var accept: List<int> = [];
    return Dfa {
        states: states,
        alphabet: alphabet,
        transitions: transitions,
        start: start,
        accept: accept
    };
}

fn dfa_is_accept(dfa: Dfa, id: int): bool { return set_contains(dfa.accept, id); }

fn dfa_step(dfa: Dfa, state: int, symbol: int): int {
    for (t in dfa.transitions) {
        if (t.src == state && t.on == symbol) { return t.to; }
    }
    return no_state();
}

fn simulate(dfa: Dfa, input: List<int>): bool {
    var current = dfa.start;
    for (symbol in input) {
        var next = dfa_step(dfa, current, symbol);
        if (next == no_state()) { return false; }
        current = next;
    }
    return dfa_is_accept(dfa, current);
}

// ── Subset construction ──────────────────────────────────────────────────────

// One DFA state is the set of NFA states reachable together.
type SubsetState {
    id: int,
    nfa_states: List<int>
}

fn subset_construction(nfa: Nfa): Dfa {
    var from: List<int> = [nfa.start];
    var start_closure = epsilon_closure(nfa, from);
    var next_id = 1;

    // Built here rather than through `new`, which names the operator inside
    // the module that declares the function.
    var states: List<int> = [0];
    var alphabet: List<int> = [];
    var transitions: List<DfaTransition> = [];
    var accept: List<int> = [];
    for (symbol in nfa.alphabet) { alphabet.push(symbol); }
    var dfa = Dfa {
        states: states,
        alphabet: alphabet,
        transitions: transitions,
        start: 0,
        accept: accept
    };

    var state_map: List<SubsetState> = [SubsetState { id: 0, nfa_states: start_closure }];
    if (any_accept(nfa, start_closure)) { dfa.accept.push(0); }

    // Walked by index: a state is appended once and visited once.
    var at = 0;
    while (at < state_map.len()) {
        var current = state_map[at];
        for (symbol in dfa.alphabet) {
            var closure = epsilon_closure(nfa, step(nfa, current.nfa_states, symbol));
            if (closure.len() > 0) {
                var existing = find_state(state_map, closure);
                var target = existing;
                if (existing == no_state()) {
                    target = next_id;
                    next_id = next_id + 1;
                    dfa.states.push(target);
                    state_map.push(SubsetState { id: target, nfa_states: closure });
                    if (any_accept(nfa, closure)) { dfa.accept.push(target); }
                }
                dfa.transitions.push(
                    DfaTransition { src: current.id, on: symbol, to: target });
            }
        }
        at = at + 1;
    }

    return dfa;
}

fn find_state(state_map: List<SubsetState>, nfa_states: List<int>): int {
    for (candidate in state_map) {
        if (sets_equal(candidate.nfa_states, nfa_states)) { return candidate.id; }
    }
    return no_state();
}

fn any_accept(nfa: Nfa, states: List<int>): bool {
    for (state in states) {
        if (is_accept(nfa, state)) { return true; }
    }
    return false;
}

fn sets_equal(a: List<int>, b: List<int>): bool {
    if (a.len() != b.len()) { return false; }
    for (member in a) {
        if (!set_contains(b, member)) { return false; }
    }
    return true;
}

impl Dfa {
    fn add_state(self, id: int) { self.states.push(id); }
    fn add_symbol(self, symbol: int) { self.alphabet.push(symbol); }
    fn add_transition(self, src: int, on: int, to: int) {
        self.transitions.push(DfaTransition { src: src, on: on, to: to });
    }
    fn add_accept(self, id: int) { self.accept.push(id); }
    fn step(self, state: int, symbol: int): int { return dfa_step(self, state, symbol); }
    fn accepts(self, input: List<int>): bool { return simulate(self, input); }
    fn is_accept(self, id: int): bool { return dfa_is_accept(self, id); }
}
