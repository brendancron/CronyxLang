/**
 * An effect for the failure a caller is expected to handle.
 *
 * ```
 * import { Error } from "std/lang/Error";
 *
 * fn half(n: int): int <Error> {
 *     if (n % 2 != 0) { throw("not even"); }
 *     return n / 2;
 * }
 *
 * handle Error { ctl throw(msg) { print("failed: " + msg); } } with { half(3); }
 * ```
 *
 * `ctl`, so a handler decides what happens next rather than the call site: it
 * may resume, or it may not.
 */

/** Reported, then whatever the handler decides. */
effect Error {
    /** Reports the failure. Whether anything runs after it is the handler's. */
    ctl throw(msg: string): unit;
}
