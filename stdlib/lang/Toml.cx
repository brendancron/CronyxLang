
// Enough TOML for a configuration file: [sections], string, bool and int
// values, and one level of inline table. No arrays, no multi-line strings,
// no dotted keys.

type Token {
    LBracket,
    RBracket,
    LBrace,
    RBrace,
    Equals,
    Comma,
    Newline,
    Ident(string),
    Str(string),
    Bool(bool),
    Int(int),
    Eof
}

type TomlPrimitive {
    PString(string),
    PInt(int),
    PBool(bool)
}

type TomlInlineEntry {
    key: string,
    val: TomlPrimitive
}

type TomlValue {
    Primitive(TomlPrimitive),
    Table(List<TomlInlineEntry>)
}

type TomlEntry {
    key: string,
    val: TomlValue
}

type TomlSection {
    name: string,
    entries: List<TomlEntry>
}

type TomlDoc {
    sections: List<TomlSection>
}

// ── Tokenizer ────────────────────────────────────────────────────────────────

fn is_ident_start(c: char): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fn is_ident_char(c: char): bool {
    return is_ident_start(c) || (c >= '0' && c <= '9') || c == '-';
}

fn is_digit(c: char): bool { return c >= '0' && c <= '9'; }

fn tokenize(input: string): List<Token> {
    var chars = input.chars();
    var n = chars.len();
    var tokens: List<Token> = [];
    var at = 0;

    while (at < n) {
        var c = chars[at];

        if (c == ' ' || c == '\t' || c == '\r') {
            at = at + 1;
        } else if (c == '\n') {
            tokens.push(Token::Newline);
            at = at + 1;
        } else if (c == '#') {
            while (at < n && chars[at] != '\n') { at = at + 1; }
        } else if (c == '[') { tokens.push(Token::LBracket); at = at + 1; }
        else if (c == ']') { tokens.push(Token::RBracket); at = at + 1; }
        else if (c == '{') { tokens.push(Token::LBrace); at = at + 1; }
        else if (c == '}') { tokens.push(Token::RBrace); at = at + 1; }
        else if (c == '=') { tokens.push(Token::Equals); at = at + 1; }
        else if (c == ',') { tokens.push(Token::Comma); at = at + 1; }
        else if (c == '"') {
            at = at + 1;
            var text = "";
            var closed = false;
            while (at < n && !closed) {
                var sc = chars[at];
                if (sc == '"') {
                    at = at + 1;
                    closed = true;
                } else if (sc == '\\' && at + 1 < n) {
                    text = text + str(unescape(chars[at + 1]));
                    at = at + 2;
                } else {
                    text = text + str(sc);
                    at = at + 1;
                }
            }
            tokens.push(Token::Str(text));
        } else if (is_ident_start(c)) {
            var word = "";
            while (at < n && is_ident_char(chars[at])) {
                word = word + str(chars[at]);
                at = at + 1;
            }
            if (word == "true") { tokens.push(Token::Bool(true)); }
            else if (word == "false") { tokens.push(Token::Bool(false)); }
            else { tokens.push(Token::Ident(word)); }
        } else if (is_digit(c)) {
            var num = 0;
            while (at < n && is_digit(chars[at])) {
                num = num * 10 + (ord(chars[at]) - ord('0'));
                at = at + 1;
            }
            tokens.push(Token::Int(num));
        } else {
            at = at + 1;
        }
    }

    tokens.push(Token::Eof);
    return tokens;
}

fn unescape(c: char): char {
    if (c == 'n') { return '\n'; }
    if (c == 't') { return '\t'; }
    if (c == 'r') { return '\r'; }
    return c;
}

// ── Parser ───────────────────────────────────────────────────────────────────

// The cursor is a one-element list so that each level advances the same one.
fn at(tokens: List<Token>, pos: List<int>): Token { return tokens[pos[0]]; }
fn advance(pos: List<int>) { pos[0] = pos[0] + 1; }

fn is_newline(t: Token): bool {
    match t {
        Token::Newline => { return true; }
        _ => { return false; }
    }
}

fn skip_newlines(tokens: List<Token>, pos: List<int>) {
    while (is_newline(at(tokens, pos))) { advance(pos); }
}

fn parse_primitive(tokens: List<Token>, pos: List<int>): TomlPrimitive {
    var t = at(tokens, pos);
    advance(pos);
    match t {
        Token::Str(text) => { return TomlPrimitive::PString(text); }
        Token::Int(n) => { return TomlPrimitive::PInt(n); }
        Token::Bool(b) => { return TomlPrimitive::PBool(b); }
        _ => { return TomlPrimitive::PString(""); }
    }
}

fn parse_value(tokens: List<Token>, pos: List<int>): TomlValue {
    var opens = false;
    match at(tokens, pos) {
        Token::LBrace => { opens = true; }
        _ => {}
    }

    if (opens) {
        advance(pos);
        var entries: List<TomlInlineEntry> = [];
        var going = true;
        while (going) {
            match at(tokens, pos) {
                Token::RBrace => { advance(pos); going = false; }
                Token::Eof => { going = false; }
                Token::Ident(key) => {
                    advance(pos);
                    advance(pos);
                    entries.push(
                        new TomlInlineEntry { key: key, val: parse_primitive(tokens, pos) });
                }
                _ => { advance(pos); }
            }
        }
        return TomlValue::Table(entries);
    }

    return TomlValue::Primitive(parse_primitive(tokens, pos));
}

fn parse(input: string): TomlDoc {
    var tokens = tokenize(input);
    var pos: List<int> = [0];
    var sections: List<TomlSection> = [];
    var name = "";
    var entries: List<TomlEntry> = [];

    skip_newlines(tokens, pos);

    var going = true;
    while (going) {
        match at(tokens, pos) {
            Token::Eof => { going = false; }
            // A new section closes the one before it, so the entries gathered
            // so far are what it holds.
            Token::LBracket => {
                sections.push(new TomlSection { name: name, entries: entries });
                advance(pos);
                name = section_name(at(tokens, pos));
                advance(pos);
                advance(pos);
                entries = [];
                skip_newlines(tokens, pos);
            }
            Token::Ident(key) => {
                advance(pos);
                advance(pos);
                entries.push(new TomlEntry { key: key, val: parse_value(tokens, pos) });
                skip_newlines(tokens, pos);
            }
            _ => { advance(pos); }
        }
    }

    sections.push(new TomlSection { name: name, entries: entries });
    return new TomlDoc { sections: sections };
}

fn section_name(t: Token): string {
    match t {
        Token::Ident(name) => { return name; }
        Token::Str(text) => { return text; }
        _ => { return ""; }
    }
}

// ── Public API ───────────────────────────────────────────────────────────────

// The section before the first header has no name, and is not one.
fn section_names(doc: TomlDoc): List<string> {
    var names: List<string> = [];
    for (section in doc.sections) {
        if (section.name != "") { names.push(section.name); }
    }
    return names;
}

fn get_section(doc: TomlDoc, name: string): Option<TomlSection> {
    for (section in doc.sections) {
        if (section.name == name) { return Option::Some(section); }
    }
    return Option::None;
}

fn section_entry_keys(section: TomlSection): List<string> {
    var keys: List<string> = [];
    for (entry in section.entries) { keys.push(entry.key); }
    return keys;
}

fn get_entry(section: TomlSection, key: string): Option<TomlEntry> {
    for (entry in section.entries) {
        if (entry.key == key) { return Option::Some(entry); }
    }
    return Option::None;
}

fn get_inline(entries: List<TomlInlineEntry>, key: string): Option<TomlPrimitive> {
    for (entry in entries) {
        if (entry.key == key) { return Option::Some(entry.val); }
    }
    return Option::None;
}

// A value is a primitive of some kind, or a table. Asking which is what the
// caller does before reaching for the value itself.
fn is_string(val: TomlValue): bool {
    match val {
        TomlValue::Primitive(p) => { return prim_is_string(p); }
        _ => { return false; }
    }
}

fn is_int(val: TomlValue): bool {
    match val {
        TomlValue::Primitive(p) => { return prim_is_int(p); }
        _ => { return false; }
    }
}

fn is_bool(val: TomlValue): bool {
    match val {
        TomlValue::Primitive(p) => { return prim_is_bool(p); }
        _ => { return false; }
    }
}

fn is_table(val: TomlValue): bool {
    match val {
        TomlValue::Table(entries) => { return true; }
        _ => { return false; }
    }
}

fn as_string(val: TomlValue): string {
    match val {
        TomlValue::Primitive(p) => { return prim_as_string(p); }
        _ => { return ""; }
    }
}

fn as_int_val(val: TomlValue): int {
    match val {
        TomlValue::Primitive(p) => { return prim_as_int(p); }
        _ => { return 0; }
    }
}

fn as_bool(val: TomlValue): bool {
    match val {
        TomlValue::Primitive(p) => { return prim_as_bool(p); }
        _ => { return false; }
    }
}

fn as_table(val: TomlValue): List<TomlInlineEntry> {
    match val {
        TomlValue::Table(entries) => { return entries; }
        _ => {
            var none: List<TomlInlineEntry> = [];
            return none;
        }
    }
}

fn prim_is_string(p: TomlPrimitive): bool {
    match p {
        TomlPrimitive::PString(s) => { return true; }
        _ => { return false; }
    }
}

fn prim_is_int(p: TomlPrimitive): bool {
    match p {
        TomlPrimitive::PInt(n) => { return true; }
        _ => { return false; }
    }
}

fn prim_is_bool(p: TomlPrimitive): bool {
    match p {
        TomlPrimitive::PBool(b) => { return true; }
        _ => { return false; }
    }
}

fn prim_as_string(p: TomlPrimitive): string {
    match p {
        TomlPrimitive::PString(s) => { return s; }
        _ => { return ""; }
    }
}

fn prim_as_int(p: TomlPrimitive): int {
    match p {
        TomlPrimitive::PInt(n) => { return n; }
        _ => { return 0; }
    }
}

fn prim_as_bool(p: TomlPrimitive): bool {
    match p {
        TomlPrimitive::PBool(b) => { return b; }
        _ => { return false; }
    }
}
