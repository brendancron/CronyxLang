/**
 * An effect for a failure whose handler must produce a value.
 *
 * `raise` is an `fn` operation rather than a `ctl` one, so the handler's answer
 * *is* the call's result and the function carries on. That makes it the shape
 * for a default -- a missing entry standing in as zero -- where `Error` is the
 * shape for abandoning the work.
 */

/** Reported, and answered with a `T` by the handler. */
effect Fallible<T> {
    /** Reports the failure and answers with whatever the handler gives back. */
    fn raise(msg: string): T;
}
