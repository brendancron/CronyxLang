/**
 * Failures, carried as values.
 *
 * ```
 * import { Throw, Result, attempt, rethrow, Wraps } from "std/lang/Throw";
 *
 * type IoError { NotFound(string) }
 * type ParseError { BadLine(int) }
 * type LoadError { Io(IoError), Parse(ParseError) }
 * derive Wraps for LoadError;
 *
 * fn read(path: string): string {
 *     if (path == "missing.toml") { throw(IoError.NotFound(path)); }
 *     return "port = x";
 * }
 *
 * fn parse(text: string): int {
 *     throw(ParseError.BadLine(1));
 *     return 0;
 * }
 *
 * fn load(path: string): <Throw<LoadError>> int {
 *     var text = rethrow { read(path) };
 *     return rethrow { parse(text) };
 * }
 *
 * var outcome = attempt { load("missing.toml") };
 * match outcome {
 *     Result.Ok(port) => { print(port); }
 *     Result.Err(e) => { print("failed: " + str(e)); }
 * }
 * ```
 *
 * The value says which failure it was, so a handler matches on it rather than
 * reading a message. One row holds one instantiation, so a function throws one
 * error type; where two meet, `rethrow` wraps one in the other, and `Wraps`
 * writes the conversions it uses. `Failure` is the catch-all, for code that
 * does not need to tell failures apart.
 */

import { To } from "../ops/To";

/** A failure, abandoning the work that raised it. */
effect Throw<X> {
    /** Abandons the work and hands the handler what went wrong. Never resumed. */
    final ctl throw(err: X);
}

/** A value, or the failure in its place. */
type Result<T, X> {
    /** It worked, and this is what it gave. */
    Ok(T),

    /** It failed, and this is why. */
    Err(X)
}

/** The work's value, or the failure it threw, kept rather than handled. */
fn attempt<X, T, E>(f: () -> <Throw<X>, E> T): <E> Result<T, X> {
    var outcome: Option<Result<T, X>> = Option.None;
    run {
        outcome = Option.Some(Result.Ok(f()));
    } handle Throw {
        final ctl throw(e) { outcome = Option.Some(Result.Err(e)); }
    }
    match outcome {
        Option.Some(r) => { return r; }
        Option.None => { panic("attempt: neither a value nor a failure"); }
    }
}

/**
 * The work's value, with a failure converted to the error type the caller
 * throws. The conversion is `To`, which `Wraps` derives for each variant that
 * carries one error.
 */
fn rethrow<X: To<Y>, Y, T, E>(f: () -> <Throw<X>, E> T): <Throw<Y>, E> T {
    match attempt(f) {
        Result.Ok(value) => { return value; }
        Result.Err(e) => { return throw(e.to()); }
    }
}

/**
 * Derived for a sum of error types: every variant carrying exactly one value,
 * of a plain named type, gets a `To` from that type into the sum.
 */
trait Wraps { }

fn derive(shape: TypeShape) for Wraps {
    match shape {
        TypeShape.Sum(t, variants) => {
            for (v in variants) {
                if (v.arity == 1 && v.payload.len() == 1) {
                    var carried = v.payload[0];
                    var variant = v.name;
                    gen impl To<t> for carried {
                        fn to(self): t { return t.variant(self); }
                    }
                }
            }
        }
        _ => {}
    }
}

/** Any failure, for code that reports one rather than telling them apart. */
trait Failure {
    /** What went wrong, for a person to read. */
    fn message(self): string;
}

/** A message on its own is a failure. */
impl Failure for string {
    fn message(self): string { return self; }
}

/**
 * Throws any failure as a `Failure`. `throw` would keep its own type, and a
 * function throws one; this one's parameter is written, which is what makes
 * the value a `Failure`.
 */
fn fail<T>(err: Failure): <Throw<Failure>> T {
    return throw(err);
}
