/**
 * Keys with values, which is what a map literal builds.
 *
 * ```
 * var ages: Map<string, int> = {"ada": 36, "grace": 45};
 * ages.insert("alan", 41);
 * print(ages.get_or("ada", 0));    // 36
 * print(ages.get_or("nobody", 0)); // 0
 * ```
 *
 * A lookup is a scan, so this is the small-collection answer;
 * `std/collections/HashMap` is the one that hashes.
 */

/** Pairs of a key and its value. */
type Map<K, V> {
    /** In insertion order, with no two keys equal to each other. */
    entries: List<(K, V)>
}

impl Map<K, V> {
    /** How many keys the map holds. */
    fn len(self): int {
        return self.entries.len();
    }

    /** Whether the map holds this key. */
    fn contains(self, key: K): bool {
        var i = 0;
        while (i < self.entries.len()) {
            if (self.entries[i].0 == key) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /**
     * The value for the key, or the fallback if the map has no such key.
     *
     * A fallback rather than an `Option` because most callers have one, and
     * because a map holding an `Option` would then answer with two of them.
     */
    fn get_or(self, key: K, fallback: V): V {
        var i = 0;
        while (i < self.entries.len()) {
            if (self.entries[i].0 == key) {
                return self.entries[i].1;
            }
            i = i + 1;
        }
        return fallback;
    }

    /** Sets the key's value, replacing whatever it had. */
    fn insert(self, key: K, value: V) {
        var i = 0;
        while (i < self.entries.len()) {
            if (self.entries[i].0 == key) {
                self.entries[i] = (key, value);
                return;
            }
            i = i + 1;
        }
        self.entries.push((key, value));
    }
}

/** Each key and its value, in insertion order: `{"a": 1, "b": 2}`. */
impl Debug for Map<K, V> {
    fn debug(self): string {
        var out = "{";
        var i = 0;
        while (i < self.entries.len()) {
            if (i > 0) { out = out + ", "; }
            out = out + debug(self.entries[i].0) + ": " + debug(self.entries[i].1);
            i = i + 1;
        }
        return out + "}";
    }
}

/** As `Debug` writes it. */
impl Display for Map<K, V> {
    fn fmt(self): string { return debug(self); }
}

impl FromArray<(K, V)> for Map<K, V> {
    /** The map of the pairs, later keys replacing earlier ones. */
    fn from_array(pairs: Array<(K, V)>): Map<K, V> {
        var out = Map { entries: [] };
        var i = 0;
        while (i < pairs.len()) {
            out.insert(pairs[i].0, pairs[i].1);
            i = i + 1;
        }
        return out;
    }
}
