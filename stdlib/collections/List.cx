/**
 * The growable list, which is what a list literal builds.
 *
 * `[1, 2, 3]` is a `List<int>` when that is what the annotation asks for -- the
 * literal is an array, and the type it is given says what to build from it, so
 * a `Set` or a `Map` literal is written the same way.
 *
 * ```
 * var names: List<string> = [];
 * names.push("ada");
 * names.push("grace");
 * print(names[0]);        // ada
 * print(names.len());     // 2
 * print(names[1:]);       // grace
 * ```
 *
 * An index outside the list is an index past its backing array, so the array's
 * own bounds check rejects it; nothing here raises, because nothing in Cronyx
 * can.
 *
 * The operations that take a function are free functions rather than methods:
 * each carries the effect row of the function it is given, so `map` over an
 * effectful function is effectful and `map` over a pure one is pure.
 *
 * ```
 * import { map, filter, fold, join } from "std/collections/List";
 *
 * var ns: List<int> = [1, 2, 3, 4];
 * print(fold(filter(ns, fn (n) { return n % 2 == 0; }), 0, fn (a, n) { return a + n; }));
 * ```
 */

import { __past_end } from "../core/Array";
import { __span } from "../core/Range";

/** A run of values, as long as it needs to be. */
type List<T> {
    /** The backing array, which has room for at least `count`. */
    items: Array<T>,

    /** How many of the array's slots hold a value. */
    count: int
}

impl FromArray<T> for List<T> {
    /** The list holding what the array holds, which is what a literal does. */
    fn from_array(items: Array<T>): List<T> {
        return List { items: items, count: items.len() };
    }
}

impl Index<int> for List<T> {
    /** An integer index finds one value. */
    type Output = T;

    /** The value at the index. */
    fn get(self, at: int): T {
        if (at < 0 || at >= self.count) {
            return self.items[__past_end(self.items)];
        }
        return self.items[at];
    }
}

impl IndexSet<int> for List<T> {
    /** Puts the value at the index, and answers with it. */
    fn set(self, at: int, v: T): T {
        if (at < 0 || at >= self.count) {
            return self.items[__past_end(self.items)];
        }
        self.items[at] = v;
        return v;
    }
}

impl List<T> {
    /** How many values the list holds. */
    fn len(self): int {
        return self.count;
    }

    /**
     * Adds the value to the end, growing the list if it was full.
     *
     * Growing doubles the backing array, so pushing `n` values copies each of
     * them a constant number of times rather than once per push.
     */
    fn push(self, v: T) {
        if (self.count == self.items.len()) {
            var room = self.count * 2;
            if (room < 4) {
                room = 4;
            }
            self.items = __array_grow(self.items, room, v);
        }
        self.items[self.count] = v;
        self.count = self.count + 1;
    }

    /**
     * Removes the last value and answers with it.
     *
     * Popping an empty list is an index past the backing array, which the array
     * rejects.
     */
    fn pop(self): T {
        self.count = self.count - 1;
        var popped = self.items[self.count];
        __array_clear(self.items, self.count);
        return popped;
    }

    /** Whether any of the values is equal to this one. */
    fn contains(self, v: T): bool {
        var i = 0;
        while (i < self.count) {
            if (self.items[i] == v) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }
}

// Slicing is indexing by a range, so it is the same operator over a different
// index — and it copies, because a view would need to say how long it lives.
/** The values in order, each as `debug` writes it: `[1, 2, 3]`. */
impl Debug for List<T> {
    fn debug(self): string {
        var parts: List<string> = ["["];
        var i = 0;
        while (i < self.count) {
            if (i > 0) { parts.push(", "); }
            parts.push(debug(self.items[i]));
            i = i + 1;
        }
        parts.push("]");
        return __str_join(parts.items, parts.count);
    }
}

/** As `Debug` writes it, so a list of strings shows each one quoted. */
impl Display for List<T> {
    fn fmt(self): string { return debug(self); }
}

impl Index<Range> for List<T> {
    /** A range finds a list of them, copied. */
    type Output = List<T>;

    /** A new list holding the values the range covers. */
    fn get(self, r: Range): List<T> {
        var bounds = __span(r, self.len());
        var out: List<T> = [];
        var at = bounds.0;
        while (at < bounds.1) {
            out.push(self[at]);
            at = at + 1;
        }
        return out;
    }
}

/** A new list of what the function answers for each value, in order. */
fn map<T, U, E>(items: List<T>, f: (T) -> <E> U): <E> List<U> {
    var out: List<U> = [];
    for (item in items) { out.push(f(item)); }
    return out;
}

/** A new list of the values the function accepts, in order. */
fn filter<T, E>(items: List<T>, f: (T) -> <E> bool): <E> List<T> {
    var out: List<T> = [];
    for (item in items) {
        if (f(item)) { out.push(item); }
    }
    return out;
}

/**
 * The result of folding the function over the list, left to right.
 *
 * `start` is what it is given for the first value, and each answer is what it is
 * given for the next.
 */
fn fold<T, A, E>(items: List<T>, start: A, f: (A, T) -> <E> A): <E> A {
    var acc = start;
    for (item in items) { acc = f(acc, item); }
    return acc;
}

/** Whether the function accepts at least one value. False for an empty list. */
fn any<T, E>(items: List<T>, f: (T) -> <E> bool): <E> bool {
    for (item in items) {
        if (f(item)) { return true; }
    }
    return false;
}

/** Whether the function accepts every value. True for an empty list. */
fn all<T, E>(items: List<T>, f: (T) -> <E> bool): <E> bool {
    for (item in items) {
        if (f(item)) {} else { return false; }
    }
    return true;
}

/** The first value the function accepts, or `None` if it accepts none. */
fn find<T>(items: List<T>, f: (T) -> bool): Option<T> {
    for (item in items) {
        if (f(item)) { return Option.Some(item); }
    }
    return Option.None;
}

/** A new list of the first's values followed by the second's. */
fn concat<T>(a: List<T>, b: List<T>): List<T> {
    var out: List<T> = [];
    for (item in a) { out.push(item); }
    for (item in b) { out.push(item); }
    return out;
}

/** A new list with the values in the opposite order. */
fn reverse<T>(items: List<T>): List<T> {
    var out: List<T> = [];
    var at = items.len() - 1;
    while (at >= 0) {
        out.push(items[at]);
        at = at - 1;
    }
    return out;
}

/** As `map`, with each answer being a list whose values are run together. */
fn flat_map<T, U>(items: List<T>, f: (T) -> List<U>): List<U> {
    var out: List<U> = [];
    for (item in items) {
        for (inner in f(item)) { out.push(inner); }
    }
    return out;
}

/** The strings run together with the separator between each pair. */
fn join(items: List<string>, separator: string): string {
    if (items.len() == 0) { return ""; }
    var parts: List<string> = [items[0]];
    var at = 1;
    while (at < items.len()) {
        parts.push(separator);
        parts.push(items[at]);
        at = at + 1;
    }
    return __str_join(parts.items, parts.count);
}
