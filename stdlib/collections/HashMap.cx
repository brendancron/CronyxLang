import { Hash } from "../ops/Hash";

// Open addressing with linear probing, over the same slot scheme as HashSet:
// a slot holds an index into the parallel `keys` and `vals`, or `empty` for
// one never used and `deleted` for one vacated.
fn empty(): int { return 0 - 1; }
fn deleted(): int { return 0 - 2; }

type HashMap<K, V> {
    slots: List<int>,
    keys: List<K>,
    vals: List<V>,
    size: int,
    capacity: int
}

fn filled(capacity: int): List<int> {
    var slots: List<int> = [];
    var at = 0;
    while (at < capacity) {
        slots.push(empty());
        at = at + 1;
    }
    return slots;
}

fn new<K, V>(): HashMap<K, V> {
    var keys: List<K> = [];
    var vals: List<V> = [];
    return new HashMap {
        slots: filled(16), keys: keys, vals: vals, size: 0, capacity: 16
    };
}

fn start_at<K: Hash>(key: K, capacity: int): int {
    var h = key.hash() % capacity;
    if (h < 0) { return 0 - h; }
    return h;
}

// The index into `keys` for this key, or `empty` when it is absent.
fn find<K: Hash, V>(map: HashMap<K, V>, key: K): int {
    var at = start_at(key, map.capacity);
    var probes = 0;
    while (probes < map.capacity) {
        var slot = map.slots[at];
        if (slot == empty()) { return empty(); }
        if (slot != deleted() && map.keys[slot] == key) { return slot; }
        at = (at + 1) % map.capacity;
        probes = probes + 1;
    }
    return empty();
}

fn probe_insert<K: Hash, V>(
    slots: List<int>,
    keys: List<K>,
    vals: List<V>,
    capacity: int,
    key: K,
    value: V
): bool {
    var at = start_at(key, capacity);
    var probes = 0;
    var vacated = empty();
    while (probes < capacity) {
        var slot = slots[at];
        if (slot == empty()) {
            var insert_at = at;
            if (vacated != empty()) { insert_at = vacated; }
            slots[insert_at] = keys.len();
            keys.push(key);
            vals.push(value);
            return true;
        }
        if (slot == deleted()) {
            if (vacated == empty()) { vacated = at; }
        } else {
            if (keys[slot] == key) {
                vals[slot] = value;
                return false;
            }
        }
        at = (at + 1) % capacity;
        probes = probes + 1;
    }
    if (vacated != empty()) {
        slots[vacated] = keys.len();
        keys.push(key);
        vals.push(value);
        return true;
    }
    return false;
}

impl HashMap<K, V> {
    fn size(self): int { return self.size; }

    fn contains(self, key: K): bool { return find(self, key) != empty(); }

    fn get(self, key: K): Option<V> {
        var slot = find(self, key);
        if (slot == empty()) { return Option::None; }
        return Option::Some(self.vals[slot]);
    }

    fn get_or(self, key: K, fallback: V): V {
        var slot = find(self, key);
        if (slot == empty()) { return fallback; }
        return self.vals[slot];
    }

    fn set(self, key: K, value: V) {
        if (self.size * 2 >= self.capacity) { self.grow(); }
        if (probe_insert(self.slots, self.keys, self.vals, self.capacity, key, value)) {
            self.size = self.size + 1;
        }
    }

    fn remove(self, key: K): bool {
        var at = start_at(key, self.capacity);
        var probes = 0;
        while (probes < self.capacity) {
            var slot = self.slots[at];
            if (slot == empty()) { return false; }
            if (slot != deleted() && self.keys[slot] == key) {
                self.slots[at] = deleted();
                self.size = self.size - 1;
                return true;
            }
            at = (at + 1) % self.capacity;
            probes = probes + 1;
        }
        return false;
    }

    // Walks the slots rather than `keys`, which still holds what `remove`
    // tombstoned.
    fn keys(self): List<K> {
        var out: List<K> = [];
        var at = 0;
        while (at < self.capacity) {
            var slot = self.slots[at];
            if (slot >= 0) { out.push(self.keys[slot]); }
            at = at + 1;
        }
        return out;
    }

    fn grow(self) {
        var was = self.capacity;
        self.capacity = was * 2;
        var slots = filled(self.capacity);
        var keys: List<K> = [];
        var vals: List<V> = [];
        var at = 0;
        while (at < was) {
            var slot = self.slots[at];
            if (slot >= 0) {
                probe_insert(slots, keys, vals, self.capacity, self.keys[slot], self.vals[slot]);
            }
            at = at + 1;
        }
        self.slots = slots;
        self.keys = keys;
        self.vals = vals;
    }
}
