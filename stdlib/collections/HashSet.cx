import { Hash } from "../ops/Hash";

// Open addressing with linear probing. A slot holds an index into `keys`, or
// `empty` for one never used and `deleted` for one vacated. A probe stops at
// the first but has to walk past the second, or it would miss a key inserted
// beyond one that has since been removed.
fn empty(): int { return 0 - 1; }
fn deleted(): int { return 0 - 2; }

type HashSet<K> {
    slots: List<int>,
    keys: List<K>,
    size: int,
    capacity: int
}

fn filled(capacity: int): List<int> {
    var slots: List<int> = [];
    var at = 0;
    while (at < capacity) {
        slots.push(empty());
        at = at + 1;
    }
    return slots;
}

fn new<K>(): HashSet<K> {
    var keys: List<K> = [];
    return HashSet { slots: filled(16), keys: keys, size: 0, capacity: 16 };
}

fn start_at<K: Hash>(key: K, capacity: int): int {
    var h = key.hash() % capacity;
    if (h < 0) { return 0 - h; }
    return h;
}

fn probe_add<K: Hash>(slots: List<int>, keys: List<K>, capacity: int, key: K): bool {
    var at = start_at(key, capacity);
    var probes = 0;
    var vacated = empty();
    while (probes < capacity) {
        var slot = slots[at];
        if (slot == empty()) {
            var insert_at = at;
            if (vacated != empty()) { insert_at = vacated; }
            slots[insert_at] = keys.len();
            keys.push(key);
            return true;
        }
        if (slot == deleted()) {
            if (vacated == empty()) { vacated = at; }
        } else {
            if (keys[slot] == key) { return false; }
        }
        at = (at + 1) % capacity;
        probes = probes + 1;
    }
    if (vacated != empty()) {
        slots[vacated] = keys.len();
        keys.push(key);
        return true;
    }
    return false;
}

impl HashSet<K> {
    fn contains(self, key: K): bool {
        var at = start_at(key, self.capacity);
        var probes = 0;
        while (probes < self.capacity) {
            var slot = self.slots[at];
            if (slot == empty()) { return false; }
            if (slot != deleted() && self.keys[slot] == key) { return true; }
            at = (at + 1) % self.capacity;
            probes = probes + 1;
        }
        return false;
    }

    fn add(self, key: K) {
        if (self.size * 2 >= self.capacity) { self.grow(); }
        if (probe_add(self.slots, self.keys, self.capacity, key)) {
            self.size = self.size + 1;
        }
    }

    fn remove(self, key: K): bool {
        var at = start_at(key, self.capacity);
        var probes = 0;
        while (probes < self.capacity) {
            var slot = self.slots[at];
            if (slot == empty()) { return false; }
            if (slot != deleted() && self.keys[slot] == key) {
                self.slots[at] = deleted();
                self.size = self.size - 1;
                return true;
            }
            at = (at + 1) % self.capacity;
            probes = probes + 1;
        }
        return false;
    }

    fn size(self): int { return self.size; }

    // Walks the slots rather than `keys`, which still holds what `remove`
    // tombstoned.
    fn items(self): List<K> {
        var out: List<K> = [];
        var at = 0;
        while (at < self.capacity) {
            var slot = self.slots[at];
            if (slot >= 0) { out.push(self.keys[slot]); }
            at = at + 1;
        }
        return out;
    }

    fn grow(self) {
        var was = self.capacity;
        self.capacity = was * 2;
        var slots = filled(self.capacity);
        var keys: List<K> = [];
        var at = 0;
        while (at < was) {
            var slot = self.slots[at];
            if (slot >= 0) {
                probe_add(slots, keys, self.capacity, self.keys[slot]);
            }
            at = at + 1;
        }
        self.slots = slots;
        self.keys = keys;
    }
}
