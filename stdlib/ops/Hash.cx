/**
 * Hashing, for the collections that need it.
 *
 * `std/collections/HashMap` and `std/collections/HashSet` are bounded by this,
 * so a key type joins in by implementing it. The impls here cover `int`, `bool`
 * and `string`.
 *
 * Two equal values must hash equally, or a map will hold both.
 */

/** A value with a hash. */
trait Hash {
    /** Any integer, so long as equal values agree on it. */
    fn hash(self): int;
}

impl Hash for int {
    fn hash(self): int { return self; }
}

impl Hash for bool {
    fn hash(self): int {
        if (self) { return 1; }
        return 0;
    }
}

impl Hash for string {
    fn hash(self): int {
        var h = 5381;
        var at = 0;
        while (at < self.len()) {
            h = (h * 31 + ord(self[at])) % 1000000007;
            at = at + 1;
        }
        return h;
    }
}
