/**
 * Cronyx syntax as data: what `code(…)` hands back, what a deriver builds,
 * and what `gen` emits.
 *
 * ```
 * import { Expr, ExprKind, FieldInit } from "std/compiler/Ast";
 *
 * fn derive(shape: TypeShape) for Decode {
 *     match shape {
 *         TypeShape.Product(t, _, fields) => {
 *             var entries: List<FieldInit> = [];
 *             for (f in fields) {
 *                 var key = str(f.name);
 *                 entries.push(FieldInit { name: f.name, value: code(d.field(key)) });
 *             }
 *             var body = Expr.of(ExprKind.New(t, entries));
 *             gen impl Decode for t {
 *                 fn decode(d: Decoder): t { return body; }
 *             }
 *         }
 *         _ => {}
 *     }
 * }
 * ```
 *
 * The tree is the syntax as written, every form of it, and changes only when
 * the language's syntax does. A quote's nodes carry the span they were written
 * at; a node made with `of` is marked as generated, and takes the location of
 * the `gen` that emits it.
 */

import { AttrArg } from "../meta/Reflect";

/** An expression. */
type Expr {
    kind: ExprKind,
    span: Span,
    /** Its type, in code `processed` handed back; `None` in a quote. */
    ty: Option<TypeExpr>
}

impl Expr {
    /** The expression, marked as generated. */
    fn of(kind: ExprKind): Expr { return Expr { kind: kind, span: __span_generated(), ty: Option.None }; }
}

/** A statement. A declaration inside a block is one too, as `Declare`. */
type Stmt {
    kind: StmtKind,
    span: Span
}

impl Stmt {
    /** The statement, marked as generated. */
    fn of(kind: StmtKind): Stmt { return Stmt { kind: kind, span: __span_generated() }; }
}

/** A declaration, with the attributes written above it. */
type Decl {
    kind: DeclKind,
    attrs: List<Attribute>,
    span: Span
}

impl Decl {
    /** The declaration, with no attributes, marked as generated. */
    fn of(kind: DeclKind): Decl { return Decl { kind: kind, attrs: [], span: __span_generated() }; }
}

/** A type as written. */
type TypeExpr {
    kind: TypeKind,
    span: Span
}

impl TypeExpr {
    /** The type, marked as generated. */
    fn of(kind: TypeKind): TypeExpr { return TypeExpr { kind: kind, span: __span_generated() }; }
}

type UnOp { Neg, Not, BitNot }

type BinOp {
    Add, Sub, Mul, Div, Mod,
    BitAnd, BitOr, BitXor, Shl, Shr,
    Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual
}

type ExprKind {
    Unit,
    Int(int),
    Float(float),
    Str(string),
    Char(char),
    Bool(bool),
    /** A name reflection handed out, standing as a value. */
    NameLit(Name),
    /** What `embed` read, as it was on disk. */
    Bytes(Array<byte>),

    Var(Name),
    Assign(Name, Expr),
    Unary(UnOp, Expr),
    Binary(BinOp, Expr, Expr),
    And(Expr, Expr),
    Or(Expr, Expr),
    Call(Expr, List<Expr>),
    MethodCall(Expr, Name, List<Expr>),
    /** `f<int, 3>(x)`. */
    StaticCall(Expr, List<StaticArg>, List<Expr>),
    /** `f<int>`, named as a value. */
    StaticRef(Expr, List<StaticArg>),

    /** `x += e`. */
    Compound(BinOp, Name, Expr),
    CompoundIndex(BinOp, Expr, Expr, Expr),
    CompoundField(BinOp, Expr, Name, Expr),

    Index(Expr, Expr),
    IndexAssign(Expr, Expr, Expr),
    Tuple(List<Expr>),
    TupleGet(Expr, int),
    /** `...args`, in an argument list. */
    Spread(Expr),

    /** `{ a: 1 }`, a record of no declared type. */
    Record(List<FieldInit>),
    Field(Expr, Name),
    FieldAssign(Expr, Name, Expr),
    /** `Point { x: 1, y: 2 }`. */
    New(Name, List<FieldInit>),
    /** `Box<int>(x)`. */
    NewCall(Name, List<TypeExpr>, List<Expr>),
    /** `new Box<int> { … }`. */
    NewGeneric(Name, List<StaticArg>, List<FieldInit>),
    /** `Option.Some(x)`. */
    NewVariant(Name, Name, Args),
    /** `[a, b]`. */
    Collection(List<Expr>),

    Lambda(List<Param>, Signature, List<Stmt>),
    /** The type is the `<R>` written after `run`. */
    Run(Option<TypeExpr>, ValuedBlock, List<HandlerClause>),
    Match(Expr, List<ValuedArm>),

    Typeof(Expr),
    /** `declof(f)`, or `declof(f<int>)` with the key written. */
    Declof(Expr, Option<List<StaticArg>>),
    /** `meta { … }` standing where a value is wanted. */
    Meta(List<Stmt>),
    QuoteExpr(Expr),
    QuoteStmts(List<Stmt>),
    QuoteDecl(Decl)
}

/** `name: value`, in a record or a constructor. */
type FieldInit {
    name: Name,
    value: Expr
}

/** A variant's payload, as a constructor is given it. */
type Args {
    None,
    Positional(List<Expr>),
    Named(List<FieldInit>)
}

/** One of `<…>`: a bare name parses as a type, whichever it names. */
type StaticArg {
    Type(TypeExpr),
    Value(Expr)
}

/** Statements, and the value they finish with if the braces hold one expression. */
type ValuedBlock {
    stmts: List<Stmt>,
    value: Option<Expr>
}

/** An arm of a `match` used as a value. */
type ValuedArm {
    pattern: Pattern,
    body: ValuedBlock
}

/** An arm of a `match` statement. */
type MatchArm {
    pattern: Pattern,
    body: List<Stmt>
}

type Pattern {
    /** `Option.Some(x)`: the type, the variant, and what it binds. */
    Variant(Name, Name, Bindings),
    Wild
}

/** What a variant pattern binds. */
type Bindings {
    None,
    Positional(List<Name>),
    Named(List<NamedBinding>)
}

/** `field: name` in a pattern. */
type NamedBinding {
    field: Name,
    bound: Name
}

type StmtKind {
    Expression(Expr),
    Let(Name, Option<TypeExpr>, Option<Expr>),
    /** `var (a, b) = pair;`. */
    LetTuple(List<Name>, Expr),
    Block(List<Stmt>),
    If(Expr, Stmt, Option<Stmt>),
    While(Expr, Stmt),
    For(Option<Stmt>, Option<Expr>, Option<Expr>, Stmt),
    ForIn(List<Name>, Expr, Stmt),
    Return(Option<Expr>),
    Break,
    Continue,
    Defer(Stmt),
    Match(Expr, List<MatchArm>),
    Meta(List<Stmt>),
    Gen(Stmt),
    /** `derive Eq, Debug for Point;`. */
    Derive(List<Name>, Name),
    Declare(Decl)
}

type DeclKind {
    Fn(FnDecl),
    Type(TypeDecl),
    /** A type with members after its fields: the declaration, then its functions and meta blocks. */
    TypeWithMembers(TypeDecl, List<Stmt>),
    Trait(TraitDecl),
    /** A trait with meta blocks among its members: the declaration, then the blocks. */
    TraitWithMembers(TraitDecl, List<Stmt>),
    Impl(ImplDecl),
    Import(Import),
    GlobalImport(Import)
}

type FnDecl {
    name: Name,
    params: List<Param>,
    signature: Signature,
    body: List<Stmt>
}

type TypeDecl {
    name: Name,
    params: List<TypeParam>,
    body: TypeBody
}

type TypeBody {
    Fields(List<FieldDecl>),
    Variants(List<VariantDecl>)
}

type FieldDecl {
    name: Name,
    ty: TypeExpr,
    attrs: List<Attribute>
}

type VariantDecl {
    name: Name,
    /** The variant's own type parameters. */
    params: List<Name>,
    payload: Payload,
    /** What makes the type a GADT: the type this variant builds. */
    result: Option<TypeExpr>,
    attrs: List<Attribute>
}

/** What a variant carries, as declared. */
type Payload {
    None,
    Positional(List<TypeExpr>),
    Named(List<FieldType>)
}

type TraitDecl {
    name: Name,
    params: List<Name>,
    /** Bounds on `Self`. */
    supers: List<Applied>,
    assoc: List<AssocDecl>,
    methods: List<MethodSig>
}

type ImplDecl {
    /** `None` for an impl of the type's own methods. */
    implements: Option<Applied>,
    target: Name,
    params: List<TypeParam>,
    assoc: List<AssocDef>,
    methods: List<MethodDef>
}

type MethodSig {
    name: Name,
    params: List<Param>,
    signature: Signature,
    attrs: List<Attribute>
}

type MethodDef {
    name: Name,
    params: List<Param>,
    signature: Signature,
    body: List<Stmt>,
    attrs: List<Attribute>
}

/** `type Item;` in a trait. */
type AssocDecl {
    name: Name,
    attrs: List<Attribute>
}

/** `type Item = int;` in an impl. */
type AssocDef {
    name: Name,
    ty: TypeExpr,
    attrs: List<Attribute>
}

type HandlerClause {
    /** `with H`: a type implementing the effects it binds. */
    Named(Name),
    /** `handle<E> { fn op(…) { … } }`. */
    Handle(TypeExpr, List<MethodDef>),
    /**
     * What a transform makes of a run: the effect, the handler bound to it,
     * and the declaration of the handler's value, which stands outside the run.
     */
    Bound(Name, Name, Option<Stmt>)
}


type Import {
    /** `import "geom";`. */
    Qualified(string),
    /** `import "geom" as g;`. */
    Aliased(string, Name),
    /** `import { Point, origin } from "geom";`. */
    Selective(List<Name>, string),
    /** `import "geom/…";` with a star: everything the module declares. */
    Wildcard(string)
}

type Param {
    name: Name,
    ty: Option<TypeExpr>,
    /** A trailing lambda's parameter nobody wrote: `it`. */
    implicit: bool
}

type StaticParam {
    name: Name,
    ty: Option<TypeExpr>,
    /** Collects the rest of the written arguments. */
    pack: bool
}

type TypeParam {
    name: Name,
    pack: bool,
    /** `n: int`: a value the type is instantiated at. */
    ty: Option<TypeExpr>
}

/** What follows a function's parameters. */
type Signature {
    ret: Option<TypeExpr>,
    /** `None` leaves the effects to inference; `Some` closes them. */
    row: Option<List<Applied>>,
    static_params: List<StaticParam>
}

/** A name with arguments: a trait in an impl, an effect in a row. */
type Applied {
    name: Name,
    args: List<TypeExpr>
}

/** `@name(args)` above a declaration or a member. */
type Attribute {
    name: Name,
    args: List<AttrArg>,
    span: Span
}

type TypeKind {
    Named(Name),
    Applied(Name, List<TypeExpr>),
    Tuple(List<TypeExpr>),
    Record(List<FieldType>),
    /** Parameters, result and effects. */
    Function(List<TypeExpr>, TypeExpr, List<Applied>),
    /** A parameter the call site fills from the rest of its arguments. */
    Variadic(TypeExpr),
    /** `...Args`. */
    Spread(TypeExpr),
    /** `T.Item`. */
    Assoc(TypeExpr, Name),
    /** `Output = T`, in a bound. */
    Bind(Name, TypeExpr),
    /** `<async, E>` where a type's parameter stands in a row. */
    Row(List<Applied>)
}

/** `name: T` in a record type or a variant's named payload. */
type FieldType {
    name: Name,
    ty: TypeExpr
}

/** An operation of an effect, as a call to it names it. */
type Operation {
    /** The trait. */
    label: Name,
    /** The method, as a handler writes it. */
    name: Name,
    /** Marked `@ctl`: it is handed the rest of its caller. */
    takes_control: bool,
    /** How many arguments a call to it writes: a call handed its continuation has more. */
    arity: int
}

/** The operation `callee` names, if it names one. */
fn operation_of(callee: Expr): Option<Operation> {
    match callee.kind {
        ExprKind.Var(n) => { return __operation(n); }
        _ => { return Option.None; }
    }
}

/** A row label standing for whatever else a function type it is written in performs. */
fn open_row(): Name { return __open_row(); }

/** The arguments of the effect `label` the handler `bound` binds in a bound run, or none where they are not settled. */
fn bound_arguments(bound: Name, label: Name): List<TypeExpr> { return __bound_arguments(bound, label); }

/** The type processed code shows where the checker had not settled one, inside a function's type. */
fn open_type(): Name { return __open_type(); }

/** The static parameter a transform marks the functions it makes for itself with. */
fn plain_marker(): Name { return __plain_marker(); }

/** The static parameter marking a function made taking its handlers and continuation after its own parameters. */
fn cps_marker(): Name { return __cps_marker(); }

/** The parameter a function that takes control is handed the handler of `label` in. */
fn handler_param(label: Name): Name { return __handler_param(label); }

/** The operation `method` of the effect `label`, as a handler of it names the method. */
fn operation_in(label: Name, method: Name): Option<Operation> { return __operation_in(label, method); }

/** Every operation of the effect `label`, in the order it declares them. */
fn operations(label: Name): List<Operation> { return __operations(label); }

/** The effects the method `method` of the trait `t` writes in its row; none when `t` is no trait. */
fn method_row(t: Name, method: Name): Array<Name> { return __method_row(t, method); }

/** Whether the effect `label` has an operation that takes control. */
fn controls(label: Name): bool { return __controls(label); }

/** Whether `callee` names a function the program declares, rather than a value. */
fn names_function(callee: Expr): bool {
    match callee.kind {
        ExprKind.Var(n) => { return __names_function(n); }
        _ => { return false; }
    }
}

/**
 * The block as the checker reads it where the meta block asking stands, each
 * expression with its `ty`: what code generated there would be. Nothing it
 * calls is part of the program unless the code generated from it calls it
 * too. A block at the top level has no such place, and may not ask.
 */
fn processed(body: ValuedBlock): ValuedBlock { return __processed(body); }

/** What the block `processed` last handed back performs, each effect at the arguments it settled. */
fn processed_row(): List<Applied> { return __processed_row(); }

/** What the methods that take control of the run being transformed perform, each effect at the arguments it settled. */
fn arms_row(): List<Applied> { return __arms_row(); }

/** A function's declaration, its body typed as `processed` types a block. */
fn processed_fn(d: Decl): Decl { return __processed_fn(d); }

/** A name no program can write and no other `fresh` hands out, shown as `prefix`. */
fn fresh(prefix: string): Name { return __fresh_name(prefix); }

/** The function a callee of processed code reaches: the instance its type settles. */
fn declof_call(callee: Expr): Decl {
    match callee.kind {
        ExprKind.Var(n) => { return __declof_call(n, callee.ty, callee.span); }
        _ => { return compile_error(callee.span, "Only a named function has a declaration."); }
    }
}

/** A name for the instance a callee of processed code reaches, the same for every callee reaching it. */
fn instance_of(callee: Expr): Name {
    match callee.kind {
        ExprKind.Var(n) => { return __instance_of(n, callee.ty, callee.span); }
        _ => { return compile_error(callee.span, "Only a named function has an instance."); }
    }
}

/** What a meta block of this program remembered under `key`, in this block or an earlier one. */
fn remembered(key: List<Name>): Option<Name> { return __remembered(key); }

/** Keeps `value` under `key` for the rest of the program's meta blocks. */
fn remember(key: List<Name>, value: Name) { __remember(key, value); }

/** Declares `d` at the program's top level, as a `gen` there would. */
fn declare(d: Decl) { __declare(d); }
