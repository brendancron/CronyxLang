import { async, block_on, all } from "std/async/Task";
import { promise, resolve, await, Promise } from "std/async/Promise";

var ready: Promise<int> = promise();

block_on {
    all([
        () => {
            all([ () => { print("inner got " + str(await(ready))); } ]);
            print("inner scope done");
        },
        () => {
            print("outer resolving");
            resolve(ready, 7);
        }
    ]);
    print("all done");
};
