import { Async, block_on, scope, all, race, both, interleaved, pause } from "std/async/Task";
import { Throw, attempt, Result } from "std/core/Error";

fn count(name: String, upto: Int): <Async, Console> Int {
    for (var i = 0; i < upto; i += 1) {
        print(name + " " + str(i));
        pause();
    }
    return name.len();
}

block_on {
    var sizes = all([() => count("a", 2), () => count("bb", 1)]);
    print(str(sizes[0]) + " " + str(sizes[1]));

    var started = scope((start) => {
        var n = 0;
        for (i in [1, 2, 3]) {
            start(() => {
                pause();
                print("task " + str(i));
                if (i == 3) {
                    start(() => { pause(); print("started by task 3"); });
                }
            });
            n += 1;
        }
        print("body done starting");
        return n;
    });
    print("scope returned " + str(started));

    var failed = attempt(() => {
        scope((start) => {
            defer { print("body cleans up"); }
            start(() => { pause(); throw("task failed"); });
            start(() => {
                defer { print("sibling cleans up"); }
                pause();
                pause();
                pause();
                print("sibling finished");
            });
            while (true) { pause(); }
        });
    });
    match failed {
        Result.Ok(_) => { print("scope finished"); }
        Result.Err(e) => { print("scope failed: " + e); }
    }

    var first = race([
        () => { count("slow", 3); return "slow"; },
        () => { pause(); return "quick"; }
    ]);
    print("winner: " + first);

    var (n, s) = both(() => { pause(); return 1; }, () => { return "two"; });
    print(str(n) + " " + s);

    interleaved([
        () => { print("x"); pause(); print("x again"); },
        () => { print("y"); }
    ]);
};
