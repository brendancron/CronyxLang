import { async, block_on, all } from "std/async/Task";

var retry: List<(int) -> unit> = [];

block_on {
    all([
        () => {
            var attempt: int = suspend { retry.push(it); };
            print("attempt " + str(attempt));
        },
        () => {
            retry[0](1);
            retry[0](2);
        }
    ]);
};
