import { Env } from "std/os/Env";

print(env_var("CRONYX_FIXTURE_UNSET"));
set_env_var("CRONYX_FIXTURE", "first");
print(env_var("CRONYX_FIXTURE"));
set_env_var("CRONYX_FIXTURE", "second");
print(env_var("CRONYX_FIXTURE"));

var seen = false;
for ((name, value) in env_vars()) {
    if (name == "CRONYX_FIXTURE") { seen = value == "second"; }
}
print(seen);

remove_env_var("CRONYX_FIXTURE");
print(env_var("CRONYX_FIXTURE"));

fn home(): <Env> string {
    match env_var("HOME") {
        Option.Some(dir) => { return dir; }
        Option.None => { return "(none)"; }
    }
    return "";
}

run {
    print(home());
} handle Env {
    fn env_var(name) { return Option.Some("/home/" + name.to_lower()); }
    fn set_env_var(name, value) { }
    fn remove_env_var(name) { }
    fn env_vars() { return []; }
}
