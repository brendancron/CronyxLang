import { Exit } from "std/os/Process";
import { all } from "std/async/Task";
import { write_text, read_text, remove_path } from "std/fs/File";

all([
    () => { write_text("exit_with_async_file_a.txt", "a"); },
    () => { write_text("exit_with_async_file_b.txt", "b"); }
]);
print(read_text("exit_with_async_file_a.txt") + read_text("exit_with_async_file_b.txt"));
remove_path("exit_with_async_file_a.txt");
remove_path("exit_with_async_file_b.txt");
exit(6);
