import { sort, sort_by, sort_by_key, sort_unstable, sort_unstable_by, sort_array, sort_array_unstable } from "std/algo/Sort";
var xs: List<int> = [5, 3, 9, 1, 3, 7, 2];
sort(xs);
print(xs);
var ys: List<int> = [5, 3, 9, 1, 3, 7, 2];
sort_unstable(ys);
print(ys);
var people: List<(string, int)> = [("ada", 36), ("bo", 4), ("cy", 36), ("di", 4), ("ed", 20)];
sort_by_key(people, (p) => { return p.1; });
print(people);
var desc: List<int> = [1, 2, 3];
sort_by(desc, (a, b) => { if (a > b) { return Ordering.Less; } if (a < b) { return Ordering.Greater; } return Ordering.Equal; });
print(desc);
var arr = Array<int>(4, 0);
arr[0] = 4; arr[1] = 2; arr[2] = 3; arr[3] = 1;
sort_array(arr);
print(arr);
var words: List<string> = ["pear", "fig", "apple"];
sort(words);
print(words);
var empty: List<int> = [];
sort(empty);
print(empty);
