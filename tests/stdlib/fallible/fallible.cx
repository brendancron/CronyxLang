import { Fallible } from "std/core/Error";

fn parse_int(s) {
    if (s == "42") {
        return 42;
    }
    return raise("not a number: " + s);
}

run<Unit> {
    var n = parse_int("42");
    print(n);
} handle<Fallible<Int>> {
    fn raise(msg) {
        print("fallible: " + msg);
        return -1;
    }
}

run<Unit> {
    var n = parse_int("abc");
    print(n);
} handle<Fallible<Int>> {
    fn raise(msg) {
        print("fallible: " + msg);
        return -1;
    }
}
