import { Rational } from "std/math/Rational";
import { Pow, Signed, Ord } from "std/math/Num";
import { sum, clamp, abs } from "std/math/Math";
import { BigInt } from "std/math/BigInt";

var third = Rational.of(1, 3);
print(third + Rational.of(1, 6));
print(third - Rational.of(1, 2));
print(third * Rational.of(3, 4));
print(third / Rational.of(2, 9));
print(-third);
print(Rational.of(6, -4));
print(Rational.of(0, -5));
print(Rational.of(10, 5));
print(Rational.of(2, 4) == Rational.of(1, 2));
print(Rational.of(2, 4) == Rational.of(1, 3));
print(Rational.of(1, 3) < Rational.of(1, 2));
print(Rational.of(-1, 3) > Rational.of(-1, 2));
print(Rational.of(1, 3).cmp(Rational.of(2, 6)));
print(Rational.of(-3, 4).abs());
print(Rational.of(-3, 4).sign());
print(Rational.of(2, 3).pow(3));
print(Rational.of(2, 3).pow(-2));
print(Rational.of(2, 3).pow(0));
print(sum([Rational.of(1, 2), Rational.of(1, 3), Rational.of(1, 6)]));
print(clamp(Rational.of(7, 2), Rational.of(0, 1), Rational.of(3, 1)));
print(abs(Rational.of(-1, 7)));

var harmonic = Rational.of(0, 1);
for (var i = 1; i <= 20; i += 1) { harmonic = harmonic + Rational.of(1, i); }
print(harmonic);
print(harmonic.to_float());

print(Rational.from_float(0.1));
print(Rational.from_float(-2.5));
print(Rational.from_float(0.0));
print(Rational.from_float(1.0 / 0.0));
print(Rational.from_float(0.0 / 0.0));
match Rational.from_float(0.1) {
    Option.Some(r) => { print(r.to_float() == 0.1); }
    Option.None => {}
}
print(Rational.of_big(BigInt.of(10).pow(30), BigInt.of(10).pow(28)));
print(third.numerator);
print(third.denominator);
