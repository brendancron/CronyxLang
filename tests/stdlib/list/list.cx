import { map, filter, fold, any, all, find, concat, reverse, flat_map, join }
    from "std/collections/List";

var nums = [1, 2, 3, 4, 5];

var doubled = nums.map() { it * 2 };
print(doubled[0]);
print(doubled[4]);

var sum = nums.fold(0, (acc, x) => acc + x);
print(sum);

print(nums.any() { it > 4 });
print(nums.all() { it > 0 });

var rev = nums.reverse();
print(rev[0]);
print(rev[4]);

var words = ["hello", "world"];
print(words.join(", "));

var big = nums.filter() { it > 3 };
print(big[0]);
print(big[1]);

var found = nums.find() { it > 3 };
match found {
    Option.Some(v) => { print(v); }
    Option.None    => { print("none"); }
}

var a = [1, 2];
var b = [3, 4];
var c = a.concat(b);
print(c[0]);
print(c[3]);

var flat = [[1, 2], [3, 4]].flat_map((xs) => xs);
print(flat[0]);
print(flat[3]);
