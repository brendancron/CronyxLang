import { To } from "std/ops/To";

print(0.to());
print(42.to());
print((0 - 7).to());
print(true.to());
print(false.to());
print("hello".to());

type Point { x: int, y: int }

impl To<string> for Point {
    fn to(self): string {
        return "(" + self.x.to() + ", " + self.y.to() + ")";
    }
}

var p = Point { x: 3, y: 4 };
print(p.to());

fn render<T: To<string>>(value: T): string { return value.to(); }

print(render(p));
print(render(19));
