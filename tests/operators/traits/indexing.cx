type Ring { items: Array<int>, head: int }

impl Index<int> for Ring {
    type Output = int;

    fn get(self, at: int): int {
        return self.items[(self.head + at) % self.items.len()];
    }
}

impl IndexSet<int> for Ring {
    fn set(self, at: int, v: int): int {
        self.items[(self.head + at) % self.items.len()] = v;
        return v;
    }
}

var r = Ring { items: [10, 20, 30], head: 1 };

print(r[0]);
print(r[2]);

r[0] = 99;
print(r[0]);
