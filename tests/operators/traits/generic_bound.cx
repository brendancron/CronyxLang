type Vec2 { x: int, y: int }

impl Add<Vec2> for Vec2 {
    type Output = Vec2;

    fn add(self, rhs: Vec2): Vec2 {
        return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

fn twice<T: Add<T, Output = T>>(x: T): T {
    return x + x;
}

print(twice(21));
print(twice("ab"));
print(twice(Vec2 { x: 1, y: 2 }).y);
