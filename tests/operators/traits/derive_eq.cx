type Point { x: int, y: int }

derive Eq for Point;

fn count_matches<T: Eq>(items: Array<T>, want: T): int {
    var n = 0;
    for (i in items) {
        if (i == want) {
            n = n + 1;
        }
    }
    return n;
}

var p = Point { x: 1, y: 2 };

print(count_matches([p, Point { x: 1, y: 2 }, Point { x: 3, y: 4 }], p));
print(count_matches([1, 2, 1], 1));

var seats: Set<Point> = [p, Point { x: 1, y: 2 }];
print(seats.len());
