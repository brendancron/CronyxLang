var i = 0;
while (true) {
    if (i == 3) { break; }
    print(i);
    i += 1;
}
for (x in [10, 20, 30, 40]) {
    if (x > 25) { break; }
    print(x);
}
for (var j = 0; j < 5; j += 1) {
    for (var k = 0; k < 5; k += 1) {
        if (k == 1) { break; }
        print(str(j) + "," + str(k));
    }
    if (j == 1) { break; }
}
fn first_even(xs: List<int>): int {
    var found = -1;
    for (x in xs) {
        defer print("checked " + str(x));
        if (x % 2 == 0) { found = x; break; }
    }
    return found;
}
print(first_even([1, 3, 4, 5]));
