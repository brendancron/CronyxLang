type Box { v: int }

impl Box {
    fn twice(self, g: () -> <Console> unit) { g(); g(); }
    fn apply(self, g: (int) -> int): int { return g(self.v); }
}

var b = Box { v: 21 };

b.twice { print("tick"); };
print(b.apply { it * 2 });

var queued: List<() -> <Console> unit> = [];
queued.push { print("queued"); };
queued[0]();
