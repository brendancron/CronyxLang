type Slot<...Args> {
    tag: String,
    use: (...Args) -> <Console> Unit
}

fn any_arity<...Args>(s: Slot<...Args>): String {
    return s.tag;
}

fn one_only<T>(s: Slot<T>): String {
    return s.tag;
}

fn pair(a: Int, b: String) {
    print(str(a) + b);
}

fn only(a: Int) {
    print(a);
}

var two = Slot { tag: "two", use: pair };
var one = Slot { tag: "one", use: only };

print(any_arity(two));
print(any_arity(one));
print(one_only(one));
