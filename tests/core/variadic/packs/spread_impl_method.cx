trait Fire {
    fn fire(self): Int;
}

type Slot<...Args> {
    use: (...Args) -> Int,
    intent: (...Args)
}

impl Fire for Slot<...Args> {
    fn fire(self): Int {
        return self.use(...self.intent);
    }
}

fn add(a: Int, b: Int): Int {
    return a + b;
}

fn one(): Int {
    return 7;
}

var two = Slot { use: add, intent: (1, 2) };
var none = Slot { use: one, intent: () };

print(two.fire());
print(none.fire());
