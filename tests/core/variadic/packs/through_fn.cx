type Slot<...Args> {
    tag: string,
    use: (...Args) -> unit
}

fn tag_of<...Args>(s: Slot<...Args>): string {
    return s.tag;
}

var two = new Slot { tag: "two", use: (a: int, b: int) => { print(a + b); } };
var none = new Slot { tag: "none", use: () => { print(0); } };

print(tag_of(two));
print(tag_of(none));
