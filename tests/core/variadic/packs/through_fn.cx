type Slot<...Args> {
    tag: string,
    use: (...Args) -> unit
}

fn tag_of<...Args>(s: Slot<...Args>): string {
    return s.tag;
}

fn add(a: int, b: int) {
    print(a + b);
}

fn nothing() {
    print(0);
}

var two = Slot { tag: "two", use: add };
var none = Slot { tag: "none", use: nothing };

print(tag_of(two));
print(tag_of(none));
