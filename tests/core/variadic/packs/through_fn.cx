type Slot<...Args> {
    tag: String,
    use: (...Args) -> <Console> Unit
}

fn tag_of<...Args>(s: Slot<...Args>): String {
    return s.tag;
}

fn add(a: Int, b: Int) {
    print(a + b);
}

fn nothing() {
    print(0);
}

var two = Slot { tag: "two", use: add };
var none = Slot { tag: "none", use: nothing };

print(tag_of(two));
print(tag_of(none));
