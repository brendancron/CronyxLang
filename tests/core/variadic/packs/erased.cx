type Move<...Args> {
    name: string,
    apply: (...Args) -> <Console> unit
}

fn burn(a: int, b: int) {
    print(a + b);
}

fn wait() {
    print("wait");
}

var fire = Move { name: "burn", apply: burn };
var rest = Move { name: "wait", apply: wait };

var queue = [];
queue.push(() => { fire.apply(1, 2); });
queue.push(() => { rest.apply(); });

for (step in queue) { step(); }
