type Slot<...Args> {
    use: (...Args) -> <Console> unit
}

fn nothing() {
    print("none");
}

fn one_of(a: int) {
    print(a);
}

fn two_of(a: int, b: string) {
    print(str(a) + b);
}

var none: Slot<> = Slot { use: nothing };
var one: Slot<int> = Slot { use: one_of };
var two: Slot<int, string> = Slot { use: two_of };

none.use();
one.use(1);
two.use(2, "x");
