trait Show {
    fn show(self): String;
}

type Point {
    x: Int,
    y: Int
}

type Color {
    r: Int,
    g: Int,
    b: Int
}

impl Show for Point {
    fn show(self): String {
        return "(" + str(self.x) + ", " + str(self.y) + ")";
    }
}

impl Show for Color {
    fn show(self): String {
        return "rgb(" + str(self.r) + ", " + str(self.g) + ", " + str(self.b) + ")";
    }
}

var p = Point { x: 1, y: 2 };
var c = Color { r: 255, g: 128, b: 0 };

print(p.show());
print(c.show());
