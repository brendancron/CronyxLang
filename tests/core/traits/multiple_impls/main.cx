trait Show {
    fn show(self): string;
}

type Point {
    x: int,
    y: int
}

type Color {
    r: int,
    g: int,
    b: int
}

impl Show for Point {
    fn show(self): string {
        return "(" + str(self.x) + ", " + str(self.y) + ")";
    }
}

impl Show for Color {
    fn show(self): string {
        return "rgb(" + str(self.r) + ", " + str(self.g) + ", " + str(self.b) + ")";
    }
}

var p = Point { x: 1, y: 2 };
var c = Color { r: 255, g: 128, b: 0 };

print(p.show());
print(c.show());
