type Vec2 { x: int, y: int }

impl Add<Vec2> for Vec2 {
    type Output = Vec2;

    fn add(self, rhs: Vec2): Vec2 {
        return Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

impl Eq for Vec2 {
    fn eq(self, rhs: Vec2): bool {
        return self.x == rhs.x && self.y == rhs.y;
    }
}

type Pair<T> { a: T, b: T }

impl Pair<T> {
    fn total(self): T {
        return self.a + self.b;
    }

    fn twice(self): T {
        return self.total() + self.total();
    }

    fn same(self): bool {
        return self.a == self.b;
    }
}

var v = Pair { a: Vec2 { x: 1, y: 2 }, b: Vec2 { x: 10, y: 20 } };
print(str(v.total().x) + " " + str(v.twice().x) + " " + str(v.same()));

var n = Pair { a: 2, b: 3 };
print(str(n.total()) + " " + str(n.twice()) + " " + str(n.same()));

var s = Pair { a: "ab", b: "ab" };
print(str(s.total()) + " " + str(s.same()));
