trait Speaker {
    fn speak(self): string;
}

type Cat;
type Dog;

impl Speaker for Cat {
    fn speak(self): string {
        return "meow";
    }
}

impl Speaker for Dog {
    fn speak(self): string {
        return "woof";
    }
}

fn announce(s: Speaker) {
    print(s.speak());
}

announce(Cat);
announce(Dog);
