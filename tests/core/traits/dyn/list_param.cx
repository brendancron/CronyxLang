trait Speaker {
    fn speak(self): string;
}

type Cat;
type Dog;

impl Speaker for Cat {
    fn speak(self): string {
        return "meow";
    }
}

impl Speaker for Dog {
    fn speak(self): string {
        return "woof";
    }
}

fn all(speakers: List<Speaker>) {
    for (s in speakers) {
        print(s.speak());
    }
}

all([Cat, Dog]);
