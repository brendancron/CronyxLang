trait Ask { @ctl fn get(): Int; }

trait Speaker {
    fn speak(self): <Ask> String;
}

type Cat;

impl Speaker for Cat {
    fn speak(self): <Ask> String {
        return "meow " + str(get());
    }
}

fn main(): Unit {
    var speaker: Speaker = Cat;
    run<Unit> { print(speaker.speak()); }
    handle<Ask> { fn get(resume) { resume(5); } }
}

main();
