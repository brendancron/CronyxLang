trait Speaker {
    fn speak(self): string;
}

type Cat;
type Dog;

impl Speaker for Cat {
    fn speak(self): string {
        return "meow";
    }
}

impl Speaker for Dog {
    fn speak(self): string {
        return "woof";
    }
}

fn pick(loud: bool): Speaker {
    if (loud) {
        return Dog;
    }
    return Cat;
}

print(pick(true).speak());
print(pick(false).speak());
