trait Speaker {
    fn speak(self): string;
}

trait Walker {
    fn walk(self): string;
}

type Cat;

impl Speaker for Cat {
    fn speak(self): string {
        return "meow";
    }
}

impl Walker for Cat {
    fn walk(self): string {
        return "pads";
    }
}

fn stroll<W: Walker>(w: W) {
    print(w.walk());
}

var sp: Speaker = Cat;
stroll(sp);
