impl Int {
    fn double(self): Int {
        return self * 2;
    }
}

impl String {
    fn shout(self): String {
        return self + "!";
    }
}

impl Array<T> {
    fn first(self): T {
        return self[0];
    }
}

print(21.double());
print("hey".shout());
print([7, 8, 9].first());
print(["a", "b"].first());
