type Box<T> { v: T }

impl Box<T> {
    fn get(self): T {
        return self.v;
    }

    fn same(self): T {
        return self.v;
    }
}

var a = Box { v: 1 };
var b = Box { v: "s" };
print(str(a.get()) + " " + str(b.get()));
print(str(a.same()) + " " + str(b.same()));

var xs: List<int> = [1, 2];
var ys: List<string> = ["x"];
xs.push(3);
ys.push("y");
print(str(xs.len()) + " " + str(ys.len()));
print(str(xs[2]) + " " + str(ys[1]));
