trait Describe { fn describe(self): string; }

impl Describe for int { fn describe(self): string { return "#" + str(self); } }
impl Describe for string { fn describe(self): string { return "'" + self + "'"; } }

impl Describe for List<T: Describe> {
    fn describe(self): string {
        var out = "[";
        for (x in self) { out = out + x.describe() + " "; }
        return out + "]";
    }
}

type Pair<A, B> { left: A, right: B }

impl Describe for Pair<A: Describe, B: Describe> {
    fn describe(self): string { return self.left.describe() + " & " + self.right.describe(); }
}

print([1, 2].describe());
print(["a"].describe());
var nested: List<List<int>> = [[3], [4, 5]];
print(nested.describe());
var named: List<string> = ["b"];
print(Pair { left: 1, right: named }.describe());
