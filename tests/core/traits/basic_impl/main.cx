trait Describe {
    fn describe(self): string;
}

type Circle {
    radius: int
}

type Rectangle {
    width: int,
    height: int
}

impl Describe for Circle {
    fn describe(self): string {
        return "circle with radius " + str(self.radius);
    }
}

impl Describe for Rectangle {
    fn describe(self): string {
        return "rectangle " + str(self.width) + "x" + str(self.height);
    }
}

var c = Circle { radius: 5 };
var r = Rectangle { width: 3, height: 4 };

print(c.describe());
print(r.describe());
