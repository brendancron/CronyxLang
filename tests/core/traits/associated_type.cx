trait Container {
    type Item;

    fn first(self): Item;
}

type Bag { values: Array<int> }
type Label { text: string }

impl Container for Bag {
    type Item = int;

    fn first(self): int {
        return self.values[0];
    }
}

impl Container for Label {
    type Item = string;

    fn first(self): string {
        return self.text;
    }
}

fn head<T: Container>(c: T): T.Item {
    return c.first();
}

print(head(Bag { values: [7, 8] }));
print(head(Label { text: "hi" }));
