type Rectangle {
    width: int,
    height: int
}

impl Rectangle {
    fn area(self): int {
        return self.width * self.height;
    }

    fn scaled(self, factor: int): Rectangle {
        return Rectangle { width: self.width * factor, height: self.height * factor };
    }

    fn describe(self): string {
        return str(self.width) + "x" + str(self.height) + " = " + str(self.area());
    }
}

fn report(r: Rectangle) {
    print(r.describe());
}

var r = Rectangle { width: 3, height: 4 };
report(r);
report(r.scaled(2));
print(r.area());
