trait To<T> {
    fn to(self): T;
}

type Flag { raw: int }

impl To<string> for Flag {
    fn to(self): string { return "flag " + str(self.raw); }
}

impl To<bool> for Flag {
    fn to(self): bool { return self.raw != 0; }
}

var f = Flag { raw: 1 };
print(f.to<string>());
print(str(f.to<bool>()));

var flag: bool = f.to<bool>();
print(str(flag));

type Plain { n: int }

impl To<int> for Plain {
    fn to(self): int { return self.n; }
}

var p = Plain { n: 7 };
print(str(p.to()));
print(str(p.to<int>()));
