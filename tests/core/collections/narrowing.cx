type Stack { n: int }

impl Stack {
    fn push(self, v: int) {
        self.n = self.n + v;
    }
}

var xs = [1, 2, 3];
xs.push(4);
print(str(xs.len()) + " " + str(xs[3]) + " " + str(typeof(xs).name));

var ys = [1, 2];
print(str(ys.len()) + " " + str(typeof(ys).name));

var s = Stack { n: 0 };
s.push(5);
print(s.n);
