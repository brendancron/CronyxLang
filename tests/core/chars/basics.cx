var c = 'a';
print(str(c) + " " + str(typeof(c).name));
print(str(c == 'a') + " " + str(c == 'b'));
print(str(c));

var letters: Array<char> = ['x', 'y'];
letters[0] = 'z';
print(str(letters) + " " + str(letters.len()) + " " + str(letters.contains('y')));

fn repeat(c: char, times: int): Array<char> {
    var out = Array<char>(times, c);
    return out;
}
print(str(repeat('!', 3)) + " " + str(typeof(repeat).name));
