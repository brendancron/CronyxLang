type Point { x: int, y: int }
type Shape { Circle(int), Square(int) }

var p = new Point { x: 1, y: 2 };
var q = new Point { x: 1, y: 2 };

print(str(p == q) + " " + str(same(p, q)) + " " + str(same(p, p)));
print(new Point { x: 1, y: 9 } == p);

var nested = [[1, 2], [3]];
print(str(nested == [[1, 2], [3]]) + " " + str(nested == [[1, 2], [4]]));

print(Shape::Circle(3) == Shape::Circle(3));
print(Shape::Circle(3) == Shape::Square(3));

print(str((1, "a") == (1, "a")) + " " + str((1, "a") == (1, "b")));

var ps: Set<Point> = [p, q];
print(str(ps.len()) + " " + str(ps.contains(new Point { x: 1, y: 2 })));

var seats: Map<Point, string> = [(p, "aisle")];
print(seats.get_or(q, "missing"));

print(str(same(1, 1)) + " " + str(same("ab", "ab")));
