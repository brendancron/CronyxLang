// The deferred statement runs when the function's scope is left, which is
// before the caller sees the result — the same as in a function the CPS pass
// left alone.
effect Ask { ctl get(): int; }

fn f(): <Ask, Console> int {
    defer print("cleanup");
    print("body");
    return get();
}

run { print(f()); } handle Ask { ctl get() { resume 1; print("after arm"); } }
print("after");
