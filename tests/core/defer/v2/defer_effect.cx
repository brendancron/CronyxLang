trait Error { @ctl fn throw<T>(msg: string): T; }

fn risky(bad: bool): int {
    defer print("cleanup");
    if (bad) { return throw("failed"); }
    return 1;
}

run { print(risky(false)); } handle<Error> { fn throw(m, resume) { print("caught" + " " + str(m)); } }
run { print(risky(true)); } handle<Error> { fn throw(m, resume) { print("caught" + " " + str(m)); } }
