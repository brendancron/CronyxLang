// The flag that keeps an unwind from running the statement twice is set when
// the scope is entered and cleared when it is left. A resumption re-enters the
// scope without re-executing the `defer`, so the flag stays clear and an unwind
// on a later pass finds nothing armed.
effect Logic { ctl choose(options: Array<int>): int; }
effect Err { final ctl fail(msg: string); }

fn pick(): <Logic, Err, Console> int {
    defer print("cleanup");
    var n = choose([1, 2]);
    if (n == 2) { return fail("second"); }
    return n;
}

run {
    run { print(pick()); }
    handle Err { final ctl fail(m) { print("caught " + str(m)); } }
} handle Logic { ctl choose(options) { for (x in options) { resume x; } } }
