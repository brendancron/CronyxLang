type Shape {
    Point,
    Circle(int),
    Rect { w: int, h: int },
}

type Maybe<T> { Some(T), None }

fn area(s: Shape): int {
    return match s {
        Shape.Point => 0,
        Shape.Circle(r) => 3 * r * r,
        Shape.Rect { w, h } => w * h,
    };
}

fn or_else<T>(m: Maybe<T>, fallback: T): T {
    return match m { Maybe.Some(v) => v, Maybe.None => fallback };
}

fn check(s: Shape): string {
    var unused = match s {
        Shape.Circle(r) => {
            if (r < 0) { return "negative"; }
        }
        _ => { }
    };
    return "fine";
}

var name = match Shape.Circle(2) {
    Shape.Point => "point",
    Shape.Circle(r) => "circle",
    _ => "rect",
};
print(name);

print(area(Shape.Rect { w: 3, h: 4 }) + area(Shape.Circle(1)));
print(or_else(Maybe.Some(5), 0));
print(or_else(Maybe.None, "none"));
print(check(Shape.Circle(-1)));
print(check(Shape.Circle(1)));

var describe = (s: Shape) => match s { Shape.Point => "p", _ => "not p" };
print(describe(Shape.Point));
print(describe(Shape.Circle(0)));

print(match Shape.Point { Shape.Point => { 1 } _ => { 2 } } + 10);

var nested = match Shape.Circle(1) {
    Shape.Circle(r) => match Maybe.Some(r) { Maybe.Some(v) => v + 100, Maybe.None => 0 },
    _ => -1,
};
print(nested);

match Shape.Point {
    Shape.Point => print("statement"),
    _ => print("unreached"),
}
