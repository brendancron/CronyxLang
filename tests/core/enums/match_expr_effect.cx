trait Ask { @ctl fn ask(): Int; }

type Shape { Point, Circle(Int) }

fn size(s: Shape): Int {
    return match s {
        Shape.Point => ask(),
        Shape.Circle(r) => r * ask(),
    };
}

run<Unit> {
    print(size(Shape.Circle(4)));
    print(size(Shape.Point));
} handle<Ask> {
    fn ask(resume) { resume(10); }
}
