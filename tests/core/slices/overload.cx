// Slicing is indexing by a range, so a type joins in by declaring the entry —
// there is no separate slice operator to implement.
type Ring { items: List<int> }

impl Index<Range> for Ring {
    type Output = List<int>;

    fn get(self, r: Range): List<int> {
        return self.items[r];
    }
}

var r = Ring { items: [1, 2, 3, 4] };

var middle = r[1:3];
print(str(middle.len()) + " " + str(middle[0]) + " " + str(middle[1]));
print(str(r[:2].len()) + " " + str(r[2:].len()));
print(str(r[-2:][0]) + " " + str(r[:].len()));
