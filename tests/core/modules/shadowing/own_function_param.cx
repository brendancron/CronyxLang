trait Stop { @abort fn stop<T>(): T; }
trait Ask { @ctl fn ask(): Int; }
fn answering<E>(task: () -> <Ask, E> Unit): <E> Unit {
    run<Unit> {
        task();
    } handle<Ask> {
        fn ask(resume) { resume(7); }
    }
}
fn task() { print("plain"); }
run<Unit> {
    answering(() => { print(ask()); stop(); print("not reached"); });
} handle<Stop> {
    fn stop() { print("stopped"); }
}
task();
