type Point { x: int, y: int }

type Shape { Circle(int), Square(int), Rect { w: int, h: int } }

trait Area {
    fn area(self): int;
}

impl Area for Point {
    fn area(self): int {
        return self.x * self.y;
    }
}

impl Point {
    fn shifted(self, by: int): Point {
        return Point { x: self.x + by, y: self.y + by };
    }
}

fn origin(): Point {
    return Point { x: 0, y: 0 };
}

fn describe(s: Shape): string {
    match s {
        Shape.Circle(r) => { return "circle " + str(r); }
        Shape.Square(w) => { return "square " + str(w); }
        Shape.Rect { w, h } => { return "rect " + str(w * h); }
    }
    return "?";
}
