import "geom";
import { Point } from "geom";

var p: geom.Point = new geom.Point { x: 2, y: 3 };
print(str(p.area()) + " " + str(p.shifted(1).x));

var q: Point = geom.origin();
print(str(q.x) + " " + str(q.area()));

print(geom.describe(geom.Shape.Circle(3)));
print(geom.describe(geom.Shape.Square(4)));
print(geom.describe(geom.Shape.Rect { w: 2, h: 5 }));

match geom.Shape.Circle(7) {
    geom.Shape.Circle(r) => { print(r); }
    _ => { print(0); }
}

type Point2 { x: int }
var mine = new Point2 { x: 9 };
print(mine.x);
