type Shape { Circle(int), Rect { w: int, h: int }, Dot, }
type P { x: int, y: int, }

fn area<s: Shape>(): int {
    return match (s) {
        Shape.Circle(r) => 3 * r * r,
        Shape.Rect { w, h } => w * h,
        Shape.Dot => 0,
    };
}

fn sum<p: P>(): int {
    meta print("sum<" + str(p.x) + ", " + str(p.y) + ">");
    return p.x + p.y;
}

fn scaled<k: int>(): int {
    return k;
}

fn projected<p: P>(): int {
    return scaled<p.x * 10>();
}

fn joined<t: (int, string)>(): string {
    return str(t.0) + t.1;
}

fn total<xs: Array<int>>(): int {
    var n = 0;
    for (x in xs) {
        n = n + x;
    }
    return n;
}

print(area<Shape.Circle(2)>());
print(area<Shape.Rect { w: 3, h: 4 }>());
print(area<Shape.Dot>());
print(sum<P { x: 1, y: 2 }>());
print(sum<P { y: 2, x: 1 }>());
print(projected<P { x: 4, y: 0 }>());
print(joined<(1, "a")>());
print(total<[1, 2, 3]>());
