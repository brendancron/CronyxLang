type P { x: int, }

fn bump<p: P>(): int {
    p.x = p.x + 1;
    return p.x;
}

fn first<xs: Array<int>>(): int {
    xs[0] = xs[0] * 10;
    return xs[0];
}

fn count<n: int>(): int {
    n = n + 1;
    return n;
}

print(bump<P { x: 1 }>());
print(bump<P { x: 1 }>());
print(first<[2, 3]>());
print(first<[2, 3]>());
print(count<5>());
print(count<5>());
