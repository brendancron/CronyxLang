type Vec2 {
    x: int,
    y: int
}

impl Add<Vec2> for Vec2 {
    type Output = Vec2;

    fn add(self, rhs: Vec2): Vec2 {
        return new Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

fn sum<T>(xs: Array<T>): T {
    var total = xs[0];
    var i = 1;
    while (i < 3) {
        total = total + xs[i];
        i = i + 1;
    }
    return total;
}

print(sum([1, 2, 3]));
print(sum(["a", "b", "c"]));

var v = sum([new Vec2 { x: 1, y: 1 }, new Vec2 { x: 2, y: 2 }, new Vec2 { x: 3, y: 3 }]);
print(v.x);
print(v.y);
