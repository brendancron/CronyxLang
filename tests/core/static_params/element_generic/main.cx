type Vec2 { x: int, y: int }

impl Add<Vec2> for Vec2 {
    type Output = Vec2;

    fn add(self, rhs: Vec2): Vec2 {
        return new Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

fn accumulate<T>(xs: Array<T>) {
    xs[0] = xs[0] + xs[1];
}

var vs = [new Vec2 { x: 1, y: 1 }, new Vec2 { x: 2, y: 2 }];
accumulate(vs);
print(str(vs[0].x) + " " + str(vs[0].y));

var ns = [10, 20];
accumulate(ns);
print(ns[0]);

var ws = ["a", "b"];
accumulate(ws);
print(ws[0]);

var ls: List<int> = [1, 2];
print(ls.len());
