fn greet(name: string) {
    print("hello, " + name);
    eprint("greeted " + name);
}

var out: List<string> = [];
var err: List<string> = [];

run {
    greet("ada");
    greet("bo");
} handle Console {
    fn write(to, text) {
        match to {
            Stream.Out => { out.push(text); }
            Stream.Err => { err.push(text); }
        }
    }
}

print(out.len());
print(out[0] == "hello, ada\n");
print(err[1] == "greeted bo\n");
