import { Stream } from "std/io/Console";

fn greet(name: String) {
    print("hello, " + name);
    printerr("greeted " + name);
}

var out: List<String> = [];
var err: List<String> = [];

run<Unit> {
    greet("ada");
    greet("bo");
} handle<Console> {
    fn write(to, text) {
        match to {
            Stream.Out => { out.push(text); }
            Stream.Err => { err.push(text); }
        }
    }
}

print(out.len());
print(out[0] == "hello, ada\n");
print(err[1] == "greeted bo\n");
