type Pair<A, B,> {
    xs: List<Int,>,
    a: A,
    b: B,
}

type Shape {
    Circle(Int, Int,),
    Square { w: Int, },
}

fn add(a: Int, b: Int,): Int {
    return a + b;
}

fn pair(): (Int, Int,) {
    return (1, 2,);
}

var p = Pair<Int, String,> { xs: [1, 2,], a: 3, b: "s", };
var (left, right,) = pair();

print(add(left, right,));
print(p.xs);
print(p.b);

match (Shape.Circle(4, 5,)) {
    Shape.Circle(w, h,) => { print(add(w, h,)); }
    Shape.Square { w, } => { print(w); }
}
