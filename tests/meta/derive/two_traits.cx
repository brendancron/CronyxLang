// One statement, one deriver per trait, both generating for the same type.
type Dog { name: String, age: Int }

trait Eq { fn eq(self, other: Dog): Bool; }
trait Show { fn show(self): String; }

fn derive(shape: TypeShape) for Eq {
    match shape {
        TypeShape.Product(t, _, fields) => {
            var check = code(true);
            for (f in fields) {
                var field = f.name;
                check = code(check && self.field == other.field);
            }
            gen impl Eq for t {
                fn eq(self, other: t): Bool { return check; }
            }
        }
        TypeShape.Sum(t, _, variants) => {}
        TypeShape.Scalar => {}
        TypeShape.Other => {}
    }
}

fn derive(shape: TypeShape) for Show {
    match shape {
        TypeShape.Product(t, _, fields) => {
            var label = str(t);
            var text = code(label);
            for (f in fields) {
                var field = f.name;
                text = code(text + " " + str(self.field));
            }
            gen impl Show for t {
                fn show(self): String { return text; }
            }
        }
        TypeShape.Sum(t, _, variants) => {}
        TypeShape.Scalar => {}
        TypeShape.Other => {}
    }
}

derive Eq, Show for Dog;

var rex = Dog { name: "rex", age: 3 };
var older = Dog { name: "rex", age: 4 };
print(str(rex.eq(rex)) + " " + str(rex.eq(older)));
print(rex.show());
