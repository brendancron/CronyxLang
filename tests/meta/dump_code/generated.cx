trait Show {
    fn show(self): String;
}

fn derive(shape: TypeShape) for Show {
    match shape {
        TypeShape.Product(t, _, _) => {
            var name = str(t);
            gen impl Show for t {
                fn show(self): String { return name; }
            }
        }
        _ => {}
    }
}

type Point { x: Int, y: Int }

derive Show for Point;

fn unused(): Int { return 0; }

print("first");
meta {
    print("while compiling");
    for (name in ["a", "b"]) {
        var made = ("say_" + name).as_name();
        gen fn made() { print(name); }
        gen made();
    }
}
var width = meta { gen code(2 * 3); };
print(Point { x: 1, y: 2 }.show());
print(width);
