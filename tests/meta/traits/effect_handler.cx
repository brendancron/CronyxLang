import { DeclKind, MethodSig, Param, Signature, TypeExpr, TypeKind } from "std/compiler/Ast";
import { decl_source } from "std/compiler/Printer";
import { fail } from "std/core/Error";

trait EffectHandler<E, R> {
    meta {
        match declof(E).kind {
            DeclKind.Trait(eff) => {
                for (op in eff.methods) {
                    gen handled(op);
                }
            }
            _ => { fail<unit>("not a trait, so it has no operations to handle"); }
        }
    }
}

fn takes_control(op: MethodSig): bool {
    for (a in op.attrs) {
        if (str(a.name) == "ctl") { return true; }
    }
    return false;
}

fn handled(op: MethodSig): MethodSig {
    if (!takes_control(op)) { return op; }

    var answer = TypeExpr.of(TypeKind.Named("R".as_name()));
    var resumes = TypeExpr.of(TypeKind.Named("unit".as_name()));
    match op.signature.ret {
        Option.Some(t) => { resumes = t; }
        _ => {}
    }

    var params: List<Param> = [];
    for (p in op.params) { params.push(p); }
    params.push(Param {
        name: "resume".as_name(),
        ty: Option.Some(TypeExpr.of(TypeKind.Function([resumes], answer, []))),
        implicit: false
    });

    return MethodSig {
        name: op.name,
        params: params,
        signature: Signature {
            ret: Option.Some(answer),
            row: Option.None,
            static_params: op.signature.static_params
        },
        attrs: op.attrs
    };
}

trait Effect {
    fn log(msg: string): unit;
    @ctl fn choose(options: Array<int>): int;
}

type Picker {}

impl EffectHandler<Effect, string> for Picker {
    fn log(msg: string): unit {
        print(msg);
    }
    fn choose(options: Array<int>, resume: (int) -> string): string {
        var last = "";
        for (x in options) { last = resume(x); }
        return last;
    }
}

type Collector<R> {}

impl EffectHandler<Effect, R> for Collector<R> {
    fn log(msg: string): unit {
        print("collected: " + msg);
    }
    fn choose(options: Array<int>, resume: (int) -> R): R {
        return resume(options[0]);
    }
}

meta {
    print(decl_source(declof(EffectHandler<Effect, string>)));
    print(decl_source(declof(EffectHandler<Effect, int>)));
}

Picker.log("picking");
print(Picker.choose([1, 2], (x) => str(x)));
