import { MethodSig, Param, Signature, TypeExpr, TypeKind } from "std/compiler/Ast";

fn sig_named(name: string, ret: string): MethodSig {
    return MethodSig {
        name: name.as_name(),
        params: [Param { name: "self".as_name(), ty: Option.None, implicit: false }],
        signature: Signature {
            ret: Option.Some(TypeExpr.of(TypeKind.Named(ret.as_name()))),
            row: Option.None,
            static_params: []
        },
        attrs: []
    };
}

trait Shown<T> {
    meta {
        print("making Shown<" + typeof(T).name + ">");
        gen sig_named("show", "string");
    }
}

type A {}
type B {}
type C {}

impl Shown<int> for A {
    fn show(self): string { return "an A"; }
}

impl Shown<string> for B {
    fn show(self): string { return "a B"; }
}

impl Shown<int> for C {
    fn show(self): string { return "a C"; }
}

print(A {}.show());
print(B {}.show());
print(C {}.show());
