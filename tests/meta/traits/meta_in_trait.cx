import { MethodSig, Param, Signature, TypeExpr, TypeKind } from "std/compiler/Ast";

fn sig_named(name: String, ret: String): MethodSig {
    return MethodSig {
        name: name.as_name(),
        params: [Param { name: "self".as_name(), ty: Option.None, implicit: false }],
        signature: Signature {
            ret: Option.Some(TypeExpr.of(TypeKind.Named(ret.as_name()))),
            row: Option.None,
            static_params: [], inline: false
        },
        attrs: []
    };
}

trait Getter<T> {
    fn describe(self): String;
    meta {
        gen sig_named("get", "T");
    }
}

type Box { value: Int }

impl Getter<Int> for Box {
    fn describe(self): String { return "a box"; }
    fn get(self): Int { return self.value; }
}

var b = Box { value: 7 };
print(b.describe());
print(b.get() + 1);
