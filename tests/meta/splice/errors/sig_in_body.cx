import { MethodSig, Signature, TypeExpr, TypeKind } from "std/compiler/Ast";

fn getter(): MethodSig {
    return MethodSig {
        name: "get".as_name(),
        params: [],
        signature: Signature {
            ret: Option.Some(TypeExpr.of(TypeKind.Named("Int".as_name()))),
            row: Option.None,
            static_params: []
        },
        attrs: []
    };
}

meta {
    gen getter();
}
