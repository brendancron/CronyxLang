/**
 * What this file is about.
 *
 * A blank line stands between this and the first declaration, so it is the
 * file's prose rather than the type's.
 */

type Bare {
    x: int,
}

/** This one has its own. */
type Own {
    y: int,
}

meta {
    print("Bare: [" + typeof(Bare).doc + "]");
    print("Own: [" + typeof(Own).doc + "]");
}
