@table("people")
@version(2)
type Person {
    name: string,
}

@test
fn greet() {
    print("hello");
}

greet();

for (a in typeof(Person).attrs) {
    var written = str(a.name);
    for (arg in a.args) {
        match arg {
            AttrArg.Str(v) => { written = written + "=" + v; }
            AttrArg.Int(v) => { written = written + "=" + str(v); }
            _ => {}
        }
    }
    print(written);
}
