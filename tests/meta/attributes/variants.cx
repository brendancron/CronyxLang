type Shape {
    @tag("c") Circle(int),
    @tag("r") Rect(int, int),
    Point,
}

trait Tagged {
    fn tags(self): string;
}

meta fn derive(shape: TypeShape) for Tagged {
    match shape {
        TypeShape::Sum(t, variants) => {
            var tname = str(t);
            var text = code(tname);
            for (v in variants) {
                var label = str(v.name);
                for (a in v.attrs) {
                    if (str(a.name) == "tag") {
                        for (arg in a.args) {
                            match arg {
                                AttrArg::Str(x) => { label = label + ":" + x; }
                                _ => {}
                            }
                        }
                    }
                }
                var head = code(label);
                text = code(text + " " + head);
            }
            gen impl Tagged for t {
                fn tags(self): string { return text; }
            }
        }
        _ => {}
    }
}

derive Tagged for Shape;

print(Shape::Point.tags());
