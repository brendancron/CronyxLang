import { DeclKind } from "std/compiler/Ast";
import { decl_source } from "std/compiler/Printer";

type Dog { name: string }

trait Barks { fn bark(self): string; }

fn describe<T>() {
    meta {
        match declof(T).kind {
            DeclKind.Type(t) => { print("a type named " + str(t.name)); }
            DeclKind.Trait(t) => { print("a trait named " + str(t.name)); }
            _ => { print("something else"); }
        }
    }
}

describe<Dog>();
describe<Barks>();
