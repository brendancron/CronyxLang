import { DeclKind } from "std/compiler/Ast";
import { decl_source } from "std/compiler/Printer";

fn greet(name: string) {
    print("Hello, " + name);
}

meta {
    var d = declof(greet);
    print(decl_source(d));
    match d.kind {
        DeclKind.Fn(f) => { print("a function named " + str(f.name)); }
        _ => { print("something else"); }
    }
}
greet("ada");
