// `depth` calls itself at `Nested<(T, T)>` while being checked at `Nested<T>`.
// Inference cannot find that on its own, which is why it takes a written
// signature: the recursive occurrence is bound to what the author declared,
// generalized, rather than to the copy being checked.
type Nested<T> {
    Leaf(T),
    Deep(Nested<(T, T)>),
}

fn depth<T>(n: Nested<T>): int {
    match n {
        Nested::Leaf(x)     => { return 0; }
        Nested::Deep(inner) => { return 1 + depth(inner); }
    }
}

print(depth(Nested::Leaf(1)));
print(depth(Nested::Deep(Nested::Leaf((1, 2)))));
print(depth(Nested::Deep(Nested::Deep(Nested::Leaf(((1, 2), (3, 4)))))));
