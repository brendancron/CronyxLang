// The cap must name the function whose copies keep growing, not whichever
// generic the copy table happens to end on.
type Nested<T> { Leaf(T), Deep(Nested<(T, T)>) }

fn ok<T>(a: T, b: T): int { if (a == b) { return 1; } return 0; }

fn find<T>(n: Nested<T>, seed: T): int {
    match n {
        Nested::Leaf(x) => { return ok(x, seed); }
        Nested::Deep(i) => { return find(i, (seed, seed)); }
    }
}

print(find(Nested::Leaf(5), 5));
