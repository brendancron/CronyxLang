// Polymorphic recursion the checker accepts, and monomorphization cannot serve:
// `==` on the payload needs a concrete type to select an operator, and there is
// a different one at every depth. Rejected rather than compiled forever.
type Nested<T> { Leaf(T), Deep(Nested<(T, T)>) }

fn find<T>(n: Nested<T>, seed: T): int {
    match n {
        Nested::Leaf(x) => { if (x == seed) { return 1; } return 0; }
        Nested::Deep(i) => { return find(i, (seed, seed)); }
    }
}

print(find(Nested::Leaf(5), 5));
