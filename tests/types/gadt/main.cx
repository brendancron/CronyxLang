// Each constructor pins the type parameter, and a match arm refines it, which
// is what makes `eval` total and cast-free. `Add` cannot be built from a
// `BoolLit`, so the ill-typed tree is not representable.
type Expr<T> {
    Lit(int)                            -> Expr<int>,
    Add(Expr<int>, Expr<int>)           -> Expr<int>,
    BoolLit(bool)                       -> Expr<bool>,
    If<A>(Expr<bool>, Expr<A>, Expr<A>) -> Expr<A>,
}

fn eval<T>(e: Expr<T>): T {
    match e {
        Expr::Lit(n)      => { return n; }
        Expr::Add(l, r)   => { return eval(l) + eval(r); }
        Expr::BoolLit(b)  => { return b; }
        Expr::If(c, t, f) => { if (eval(c)) { return eval(t); } return eval(f); }
    }
}

print(eval(Expr::Add(Expr::Lit(40), Expr::Lit(2))));
print(eval(Expr::If(Expr::BoolLit(true), Expr::Lit(1), Expr::Lit(0))));

// Length-indexed: `head` takes a vector one longer than some N, so `Nil` cannot
// reach it and the single arm is exhaustive.
type Zero { }
type Succ<N> { }

type Vec<N, T> {
    Nil                   -> Vec<Zero, T>,
    Cons<M>(T, Vec<M, T>) -> Vec<Succ<M>, T>,
}

fn head<N, T>(v: Vec<Succ<N>, T>): T {
    match v {
        Vec::Cons(x, rest) => { return x; }
    }
}

var one = Vec::Cons(10, Vec::Nil);
var two = Vec::Cons(20, one);

print(head(two));
print(head(one));
