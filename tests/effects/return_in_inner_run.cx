// A `run` whose handler needs no continuation still has a body that might: the
// `return` here leaves `f`, which by then is a converted function, so it has to
// reach that function's continuation rather than the block's.
effect E { ctl ask(): int; }
effect Log { fn note(): unit; }

fn f(): <E, Console> int {
    run {
        note();
        return 1;
    } handle Log { fn note() { print("noted"); } }
    return ask();
}

run {
    print(f());
} handle E {
    ctl ask() {
        resume 7;
        print("after");
    }
}
