trait E { @ctl fn ask(): Int; }
trait Log { fn note(): Unit; }

fn f(): <E, Console> Int {
    run<Unit> {
        note();
        return 1;
    } handle<Log> { fn note() { print("noted"); } }
    return ask();
}

run<Unit> {
    print(f());
} handle<E> {
    fn ask(resume) {
        resume(7);
        print("after");
    }
}
