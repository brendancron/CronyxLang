trait Effect {
    fn log(msg: String): Unit;
    @ctl fn choose(options: Array<Int>): Int;
}

type Picker<R> {}

impl EffectHandler<Effect, R> for Picker<R> {
    fn log(msg: String): Unit {
        print(msg);
    }
    fn choose(options: Array<Int>, k: (Int) -> R): R {
        var last = k(options[0]);
        var i = 1;
        while (i < options.len()) {
            last = k(options[i]);
            i = i + 1;
        }
        return last;
    }
}

run<Unit> {
    log("statement");
    var n = choose([3, 4]);
    print(n);
} with Picker;

var r = run<Int> {
    var n = choose([5, 6]);
    n * 10
} with Picker;

print(r);
