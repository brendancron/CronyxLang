effect Logger {
    fn log(msg: String): Unit;
}

effect Counter {
    ctl tick(): Unit;
}

fn greet(name: String) {
    log("Hello, " + name);
    tick();
    log("Bye, " + name);
}

run {
    greet("Alice");
    greet("Bob");
} handle Logger {
    fn log(msg) {
        print("[LOG] " + msg);
    }
} handle Counter {
    ctl tick() {
        print("[TICK]");
        resume;
    }
}
