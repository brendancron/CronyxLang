trait Logger {
    fn log(msg: String): Unit;
}

trait Counter {
    @ctl fn tick(): Unit;
}

fn greet(name: String) {
    log("Hello, " + name);
    tick();
    log("Bye, " + name);
}

run<Unit> {
    greet("Alice");
    greet("Bob");
} handle<Logger> {
    fn log(msg) {
        print("[LOG] " + msg);
    }
} handle<Counter> {
    fn tick(resume) {
        print("[TICK]");
        resume(());
    }
}
