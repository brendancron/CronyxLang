trait Pause { @ctl fn pause(): Unit; }

fn inner(): <Pause, Console> Unit {
    defer print("inner cleaned up");
    print("inner before");
    pause();
    print("inner never");
}

fn outer(): <Pause, Console> Unit {
    defer print("outer cleaned up");
    inner();
    print("outer never");
}

run<Unit> { outer(); } handle<Pause> {
    fn pause(resume) {
        print("arm before");
        discontinue(resume);
        print("arm after");
    }
}
print("first done");

var later: List<() -> <Console> Unit> = [];
run<Unit> { outer(); } handle<Pause> {
    fn pause(resume) { later.push(() => { discontinue(resume); }); }
}
print("second run returned");
later[0]();
print("second done");
