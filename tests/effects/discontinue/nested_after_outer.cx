trait Throw<X> { @ctl fn throw<T>(err: X): T; }

trait Park { @ctl fn park(): Unit; }

var stops: List<() -> <Console> Unit> = [];
var wakes: List<() -> <Console> Unit> = [];

fn parked<E>(
    stops: List<() -> <Console> Unit>,
    wakes: List<() -> <Console> Unit>,
    task: () -> <Park, Throw<String>, E> Unit,
): <Console, E> Unit {
    run<Unit> {
        run<Unit> {
            task();
        } handle<Throw<String>> {
            fn throw(e, resume) {
                print("failed: " + e);
                stops[2]();
                stops[1]();
            }
        }
    } handle<Park> {
        fn park(resume) {
            stops.push(() => { discontinue(resume); });
            wakes.push(() => { resume(()); });
        }
    }
}

parked(stops, wakes, () => {
    defer { print("outer cleans up"); }
    parked(stops, wakes, () => { park(); throw("boom"); });
    parked(stops, wakes, () => { defer { print("inner cleans up"); } park(); print("inner resumed"); });
    park();
    print("outer resumed");
});
wakes[0]();
print("done");
