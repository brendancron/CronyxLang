trait Error { @abort fn throw<T>(msg: String): T; }

fn outer(limit: Int) {
    var seen: List<Int> = [];
    var total = 0;
    fn take(n: Int) {
        if (n > limit) { throw("too big: " + str(n)); }
        seen.push(n);
        total = total + n;
    }
    run<Unit> {
        take(1);
        take(2);
        take(5);
        take(3);
    } handle<Error> {
        fn throw(m) { print(m); }
    }
    print(seen);
    print(total);
}
outer(4);
