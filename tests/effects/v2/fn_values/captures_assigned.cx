trait Fails<X> {
    @ctl fn fails<T>(err: X): T;
}

type Outcome<T, X> {
    Ok(T),
    Err(X)
}

fn attempt<X, T, E>(f: () -> <Fails<X>, E> T): <E> Outcome<T, X> {
    var outcome: Option<Outcome<T, X>> = Option.None;
    run {
        outcome = Option.Some(Outcome.Ok(f()));
    } handle<Fails> {
        fn fails(e, resume) { outcome = Option.Some(Outcome.Err(e)); }
    }
    match outcome {
        Option.Some(r) => { return r; }
        Option.None => { panic("attempt: neither a value nor a failure"); }
    }
}

fn parse(text: string): <Fails<string>> int {
    if (text == "") { return fails("empty"); }
    return text.len();
}

fn report(o: Outcome<int, string>) {
    match o {
        Outcome.Ok(n) => { print("ok " + str(n)); }
        Outcome.Err(e) => { print("err " + e); }
    }
}

fn counted(words: List<string>): int {
    var total = 0;
    var last = "";
    for (w in words) {
        report(attempt(() => {
            last = w;
            total += parse(w);
            return total;
        }));
    }
    print("last " + last);
    return total;
}

report(attempt(() => parse("abc")));
report(attempt(() => parse("")));
print(counted(["ab", "", "cde"]));
