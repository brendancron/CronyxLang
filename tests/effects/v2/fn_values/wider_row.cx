trait Log { fn log(s: String): Unit; }
trait Tick { fn tick(): Unit; }
trait Ask { @ctl fn ask(): Int; }

fn call_it<E>(f: () -> <Log, Tick, E> Unit): <Log, Tick, E> Unit { f(); }

fn only_logs() { log("only logs"); }
fn nothing() { print("performs nothing"); }
fn asks() { log("asked " + str(ask())); }

run<Unit> {
    call_it(only_logs);
    call_it(nothing);
    call_it(asks);
} handle<Log> {
    fn log(s) { print(s); }
} handle<Tick> {
    fn tick() { }
} handle<Ask> {
    fn ask(resume) { resume(42); }
}
