trait Sched {
    @ctl fn tick(): Unit;
}

var queue: List<() -> <Console> Unit> = [];

fn run_one(task: () -> <Sched, Console> Unit): Unit {
    run<Unit> {
        task();
    } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

fn spawn(t: () -> <Sched, Console> Unit) { queue.push { run_one(t); }; }

fn child(): <Sched, Console> Unit { print("child a"); tick(); print("child b"); }

fn parent(): <Sched, Console> Unit {
    print("parent a");
    spawn(child);
    tick();
    print("parent b");
}

run_one(parent);

while (queue.len() > 0) {
    var next = queue[0];
    queue = queue[1:];
    next();
}
