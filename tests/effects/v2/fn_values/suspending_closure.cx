trait E { @ctl fn op(): unit; }

fn work(): <E, Console> unit {
    print("before");
    op();
    print("after");
}

var pending: List<() -> <Console> unit> = [];

run {
    var task = () => { work(); };
    task();
} handle<E> {
    fn op(resume) { pending.push { resume(()); }; }
}

print("run finished");
pending[0]();
print("done");
