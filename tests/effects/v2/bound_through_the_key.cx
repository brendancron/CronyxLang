trait Log {
    fn log(msg: string): unit;
}

trait Ask {
    fn ask(): int;
}

fn countdown(n: int): unit {
    if (n == 0) { return; }
    log("at " + str(n));
    countdown(n - 1);
}

fn total(): int {
    return ask() + ask();
}

fn nested(prefix: string): int {
    var seen = 0;
    var r = run<int> {
        log("inner start");
        total()
    } handle<Ask> {
        fn ask() {
            seen = seen + 1;
            log(prefix + " asked " + str(seen));
            return 10 * seen;
        }
    };
    return r;
}

var lines: List<string> = [];
run {
    countdown(2);
    print(nested("p"));
} handle<Log> {
    fn log(msg) { lines.push(msg); }
}
for (l in lines) { print(l); }

var v = run<int> {
    ask() * 2
} handle<Ask> {
    fn ask() { return 21; }
};
print(v);

type Outer {}
impl Log for Outer {
    fn log(msg: string): unit { print("outer: " + msg); }
}

run {
    run {
        log("hi");
    } handle<Log> {
        fn log(msg) { log("relayed " + msg); }
    }
} with Outer;
