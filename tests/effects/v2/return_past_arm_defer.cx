trait E { @ctl fn ask(): int; }
trait Inner { @ctl fn tick(): int; }

fn f(): <E, Console> int {
    run {
        var n = tick();
        return n + 1;
    } handle<Inner> {
        fn tick(resume) {
            defer { print("cleaned up"); }
            resume(1);
            print("UNREACHABLE");
        }
    }
    return ask();
}

run {
    print(f());
} handle<E> {
    fn ask(resume) { resume(7); }
}
