trait E { @ctl fn ask(): Int; }
trait Inner { @ctl fn tick(): Int; }

fn f(): <E, Console> Int {
    run<Unit> {
        var n = tick();
        return n + 1;
    } handle<Inner> {
        fn tick(resume) {
            defer { print("cleaned up"); }
            resume(1);
            print("UNREACHABLE");
        }
    }
    return ask();
}

run<Unit> {
    print(f());
} handle<E> {
    fn ask(resume) { resume(7); }
}
