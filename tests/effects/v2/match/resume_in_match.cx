type Choice { Yes, No }

trait Ask { @ctl fn get(): Int; }

fn use(): <Ask> Int {
    return get();
}

run<Unit> {
    print(use());
} handle<Ask> {
    fn get(resume) {
        var c = Choice.No;
        match c {
            Choice.Yes => { resume(1); }
            Choice.No => { resume(2); }
        }
    }
}
