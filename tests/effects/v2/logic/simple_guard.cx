trait logic {
    @ctl fn choose(options: Array<int>): int;
    @ctl fn guard(cond: bool): unit;
}

run {
    var num = choose([1,2,3,4,5]);
    guard(num == 3);
    print(num);
} handle<logic> {
    fn choose(options, resume) {
        for (x in options) {
            resume(x);
        }
    }
    fn guard(cond, resume) {
        if (cond) {
            resume(());
        }
    }
}
