trait Ask {
    @ctl fn get(): int;
}

type Point {
    x: int,
    y: int
}

fn shift(p: Point): <Ask> unit {
    p.x = get();
}

run {
    var p = Point { x: 1, y: 2 };
    shift(p);
    print(str(p.x) + "," + str(p.y));
} handle<Ask> {
    fn get(resume) {
        resume(9);
        print("after");
    }
}
