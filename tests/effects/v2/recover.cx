trait parse_error {
    @ctl fn invalid(input: string): int;
}

fn parse_int(str: string): int {
    if (str == "10") {
        return 10;
    }
    return invalid(str);
}

run {
    print(parse_int("10"));
    print(parse_int("apple"));
    print("recovered");
} handle<parse_error> {
    fn invalid(input, resume) {
        print("Parse error, invalid string: " + input);
        resume(-1);
    }
}
