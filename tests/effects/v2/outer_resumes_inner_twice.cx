trait M { @ctl fn m(): int; }
trait L { @ctl fn l(): unit; }

run {
    run {
        var a = m();
        l();
        var b = m();
        print("body " + str(a) + " " + str(b));
    } handle<M> {
        fn m(resume) { resume(1); print("m arm after"); }
    }
    print("after M");
} handle<L> {
    fn l(resume) { resume(()); resume(()); }
}
