trait E { @ctl fn ask(): Int; }
trait Fail { @ctl fn bail<T>(): T; }

fn g(): <E, Fail, Console> Unit {
    var t = ask();
    bail();
    print("UNREACHABLE");
}

run<Unit> {
    run<Unit> {
        g();
        print("UNREACHABLE-2");
    } handle<Fail> { fn bail(resume) { print("bailed"); } }
    print("after the fail run");
} handle<E> {
    fn ask(resume) {
        resume(7);
        print("E after");
    }
}
