trait Effect {
    fn log(msg: String): Unit;
    @ctl fn choose(options: Array<Int>): Int;
}

fn noisy(tag: String): Int {
    print("evaluated " + tag);
    return 100;
}

fn pick(): Int {
    log("picking");
    var n = choose([1, 2]);
    log("picked " + str(n));
    return n * 10;
}

fn outer(): Int {
    var a = pick();
    return a + 1;
}

fn pair(a: Int, b: Int, c: Int): String {
    return str(a) + "/" + str(b) + "/" + str(c);
}

var answers = run<String> {
    var total = noisy("first") + outer();
    print(pair(noisy("left"), choose([7, 8]), 3));
    str(total)
} handle<Effect> {
    fn log(msg) { print("log: " + msg); }
    fn choose(options, k) {
        var all = "";
        for (x in options) { all = all + "[" + k(x) + "]"; }
        return all;
    }
};

print(answers);
