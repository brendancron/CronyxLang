trait exception {
    @ctl fn throw(msg: string): unit;
}

fn main() {
    print("Start of Main");
    run {
        print("Start of Run Block");
        throw("Some Exception");
        print("End of Run Block");
    } handle<exception> {
        fn throw(msg, resume) {
            print(msg);
        }
    }
    print("End of Main");
}

main();
