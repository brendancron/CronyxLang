trait Sched { @ctl fn tick(): Unit; }

var queue: List<() -> <Console> Unit> = [];

fn run_one(task: () -> <Sched, Console> Unit) {
    run<Unit> { task(); } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

fn scope(body: ((() -> <Sched, Console> Unit) -> <Console> Unit) -> <Sched, Console> Unit) {
    run_one(() => {
        body((task) => { run_one(task); });
    });
}

fn counter(name: String): <Sched, Console> Unit {
    print(name + " starts");
    tick();
    print(name + " ends");
}

scope((start) => {
    start(() => { counter("A"); });
    start(() => { counter("B"); });
});

while (queue.len() > 0) {
    var next = queue[0];
    queue = queue[1:];
    next();
}
