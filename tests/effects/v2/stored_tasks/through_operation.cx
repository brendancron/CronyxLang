trait sched {
    @ctl fn tick(): unit;
    @ctl fn spawn(t: () -> <sched, Console> unit): unit;
}

var queue: List<() -> <Console> unit> = [];

fn run_one(task: () -> <sched, Console> unit): unit {
    run {
        task();
    } handle<sched> {
        fn tick(resume) { queue.push { resume(()); }; }
        fn spawn(t, resume) { queue.push { run_one(t); }; resume(()); }
    }
}

fn child(): <sched, Console> unit { print("child a"); tick(); print("child b"); }

fn parent(): <sched, Console> unit {
    print("parent a");
    spawn(child);
    tick();
    print("parent b");
}

run_one(parent);

while (queue.len() > 0) {
    var next = queue[0];
    queue = queue[1:];
    next();
}
