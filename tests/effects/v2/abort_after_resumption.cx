trait Error { @ctl fn throw<T>(msg: String): T; }
trait E { @ctl fn op(): Unit; }

fn work(): <Error, E, Console> Unit {
    print("w1");
    op();
    throw("boom");
    print("UNREACHABLE");
}

run<Unit> {
    var pending: List<() -> <Error, Console> Unit> = [];
    run<Unit> {
        work();
        print("UNREACHABLE TOO");
    } handle<E> {
        fn op(resume) { pending.push(() => { resume(()); }); }
    }
    print("drain");
    pending[0]();
} handle<Error> {
    fn throw(msg, resume) { print("caught: " + msg); }
}
print("done");
