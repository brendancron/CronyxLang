// The record whose field is being set is evaluated before the operation, so it
// is the continuation that does the assigning.
effect Ask { ctl get(): int; }

type Point {
    x: int,
    y: int
}

fn shift(p: Point): <Ask> unit {
    p.x = get();
}

run {
    var p = Point { x: 1, y: 2 };
    shift(p);
    print(str(p.x) + "," + str(p.y));
} handle Ask {
    ctl get() {
        resume 9;
        print("after");
    }
}
