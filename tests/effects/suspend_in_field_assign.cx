trait Ask {
    @ctl fn get(): Int;
}

type Point {
    x: Int,
    y: Int
}

fn shift(p: Point): <Ask> Unit {
    p.x = get();
}

run<Unit> {
    var p = Point { x: 1, y: 2 };
    shift(p);
    print(str(p.x) + "," + str(p.y));
} handle<Ask> {
    fn get(resume) {
        resume(9);
        print("after");
    }
}
