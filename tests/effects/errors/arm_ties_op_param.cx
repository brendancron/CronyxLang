trait Ask {
    fn ask<T>(fallback: T): T;
}

fn answering<A>(given: A, work: () -> <Ask> A): A {
    var kept = given;
    run<Unit> {
        kept = work();
    } handle<Ask> {
        fn ask(fallback) {
            kept = fallback;
            return fallback;
        }
    }
    return kept;
}

print(answering(1, () => { return ask(2); }));
