trait Task { fn yield(): Unit; }

fn work(items: Array<Int>): <Task> Int {
    var total = 0;
    for (i in items) {
        yield();
        total = total + i;
    }
    return total;
}

run<Unit> {
    print(work([1, 2, 3]));
} handle<Task> {
    fn yield(resume) {
        resume(());
        print("after");
    }
}
