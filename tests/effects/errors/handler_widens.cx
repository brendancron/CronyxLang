effect Task { fn yield(): Unit; }

fn work(items: Array<Int>): <Task> Int {
    var total = 0;
    for (i in items) {
        yield();
        total = total + i;
    }
    return total;
}

run {
    print(work([1, 2, 3]));
} handle Task {
    ctl yield() {
        resume;
        print("after");
    }
}
