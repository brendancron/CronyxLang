trait Async {
    @ctl fn suspend<T>(register: ((T) -> Unit) -> Unit): T;
}

var ready: List<() -> Unit> = [];

fn start(): <Async, Console> Unit {
    var n = suspend((wake) => { ready.push { wake(1); }; });
    print("got " + str(n));
    var word = suspend((wake) => { ready.push { wake("hi"); }; });
    print("got " + word);
}

run<Unit> {
    start();
} handle<Async> {
    fn suspend(register, resume) { register((value) => { var n = value + 0; }); }
}
