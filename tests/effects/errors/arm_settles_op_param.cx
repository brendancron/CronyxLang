effect async {
    ctl suspend<T>(register: ((T) -> unit) -> unit): T;
}

var ready: List<() -> unit> = [];

fn main(): <async, Console> unit {
    var n = suspend((wake) => { ready.push { wake(1); }; });
    print("got " + str(n));
    var word = suspend((wake) => { ready.push { wake("hi"); }; });
    print("got " + word);
}

run {
    main();
} handle async {
    ctl suspend(register) { register((value) => { var n = value + 0; resume value; }); }
}
