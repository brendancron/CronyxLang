trait Sched { @ctl fn tick(): Unit; }

var queue: List<() -> <Console> Unit> = [];

fn run_one(queue: List<() -> <Console> Unit>, task: () -> <Sched, Console> Unit) {
    run<Unit> { task(); } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

fn all(queue: List<() -> <Console> Unit>, tasks: List<() -> <Sched, Console> Unit>) {
    for (task in tasks) { run_one(queue, task); }
}

fn counter(name: String): <Sched, Console> Unit {
    for (var i = 0; i < 2; i += 1) {
        print(name + ": " + str(i));
        tick();
    }
}

all(queue, [() => { counter("A"); }, () => { counter("B"); }]);

var at = 0;
while (at < queue.len()) {
    var next = queue[at];
    at += 1;
    next();
}
