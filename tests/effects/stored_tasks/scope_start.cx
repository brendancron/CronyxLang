trait Sched { @ctl fn tick(): Unit; }

var queue: List<() -> <Console> Unit> = [];

fn run_one(queue: List<() -> <Console> Unit>, task: () -> <Sched, Console> Unit) {
    run<Unit> { task(); } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

fn scope(queue: List<() -> <Console> Unit>, body: ((() -> <Sched, Console> Unit) -> <Console> Unit) -> <Sched, Console> Unit) {
    run_one(queue, () => {
        body((task) => { run_one(queue, task); });
    });
}

fn counter(name: String): <Sched, Console> Unit {
    print(name + " starts");
    tick();
    print(name + " ends");
}

scope(queue, (start) => {
    start(() => { counter("A"); });
    start(() => { counter("B"); });
});

var at = 0;
while (at < queue.len()) {
    var next = queue[at];
    at += 1;
    next();
}
