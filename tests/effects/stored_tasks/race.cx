trait Sched { @ctl fn tick(): Unit; }

var queue: List<() -> <Console> Unit> = [];

fn run_one(queue: List<() -> <Console> Unit>, task: () -> <Sched, Console> Unit) {
    run<Unit> { task(); } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

fn race(queue: List<() -> <Console> Unit>, tasks: List<() -> <Sched, Console> Unit>) {
    var won = false;
    for (task in tasks) {
        run_one(queue, () => {
            task();
            if (!won) {
                won = true;
                print("won");
            }
        });
    }
}

fn counter(name: String): <Sched, Console> Unit {
    print(name + " starts");
    tick();
    print(name + " ends");
}

race(queue, [() => { counter("A"); }, () => { counter("B"); }]);

var at = 0;
while (at < queue.len()) {
    var next = queue[at];
    at += 1;
    next();
}
