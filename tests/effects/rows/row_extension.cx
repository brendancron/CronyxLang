trait Log {
    fn emit(msg: String): Unit;
}

trait Ask {
    fn base(): Int;
}

fn traced<T, E>(label: String, f: () -> <E> T): <Log, E> T {
    emit("enter " + label);
    var result = f();
    emit("leave " + label);
    return result;
}

fn quiet(): Int {
    return 7;
}

fn asks(): <Ask> Int {
    return base() + 1;
}

run<Unit> {
    print(str(traced("quiet", quiet)));
    print(str(traced("asks", asks)));
} handle<Log> {
    fn emit(msg) { print("log: " + msg); }
} handle<Ask> {
    fn base() { return 41; }
}
