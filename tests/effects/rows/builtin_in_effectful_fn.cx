trait Log { fn log(msg: String): Unit; }
trait Ask { fn ask(): Int; }

fn helper(n: Int): Int {
    return n + 1;
}

fn work(n: Int): String {
    log("start");
    return str(helper(n)) + "!";
}

fn counted(xs: Set<Int>): String {
    log("counting");
    return str(xs.len());
}

fn both(n: Int): String {
    log("both");
    var extra = ask();
    return work(n + extra);
}

run<Unit> {
    run<Unit> {
        print(work(1));
        var s: Set<Int> = [1, 2, 2];
        print(counted(s));
        print(both(1));
    } handle<Ask> { fn ask() { return 10; } }
} handle<Log> { fn log(msg: String) { print(msg); } }
