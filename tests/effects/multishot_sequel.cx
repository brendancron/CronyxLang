trait Logic { @ctl fn choose(options: Array<Int>): Int; }

fn pick(): Int {
    run<Unit> {
        var n = choose([1, 2]);
        print("saw" + " " + str(n));
    } handle<Logic> {
        fn choose(options, resume) { for (x in options) { resume(x); } }
    }
    return 7;
}

print(pick());

run<Unit> {
    var a = choose([1, 2]);
    run<Unit> {
        var b = choose([10, 20]);
        print(str(a) + " " + str(b));
    } handle<Logic> { fn choose(o, resume) { for (x in o) { resume(x); } } }
} handle<Logic> { fn choose(o, resume) { for (x in o) { resume(x); } } }
print("done");
