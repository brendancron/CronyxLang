trait Ask { @ctl fn ask(): Int; }

trait Getter { fn get(self): <Ask> Int; }

type Box { n: Int }

impl Getter for Box {
    fn get(self): <Ask> Int { return self.n + ask(); }
}

fn make(): <Ask> Getter {
    var g: Getter = Box { n: ask() };
    return g;
}

fn total(): <Ask> Int { return make().get(); }

run<Unit> { print(total()); } handle<Ask> { fn ask(resume) { resume(7); } }
