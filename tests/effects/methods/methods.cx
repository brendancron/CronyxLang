effect Log { fn emit(message: String): Unit; }

type Order {
    note: String
}

impl Order {
    fn audit(self) {
        emit("order: " + self.note);
    }
}

run {
    var o = Order { note: "boots" };
    o.audit();
} handle Log {
    fn emit(message) {
        print("[log] " + message);
    }
}
