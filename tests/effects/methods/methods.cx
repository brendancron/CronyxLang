effect log { fn emit(message: string): unit; }

type Order {
    note: string
}

impl Order {
    fn audit(self) {
        emit("order: " + self.note);
    }
}

run {
    var o = Order { note: "boots" };
    o.audit();
} handle log {
    fn emit(message) {
        print("[log] " + message);
    }
}
