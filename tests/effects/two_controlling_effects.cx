trait Tick { @ctl fn tick(): Int; }
trait Pick { @ctl fn pick(): String; }

type Both {}

impl EffectHandler<Pick, Unit> for Both {
    fn pick(resume: (String) -> Unit) {
        resume("x");
        resume("y");
    }
}

fn labelled(n: Int): String {
    var t = tick();
    return pick() + str(n + t);
}

run<Unit> {
    var a = tick();
    var b = pick();
    print(str(a) + b);
} handle<Tick> {
    fn tick(resume) { resume(1); }
} handle<Pick> {
    fn pick(resume) { resume("x"); resume("y"); }
}

run<Unit> {
    print(labelled(10));
} handle<Tick> {
    fn tick(resume) { resume(1); resume(2); }
} with Both;
