effect Ask { ctl get(): Int; }

type Color { Red, Blue }

fn use(): <Ask> Int { return get(); }

fn main(): Unit {
    var c = Color.Red;
    match c {
        Color.Red => {
            run { print(use()); }
            handle Ask { ctl get() { resume 5; print("after"); } }
        }
        Color.Blue => { }
    }
}

main();
