trait Ask { @ctl fn get(): Int; }

type Color { Red, Blue }

fn use(): <Ask> Int { return get(); }

fn main(): Unit {
    var c = Color.Red;
    match c {
        Color.Red => {
            run<Unit> { print(use()); }
            handle<Ask> { fn get(resume) { resume(5); print("after"); } }
        }
        Color.Blue => { }
    }
}

main();
