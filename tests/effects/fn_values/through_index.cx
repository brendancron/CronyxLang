trait E { @ctl fn op(): Int; }

fn work(base: Int): <E> Int { return base + op(); }

var pending: List<() -> <Console> Unit> = [];

run<Unit> {
    var tasks: List<() -> <E> Int> = [];
    tasks.push(() => { return work(10); });
    print(str(tasks[0]()));
} handle<E> {
    fn op(resume) { pending.push { resume(5); }; }
}

print("draining");
pending[0]();
