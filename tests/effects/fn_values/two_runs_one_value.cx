trait Pick { @ctl fn pick(): Int; }
trait Note { @ctl fn note(text: String): Unit; }

fn both(f: () -> <Pick, Note, Console> Unit): <Console> Unit {
    run<Unit> {
        run<Unit> {
            f();
        } handle<Pick> {
            fn pick(resume) {
                resume(1);
                resume(2);
                print("picked both");
            }
        }
        print("pick's run is done");
    } handle<Note> {
        fn note(text, resume) {
            print("note: " + text);
            resume(());
        }
    }
}

both(() => {
    var n = pick();
    note("got " + str(n));
    print(n * 10);
});
