effect E { ctl op(): Int; }

fn doubled(): <E> Int { return op() * 2; }
fn tripled(): <E> Int { return op() * 3; }

fn call_it(task: () -> <E> Int): <E> Int { return task(); }

run {
    print(call_it(doubled));
    var fns: List<() -> <E> Int> = [];
    fns.push(doubled);
    fns.push(tripled);
    print(fns[0]());
    print(fns[1]());
} handle E {
    ctl op() { resume 7; }
}
