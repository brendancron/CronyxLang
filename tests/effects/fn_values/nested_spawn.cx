trait Sched {
    @ctl fn tick(): Unit;
}

var queue: List<() -> <Console> Unit> = [];

fn run_one(queue: List<() -> <Console> Unit>, task: () -> <Sched, Console> Unit): Unit {
    run<Unit> {
        task();
    } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

fn spawn(queue: List<() -> <Console> Unit>, t: () -> <Sched, Console> Unit) { queue.push { run_one(queue, t); }; }

fn child(): <Sched, Console> Unit { print("child a"); tick(); print("child b"); }

fn parent(queue: List<() -> <Console> Unit>): <Sched, Console> Unit {
    print("parent a");
    spawn(queue, child);
    tick();
    print("parent b");
}

run_one(queue, () => { parent(queue); });

var at = 0;
while (at < queue.len()) {
    var next = queue[at];
    at += 1;
    next();
}
