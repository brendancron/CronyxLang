effect sched {
    ctl tick(): unit;
}

var queue: List<() -> unit> = [];

fn counter(name: string): <sched, Console> unit {
    for (var i = 0; i < 3; i += 1) {
        print(name + ": " + str(i));
        tick();
    }
}

fn spawn(task: () -> <sched, Console> unit) {
    run {
        task();
    } handle sched {
        ctl tick() { queue.push { resume; }; }
    }
}

spawn(() => { counter("A"); });
spawn(() => { counter("B"); });

while (queue.len() > 0) {
    var next = queue[0];
    queue = queue[1:];
    next();
}
