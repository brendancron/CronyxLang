trait Sched {
    @ctl fn tick(): Unit;
}

var queue: List<() -> <Console> Unit> = [];

fn counter(name: String): <Sched, Console> Unit {
    for (var i = 0; i < 3; i += 1) {
        print(name + ": " + str(i));
        tick();
    }
}

fn spawn(task: () -> <Sched, Console> Unit) {
    run<Unit> {
        task();
    } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

spawn(() => { counter("A"); });
spawn(() => { counter("B"); });

while (queue.len() > 0) {
    var next = queue[0];
    queue = queue[1:];
    next();
}
