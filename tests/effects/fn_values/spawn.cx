effect Sched {
    ctl tick(): Unit;
}

var queue: List<() -> Unit> = [];

fn counter(name: String): <Sched, Console> Unit {
    for (var i = 0; i < 3; i += 1) {
        print(name + ": " + str(i));
        tick();
    }
}

fn spawn(task: () -> <Sched, Console> Unit) {
    run {
        task();
    } handle Sched {
        ctl tick() { queue.push { resume; }; }
    }
}

spawn(() => { counter("A"); });
spawn(() => { counter("B"); });

while (queue.len() > 0) {
    var next = queue[0];
    queue = queue[1:];
    next();
}
