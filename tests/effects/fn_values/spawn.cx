trait Sched {
    @ctl fn tick(): Unit;
}

var queue: List<() -> <Console> Unit> = [];

fn counter(name: String): <Sched, Console> Unit {
    for (var i = 0; i < 3; i += 1) {
        print(name + ": " + str(i));
        tick();
    }
}

fn spawn(queue: List<() -> <Console> Unit>, task: () -> <Sched, Console> Unit) {
    run<Unit> {
        task();
    } handle<Sched> {
        fn tick(resume) { queue.push { resume(()); }; }
    }
}

spawn(queue, () => { counter("A"); });
spawn(queue, () => { counter("B"); });

var at = 0;
while (at < queue.len()) {
    var next = queue[at];
    at += 1;
    next();
}
