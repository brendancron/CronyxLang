trait Async {
    @ctl fn suspend<T>(register: ((T) -> Unit) -> Unit): T;
}

fn pause() {
    return suspend { it(()) };
}

fn interleaved(actions: List<() -> <Async, Console> Unit>) {
    var ready: List<() -> <Console> Unit> = [];

    fn strand(action: () -> <Async, Console> Unit) {
        run<Unit> {
            action();
        } handle<Async> {
            fn suspend(register, resume) {
                register {
                    ready.push { resume(it); };
                };
            }
        }
    }

    for (action in actions) {
        ready.push { strand(action); };
    }

    while (ready.len() > 0) {
        var next = ready[0];
        ready = ready[1:];
        next();
    }
}

fn counter(name) {
    for (var i = 0; i < 10; i += 1) {
        print_item(name, i);
    }
}

fn print_item(name, idx) {
    print(name + ": " + str(idx));
    pause();
}

interleaved([
    () => { counter("A"); },
    () => { counter("B"); }
]);
