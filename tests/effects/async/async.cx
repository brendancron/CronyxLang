effect async {
    ctl suspend<T>(register: ((T) -> unit) -> unit): T;
}

fn pause() {
    return suspend { it(()) };
}

fn interleaved(actions: List<() -> <async, Console> unit>) {
    var ready: List<() -> <Console> unit> = [];

    fn strand(action: () -> <async, Console> unit) {
        run {
            action();
        } handle async {
            ctl suspend(register) {
                register {
                    ready.push { resume it; };
                };
            }
        }
    }

    for (action in actions) {
        ready.push { strand(action); };
    }

    while (ready.len() > 0) {
        var next = ready[0];
        ready = ready[1:];
        next();
    }
}

fn counter(name) {
    for (var i = 0; i < 10; i += 1) {
        print_item(name, i);
    }
}

fn print_item(name, idx) {
    print(name + ": " + str(idx));
    pause();
}

interleaved([
    () => { counter("A"); },
    () => { counter("B"); }
]);
