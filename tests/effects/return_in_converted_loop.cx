trait Tick { @ctl fn tick(): Unit; }

fn find(xs: List<Int>, v: Int): <Tick> Bool {
    for (x in xs) {
        if (x == v) { return true; }
    }
    return false;
}

fn first_over(xs: List<Int>, limit: Int): <Tick> Int {
    var i = 0;
    while (i < xs.len()) {
        tick();
        if (xs[i] > limit) { return xs[i]; }
        i += 1;
    }
    return 0;
}

run<Unit> {
    print(find([1, 2], 2));
    print(find([1, 2], 3));
    print(first_over([1, 5, 9], 4));
} handle<Tick> {
    fn tick(resume) { resume(()); }
}
