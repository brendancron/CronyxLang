// Two aborting handlers, one inside the other. An unwind stops at the handler
// that raised it, not at whatever block happens to stand in between: `stop` is
// the inner block's, `halt` passes straight through it.
effect Inner { final ctl stop(): int; }
effect Outer { final ctl halt(): int; }

fn f(which: bool): <Outer, Console> unit {
    run {
        if (which) { stop(); } else { halt(); }
        print("body done");
    } handle Inner { final ctl stop() { print("inner stopped"); } }
    print("after inner run");
}

run {
    f(true);
    print("---");
    f(false);
    print("outer done");
} handle Outer { final ctl halt() { print("outer halted"); } }
