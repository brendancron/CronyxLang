trait Ask { @ctl fn get(): Int; }

type Shape {
    Circle { radius: Int },
    Rect { w: Int, h: Int },
}

fn make(): <Ask> Shape {
    return Shape.Rect { w: 2, h: get() };
}

run<Unit> {
    match make() {
        Shape.Rect { w, h } => { print(str(w) + "x" + str(h)); }
        Shape.Circle { radius } => { print(radius); }
    }
} handle<Ask> {
    fn get(resume) { resume(4); }
}
