// A variant payload is the same evaluation context as a record's fields.
effect Ask { ctl get(): int; }

type Shape {
    Circle { radius: int },
    Rect { w: int, h: int },
}

fn make(): <Ask> Shape {
    return Shape::Rect { w: 2, h: get() };
}

run {
    match make() {
        Shape::Rect { w, h } => { print(str(w) + "x" + str(h)); }
        Shape::Circle { radius } => { print(radius); }
    }
} handle Ask {
    ctl get() { resume 4; }
}
