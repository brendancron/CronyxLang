trait Ask { @ctl fn get(): Bool; }

fn any(): <Ask> Bool {
    return false || get();
}

fn both(): <Ask> Bool {
    return true && get();
}

fn short(): <Ask> Bool {
    return true || get();
}

run<Unit> {
    print(any());
    print(both());
    print(short());
} handle<Ask> {
    fn get(resume) {
        resume(true);
        print("after");
    }
}
