trait Ask {
    @ctl fn get(): Int;
}

type Point {
    x: Int,
    y: Int
}

fn make(): <Ask> Point {
    return Point { x: 1, y: get() };
}

run<Unit> {
    var p = make();
    print(str(p.x) + " " + str(p.y));
} handle<Ask> {
    fn get(resume) {
        resume(5);
        print("after");
    }
}
