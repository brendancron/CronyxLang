// A field initializer is an evaluation context like any other: the fields
// before the suspension are already evaluated and have to survive it, and the
// literal is built once the continuation supplies the rest.
effect Ask { ctl get(): int; }

type Point {
    x: int,
    y: int
}

fn make(): <Ask> Point {
    return Point { x: 1, y: get() };
}

run {
    var p = make();
    print(str(p.x) + " " + str(p.y));
} handle Ask {
    ctl get() {
        resume 5;
        print("after");
    }
}
