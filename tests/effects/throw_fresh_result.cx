trait Fail {
    @ctl fn throw<T>(msg: String): T;
}

fn number(ok: Bool): Int {
    if (ok) { return 1; }
    return throw("no number");
}

fn word(ok: Bool): String {
    if (ok) { return "w"; }
    return throw("no word");
}

run<Unit> {
    print(number(true));
    print(word(true));
    print(number(false));
    print("unreachable");
} handle<Fail> {
    fn throw(msg, k) { print("caught: " + msg); }
}

run<Unit> {
    print(word(false));
} handle<Fail> {
    fn throw(msg, k) { print("caught: " + msg); }
}
