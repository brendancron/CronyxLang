trait E { @ctl fn ask(): Int; }
trait Log { fn note(): Unit; }

fn f(): <E, Console> Int {
    var t = 0;
    run<Unit> {
        note();
        t = ask();
    } handle<Log> { fn note() { print("noted"); } }
    return t;
}

run<Unit> {
    print(f());
} handle<E> {
    fn ask(resume) {
        resume(7);
        print("after");
    }
}
