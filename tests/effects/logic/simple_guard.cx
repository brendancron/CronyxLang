effect Logic {
    ctl choose(options: Array<Int>): Int;
    ctl guard(cond: Bool): Unit;
}

run {
    var num = choose([1,2,3,4,5]);
    guard(num == 3);
    print(num);
} handle Logic {
    ctl choose(options) {
        for (x in options) {
            resume x;
        }
    }
    ctl guard(cond) {
        if (cond) {
            resume;
        }
    }
}
