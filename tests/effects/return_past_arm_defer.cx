// What the arm loses by being unwound past, and what it keeps: the sequel after
// `resume` never runs, while a `defer` armed before it does — the same division
// Koka draws between a clause's own code and a `finally`.
effect E { ctl ask(): int; }
effect Inner { ctl tick(): int; }

fn f(): <E, Console> int {
    run {
        var n = tick();
        return n + 1;
    } handle Inner {
        ctl tick() {
            defer { print("cleaned up"); }
            resume 1;
            print("UNREACHABLE");
        }
    }
    return ask();
}

run {
    print(f());
} handle E {
    ctl ask() { resume 7; }
}
