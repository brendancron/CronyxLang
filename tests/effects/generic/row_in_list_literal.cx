trait Log { fn log(s: String): Unit; }

fn each<E>(actions: List<() -> <E> Unit>): <E> Unit {
    for (action in actions) { action(); }
}

fn first() { log("first"); }
fn second() { log("second"); }

run<Unit> {
    each([ first, () => { log("lambda"); }, second ]);
} handle<Log> {
    fn log(s) { print(s); }
}
