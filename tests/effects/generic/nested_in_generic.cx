trait Log { fn log(s: String): Unit; }

fn each<E>(actions: List<() -> <E> Unit>): <Console, E> Unit {
    var count = 0;

    fn one(action: () -> <E> Unit): <E> Unit {
        count = count + 1;
        action();
    }

    for (action in actions) { one(action); }
    print(count);
}

fn task() { log("task"); }

run<Unit> {
    each([ task, task ]);
} handle<Log> {
    fn log(s) { print(s); }
}
