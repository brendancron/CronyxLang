trait Yield<T> {
    @ctl fn yield(value: T): Unit;
}

fn counted(high: Int): <Yield<Int>> Unit {
    var i = 0;
    while (i < high) {
        yield(i);
        i = i + 1;
    }
}

fn spelled(text: String): <Yield<String>> Unit {
    for (word in text.split(' ')) {
        yield(word);
    }
}

fn doubled(n: Int): <Yield> Unit {
    yield(n);
    yield(n * 2);
}

run<Unit> {
    counted(3);
} handle<Yield<Int>> {
    fn yield(n, resume) { print(str(n)); resume(()); }
}

run<Unit> {
    spelled("a b");
} handle<Yield<String>> {
    fn yield(w, resume) { print(w); resume(()); }
}

run<Unit> {
    doubled(5);
} handle<Yield<Int>> {
    fn yield(v, resume) { print(str(v)); resume(()); }
}
