trait Throw<X> { @abort fn throw<T>(err: X): T; }

fn quiet<X, T, E>(fallback: T, f: () -> <Throw<X>, E> T): <Console, E> T {
    var out = fallback;
    run<Unit> { out = f(); } handle<Throw<X>> { fn throw(e) { print("swallowed " + str(e)); } }
    return out;
}

fn a(): Int { throw("a failed"); return 1; }
fn b(): Int { throw(42); return 2; }

fn one(): Int { return quiet(0, a); }
fn two(): Int { return quiet(0, b); }

print(one() + two());
