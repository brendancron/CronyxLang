trait Yield<T> { @ctl fn yield(v: T): Unit; }

run<Unit> {
    run<Unit> {
        yield(1);
        yield(2);
    } handle<Yield<Int>> {
        fn yield(x, resume) { yield("got " + str(x)); resume(()); }
    }
    yield("done");
} handle<Yield<String>> {
    fn yield(s, resume) { print("outer " + s); resume(()); }
}

