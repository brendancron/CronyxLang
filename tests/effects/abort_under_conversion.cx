// A `final ctl` unwinds to the block it was installed on. Once that block sits
// inside a converted function, "the rest" lives in continuation closures, and
// the unwind has to stop at the same place it would otherwise — not escape
// every continuation between here and the top.
effect E { ctl ask(): int; }
effect Fail { final ctl bail(): int; }

fn g(): <E, Fail, Console> unit {
    var t = ask();
    bail();
    print("UNREACHABLE");
}

run {
    run {
        g();
        print("UNREACHABLE-2");
    } handle Fail { final ctl bail() { print("bailed"); } }
    print("after the fail run");
} handle E {
    ctl ask() {
        resume 7;
        print("E after");
    }
}
