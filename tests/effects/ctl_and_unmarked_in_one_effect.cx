trait Effect {
    fn log(msg: String): Unit;
    @ctl fn choose(options: Array<Int>): Int;
}

var ret = run<String> {
    log("picking");
    var n = choose([1, 2]);
    log("chose " + str(n));
    str(n)
} handle<Effect> {
    fn log(msg) { print(msg); }
    fn choose(options, k) {
        var last = "";
        for (x in options) { last = k(x); }
        return last;
    }
};

print(ret);
