type Reason { Timeout }
type Event { Started(int, string), Failed(Reason), Batch(List<int>), Done }

match typeof(Event.Done).shape {
    TypeShape.Sum(name, _, variants) => {
        for (variant in variants) {
            var carried = "";
            for (p in variant.payload) { carried = carried + " " + p.text(); }
            print(str(variant.name) + " " + str(variant.arity) + ":" + carried);
        }
    }
    _ => { print("not a sum"); }
}
