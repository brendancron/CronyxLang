type Slot<...Args> {
    use: (...Args) -> <Console> Unit
}

fn hold<...Args>(f: (...Args) -> <Console> Unit, args: ...Args): (...Args) {
    return args;
}

fn call<T, ...Args>(f: (...Args) -> <Console> T, args: (...Args)): T {
    return f(...args);
}

fn pair(a: Int, b: String) {
    print(str(a) + b);
}

fn nothing() {
}

var two = Slot { use: pair };
var none = Slot { use: nothing };

print(typeof(two).name);
print(typeof(none).name);
print(typeof(two.use).name);
print(typeof(none.use).name);
print(typeof(hold(pair, 1, "x")).name);
print(typeof(hold(nothing)).name);
