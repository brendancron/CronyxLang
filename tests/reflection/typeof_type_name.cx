// A bare name is a value's type if one answers to it, and the declared type
// otherwise, so a type nothing holds can still be reflected on.
type Dog { name: string, age: int }
type Card { Damage(int), Skip }

print(str(typeof(Dog).name) + " " + str(typeof(Card).name));
print(str(typeof(int).name) + " " + str(typeof(string).name));

var rex = Dog { name: "rex", age: 3 };
print(typeof(rex).name == typeof(Dog).name);

match typeof(Card).shape {
    TypeShape.Sum(named, variants) => { print(str(str(named)) + " " + str(variants.len())); }
    TypeShape.Product(named, fields) => {}
    TypeShape.Scalar => {}
    TypeShape.Other => {}
}
