# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "The Cronyx package manager"
description:
  "cx resolves dependencies, drives the compiler as a library, and installs the toolchain a package asks for."
maintainer: ["Brendan Cron <brendancron@gmail.com>"]
authors: ["Brendan Cron <brendancron@gmail.com>"]
tags: ["package manager" "cronyx"]
homepage: "https://github.com/brendancron/CronyxLang"
bug-reports: "https://github.com/brendancron/CronyxLang/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.2"}
  "bootstrap"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/brendancron/CronyxLang.git"
x-maintenance-intent: ["(latest)"]
