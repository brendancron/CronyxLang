import "tested" as pkg;

@test
fn adds() {
    assert(pkg.add(1, 2) == 3, "1 + 2 is 3");
}

@test
fn reports_its_output() {
    print("printed by a failing test");
    assert(pkg.add(1, 2) == 4, "1 + 2 is not 4");
}

@test
fn keeps_going_after_a_failure() {
    assert(pkg.add(0, 0) == 0, "the run before this one failed");
}
